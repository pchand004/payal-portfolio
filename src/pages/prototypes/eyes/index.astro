---
/**
 * Eyes — a live prototype.
 *
 * A pitch-black stage laid out on a 4 × 3 grid: ten eye cells round the
 * edge, "hi there!" across the two middle cells, cycling through five
 * typefaces. Click (or tap) inside a cell to wake its eye pair; it plays
 * while the cursor stays in the cell, then closes and disappears. For now
 * only the top-left cell has a pair: "Following".
 *
 * The grid and stage timings live in src/scripts/eyes/motion.ts; each eye
 * keeps its own tunables at the top of its component.
 */
import { Font } from 'astro:assets';
import Prototype from '../../../layouts/Prototype.astro';
import EyeFollowing from '../../../components/eyes/EyeFollowing.astro';
import { CELL_W, CELL_H, GREETING_W } from '../../../scripts/eyes/motion';

const GREETING = 'hi there!';

// One face per mood. `scale` evens out x-heights so the word reads the same
// width in every face.
const moods = [
  { mood: 'fun', family: 'var(--font-fredoka)', scale: 1 },
  { mood: 'elegant', family: 'var(--font-cormorant)', scale: 1.2 },
  { mood: 'professional', family: 'var(--font-inter)', scale: 0.94 },
  { mood: 'casual', family: 'var(--font-caveat)', scale: 1.18 },
  { mood: 'comic', family: 'var(--font-bangers)', scale: 0.92 },
];

// Grid cells: desktop column/row on the 4 × 3 grid, and (mc, mr) on the
// two-column phone grid, where the greeting takes row 3.
const cells = [
  { n: 1, c: 1, r: 1, mc: 1, mr: 1, eye: EyeFollowing },
  { n: 2, c: 2, r: 1, mc: 2, mr: 1 },
  { n: 3, c: 3, r: 1, mc: 1, mr: 2 },
  { n: 4, c: 4, r: 1, mc: 2, mr: 2 },
  { n: 5, c: 1, r: 2, mc: 1, mr: 4 },
  { n: 6, c: 4, r: 2, mc: 2, mr: 4 },
  { n: 7, c: 1, r: 3, mc: 1, mr: 5 },
  { n: 8, c: 2, r: 3, mc: 2, mr: 5 },
  { n: 9, c: 3, r: 3, mc: 1, mr: 6 },
  { n: 10, c: 4, r: 3, mc: 2, mr: 6 },
];
---

<Prototype
  title="Eyes · a prototype by Payal Chand"
  description="A dark room that says hello. Click near the edges and something looks back."
>
  <Fragment slot="head">
    <Font cssVariable="--font-fredoka" preload />
    <Font cssVariable="--font-cormorant" preload />
    <Font cssVariable="--font-caveat" preload />
    <Font cssVariable="--font-bangers" preload />
  </Fragment>

  <main class="stage" style={`--frame-cell-w: ${CELL_W}; --frame-cell-h: ${CELL_H}; --greeting-w: ${GREETING_W}`} data-stage>
    <h1 class="greeting" aria-label={GREETING} data-greeting>
      {moods.map((m, i) => (
        <span
          class="face"
          style={`font-family: ${m.family}; --scale: ${m.scale}`}
          data-face={m.mood}
          aria-hidden="true"
          data-on={i === 0 ? '' : undefined}
        >{[...GREETING].map((ch) => <span class="ch">{ch}</span>)}</span>
      ))}
    </h1>

    {cells.map(({ n, c, r, mc, mr, eye: Eye }) => (
      <div class="cell" style={`--c: ${c}; --r: ${r}; --mc: ${mc}; --mr: ${mr}`} data-cell={n}>
        {Eye && <Eye />}
      </div>
    ))}
  </main>
</Prototype>

<style>
  :global(html),
  :global(body.proto-body) {
    background: #000;
    margin: 0;
    min-height: 100%;
  }

  /* The grid: four columns by three rows filling the viewport. --u is one
     design px (the cell's width over its width in the 1440 frame). */
  .stage {
    --cell-w: 25vw;
    --cell-h: calc(100vh / 3);
    --u: calc(var(--cell-w) / var(--frame-cell-w));
    display: grid;
    grid-template-columns: repeat(4, var(--cell-w));
    grid-template-rows: repeat(3, var(--cell-h));
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    background: #000;
    color: #fff;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }
  .cell {
    grid-column: var(--c);
    grid-row: var(--r);
    display: grid;
    place-items: center;
  }

  /* Greeting: across the two middle cells. Every face is stacked in one
     spot and clipped top and bottom so the letters roll out of and into
     the line rather than crossing each other. */
  .greeting {
    grid-column: 2 / 4;
    grid-row: 2;
    align-self: center;
    justify-self: center;
    display: grid;
    place-items: center;
    margin: 0;
    font-weight: normal;
    white-space: nowrap;
    pointer-events: none;
    clip-path: inset(0 -50vw);
  }
  .face {
    grid-area: 1 / 1;
    /* Fredoka 600 "hi there!" is about --greeting-w wide at 0.26 px of
       font size per px of width; the other faces are scaled to match */
    font-size: calc(var(--greeting-w) * var(--u) * 0.26 * var(--scale));
    line-height: 1.3;
    visibility: hidden;
  }
  .face[data-on] {
    visibility: visible;
  }
  .ch {
    display: inline-block;
    white-space: pre;
  }
  .face[data-face='fun'] { font-weight: 600; }
  .face[data-face='elegant'] { font-weight: 500; font-style: italic; }
  .face[data-face='professional'] { font-weight: 600; letter-spacing: -0.02em; }
  .face[data-face='casual'] { font-weight: 600; }
  .face[data-face='comic'] { letter-spacing: 0.03em; }

  /* Phones: two columns, cells in the same proportions, the page scrolls */
  @media (max-width: 599.98px) {
    .stage {
      --cell-w: 50vw;
      --cell-h: calc(var(--cell-w) * var(--frame-cell-h) / var(--frame-cell-w));
      grid-template-columns: repeat(2, var(--cell-w));
      grid-template-rows: repeat(6, var(--cell-h));
      height: auto;
      min-height: 100vh;
      overflow: visible;
    }
    .cell {
      grid-column: var(--mc);
      grid-row: var(--mr);
    }
    .greeting {
      grid-column: 1 / 3;
      grid-row: 3;
    }
  }
</style>

<script>
  import { getEye } from '../../../scripts/eyes/registry';
  import {
    LEAVE_GRACE_MS, TOUCH_HOLD_MS,
    GREETING_EVERY_MS, GREETING_ROLL_MS, GREETING_STAGGER_MS, EASE_ROLL,
  } from '../../../scripts/eyes/motion';

  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const stage = document.querySelector<HTMLElement>('[data-stage]')!;
  const cells = [...stage.querySelectorAll<HTMLElement>('[data-cell]')];

  // ── Greeting ────────────────────────────────────────────────────────
  // Letter by letter, the old face rolls up out of the line as the new one
  // rolls up into it, each letter a beat behind the one before.
  const greeting = stage.querySelector<HTMLElement>('[data-greeting]')!;
  const faces = [...greeting.querySelectorAll<HTMLElement>('[data-face]')];
  let face = 0;

  function roll(out: HTMLElement, next: HTMLElement) {
    next.dataset.on = '';
    if (reduced.matches) {
      delete out.dataset.on;
      return;
    }
    const h = greeting.offsetHeight;
    const letters = (el: HTMLElement) => [...el.querySelectorAll<HTMLElement>('.ch')];
    const timing = (i: number): KeyframeAnimationOptions =>
      ({ duration: GREETING_ROLL_MS, delay: i * GREETING_STAGGER_MS, easing: EASE_ROLL, fill: 'both' });

    const leaving = letters(out).map((ch, i) =>
      ch.animate([{ transform: 'translateY(0)' }, { transform: `translateY(${-h}px)` }], timing(i)));
    const arriving = letters(next).map((ch, i) =>
      ch.animate([{ transform: `translateY(${h}px)` }, { transform: 'translateY(0)' }], timing(i)));

    Promise.all([...leaving, ...arriving].map((a) => a.finished)).then(() => {
      delete out.dataset.on;
      [...leaving, ...arriving].forEach((a) => a.cancel());
    }, () => {});
  }

  setInterval(() => {
    const out = faces[face];
    face = (face + 1) % faces.length;
    roll(out, faces[face]);
  }, GREETING_EVERY_MS);

  // ── Eyes ────────────────────────────────────────────────────────────
  // One pair awake at a time. The focal area is the cell itself. With a
  // mouse, the pair leaves once the cursor has been outside its cell for a
  // grace period; on touch it leaves after a hold or when another cell is
  // tapped.
  interface Awake {
    cell: HTMLElement;
    root: HTMLElement;
    grace?: number; // the leave timer, mouse
    hold?: number; // the leave timer, touch
  }
  let awake: Awake | null = null;

  const eyeOf = (cell: HTMLElement) => cell.querySelector<HTMLElement>('[data-eye-root]');

  function cellAt(x: number, y: number) {
    return cells.find((cell) => {
      const r = cell.getBoundingClientRect();
      return x >= r.left && x < r.right && y >= r.top && y < r.bottom;
    }) ?? null;
  }

  function wake(cell: HTMLElement) {
    const root = eyeOf(cell);
    const eye = root && getEye(root.dataset.eyeRoot!);
    if (!root || !eye) return;
    eye.reset(root);
    eye.wake(root, reduced.matches);
    awake = { cell, root };
  }

  function leave() {
    if (!awake) return;
    const { root, grace, hold } = awake;
    awake = null;
    clearTimeout(grace);
    clearTimeout(hold);
    const eye = getEye(root.dataset.eyeRoot!)!;
    eye.leave(root, reduced.matches).then(() => {
      // unless it was woken again meanwhile
      if (awake?.root !== root) eye.reset(root);
    });
  }

  stage.addEventListener('pointerdown', (e) => {
    if (e.button !== 0) return;
    const cell = cellAt(e.clientX, e.clientY);
    if (!cell || !eyeOf(cell)) return;
    if (awake?.cell === cell) {
      if (e.pointerType === 'touch') holdFor(awake);
      return;
    }
    leave();
    wake(cell);
    if (awake && e.pointerType === 'touch') holdFor(awake);
  });

  function holdFor(a: Awake) {
    clearTimeout(a.hold);
    a.hold = window.setTimeout(() => awake === a && leave(), TOUCH_HOLD_MS);
  }

  function outside(a: Awake) {
    if (a.grace) return;
    a.grace = window.setTimeout(() => awake === a && leave(), LEAVE_GRACE_MS);
  }

  function inside(a: Awake) {
    clearTimeout(a.grace);
    a.grace = undefined;
  }

  stage.addEventListener('pointermove', (e) => {
    if (e.pointerType === 'touch' || !awake || awake.hold) return;
    if (cellAt(e.clientX, e.clientY) === awake.cell) inside(awake);
    else outside(awake);
  });
  document.documentElement.addEventListener('pointerleave', (e) => {
    if (e.pointerType !== 'touch' && awake && !awake.hold) outside(awake);
  });
</script>
