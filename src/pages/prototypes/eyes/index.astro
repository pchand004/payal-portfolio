---
/**
 * Eyes — a live prototype.
 *
 * A pitch-black stage with "Hi there!" in the middle, cycling through five
 * typefaces, and ten invisible eye points around it. Click (or tap) near a
 * point to wake its eye; it plays while the cursor stays near, then dims and
 * fades back to black. For now only point 2 has an eye: the "Following" pair.
 *
 * Stage timings live in src/scripts/eyes/motion.ts; each eye keeps its own
 * tunables at the top of its component.
 */
import { Font } from 'astro:assets';
import Prototype from '../../../layouts/Prototype.astro';
import EyeFollowing from '../../../components/eyes/EyeFollowing.astro';

const GREETING = 'Hi there!';

// One face per mood. `scale` evens out x-heights so the word reads the same size.
const moods = [
  { mood: 'fun', family: 'var(--font-fredoka)', scale: 1 },
  { mood: 'elegant', family: 'var(--font-cormorant)', scale: 1.2 },
  { mood: 'professional', family: 'var(--font-inter)', scale: 0.94 },
  { mood: 'casual', family: 'var(--font-caveat)', scale: 1.18 },
  { mood: 'comic', family: 'var(--font-bangers)', scale: 0.92 },
];

// Positions as % of the viewport: desktop (x, y) and under 600px (mx, my),
// where the points stack two by five with the greeting between rows 2 and 3.
const points = [
  { n: 1, x: 12, y: 18, mx: 25, my: 10 },
  { n: 2, x: 37, y: 18, mx: 75, my: 10, eye: EyeFollowing },
  { n: 3, x: 62, y: 18, mx: 25, my: 26 },
  { n: 4, x: 87, y: 18, mx: 75, my: 26 },
  { n: 5, x: 12, y: 50, mx: 25, my: 60 },
  { n: 6, x: 88, y: 50, mx: 75, my: 60 },
  { n: 7, x: 12, y: 82, mx: 25, my: 75 },
  { n: 8, x: 37, y: 82, mx: 75, my: 75 },
  { n: 9, x: 62, y: 82, mx: 25, my: 90 },
  { n: 10, x: 87, y: 82, mx: 75, my: 90 },
];
---

<Prototype
  title="Eyes · a prototype by Payal Chand"
  description="A dark room that says hello. Click near the edges and something looks back."
>
  <Fragment slot="head">
    <Font cssVariable="--font-fredoka" preload />
    <Font cssVariable="--font-cormorant" preload />
    <Font cssVariable="--font-caveat" preload />
    <Font cssVariable="--font-bangers" preload />
  </Fragment>

  <main class="stage" data-stage>
    <h1 class="greeting" aria-label={GREETING} data-greeting>
      {moods.map((m, i) => (
        <span
          class="face"
          style={`font-family: ${m.family}; --scale: ${m.scale}`}
          data-face={m.mood}
          aria-hidden="true"
          data-on={i === 0 ? '' : undefined}
        >{[...GREETING].map((ch) => <span class="ch">{ch}</span>)}</span>
      ))}
    </h1>

    {points.map(({ n, x, y, mx, my, eye: Eye }) => (
      <div
        class="point"
        style={`--x: ${x}%; --y: ${y}%; --mx: ${mx}%; --my: ${my}%`}
        data-point={n}
      >
        {Eye && <Eye />}
      </div>
    ))}
  </main>
</Prototype>

<style>
  :global(html),
  :global(body.proto-body) {
    background: #000;
    overflow: hidden;
    height: 100%;
  }
  .stage {
    --eye-white: #ece8df;
    position: fixed;
    inset: 0;
    background: #000;
    overflow: hidden;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  /* Greeting: every face stacked in one cell, clipped top and bottom so the
     letters roll out of and into the line rather than crossing each other */
  .greeting {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    margin: 0;
    font-weight: normal;
    color: var(--eye-white);
    white-space: nowrap;
    pointer-events: none;
    clip-path: inset(0 -50vw);
  }
  .face {
    grid-area: 1 / 1;
    font-size: calc(clamp(44px, 6.5vw, 92px) * var(--scale));
    line-height: 1.3;
    visibility: hidden;
  }
  .face[data-on] {
    visibility: visible;
  }
  .ch {
    display: inline-block;
    white-space: pre;
  }
  .face[data-face='fun'] { font-weight: 600; }
  .face[data-face='elegant'] { font-weight: 500; font-style: italic; }
  .face[data-face='professional'] { font-weight: 600; letter-spacing: -0.02em; }
  .face[data-face='casual'] { font-weight: 600; }
  .face[data-face='comic'] { letter-spacing: 0.03em; }

  /* Points: centred on their coordinates, invisible until woken. An eye too
     big to sit there whole is nudged in (--keep-x/y are set by the script). */
  .point {
    position: absolute;
    left: clamp(var(--keep-x, 0px), var(--x), calc(100% - var(--keep-x, 0px)));
    top: clamp(var(--keep-y, 0px), var(--y), calc(100% - var(--keep-y, 0px)));
    translate: -50% -50%;
    opacity: 0;
    pointer-events: none;
  }

  @media (max-width: 599.98px) {
    .greeting {
      top: 43%;
    }
    .point {
      left: clamp(var(--keep-x, 0px), var(--mx), calc(100% - var(--keep-x, 0px)));
      top: clamp(var(--keep-y, 0px), var(--my), calc(100% - var(--keep-y, 0px)));
    }
  }
</style>

<script>
  import { getEye } from '../../../scripts/eyes/registry';
  import {
    WAKE_MS, FADE_MS, EASE_OUT, EASE_IN, FOCAL_RADIUS_PX, FOCAL_PAD_PX, TOUCH_HOLD_MS,
    EDGE_PX, WAKE_SCALE, FADE_SCALE,
    GREETING_EVERY_MS, GREETING_ROLL_MS, GREETING_STAGGER_MS, EASE_ROLL,
  } from '../../../scripts/eyes/motion';

  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const stage = document.querySelector<HTMLElement>('[data-stage]')!;
  const points = [...stage.querySelectorAll<HTMLElement>('[data-point]')];

  // ── Greeting ────────────────────────────────────────────────────────
  // Letter by letter, the old face rolls up out of the line as the new one
  // rolls up into it, each letter a beat behind the one before.
  const greeting = stage.querySelector<HTMLElement>('[data-greeting]')!;
  const faces = [...greeting.querySelectorAll<HTMLElement>('[data-face]')];
  let face = 0;

  function roll(out: HTMLElement, next: HTMLElement) {
    next.dataset.on = '';
    if (reduced.matches) {
      delete out.dataset.on;
      return;
    }
    const h = greeting.offsetHeight;
    const letters = (el: HTMLElement) => [...el.querySelectorAll<HTMLElement>('.ch')];
    const timing = (i: number): KeyframeAnimationOptions =>
      ({ duration: GREETING_ROLL_MS, delay: i * GREETING_STAGGER_MS, easing: EASE_ROLL, fill: 'both' });

    const leaving = letters(out).map((ch, i) =>
      ch.animate([{ transform: 'translateY(0)' }, { transform: `translateY(${-h}px)` }], timing(i)));
    const arriving = letters(next).map((ch, i) =>
      ch.animate([{ transform: `translateY(${h}px)` }, { transform: 'translateY(0)' }], timing(i)));

    Promise.all([...leaving, ...arriving].map((a) => a.finished)).then(() => {
      delete out.dataset.on;
      [...leaving, ...arriving].forEach((a) => a.cancel());
    }, () => {});
  }

  setInterval(() => {
    const out = faces[face];
    face = (face + 1) % faces.length;
    roll(out, faces[face]);
  }, GREETING_EVERY_MS);

  // ── Eyes ────────────────────────────────────────────────────────────
  interface Awake {
    point: HTMLElement;
    timer?: number;
  }
  let awake: Awake | null = null;

  const eyeOf = (point: HTMLElement) => point.querySelector<HTMLElement>('[data-eye-root]');

  // Keep a large eye whole on screen: its centre stays half its size plus a
  // margin inside each edge. offsetWidth ignores the wake/fade scale.
  function fit() {
    for (const p of points) {
      if (!eyeOf(p)) continue;
      p.style.setProperty('--keep-x', `${p.offsetWidth / 2 + EDGE_PX}px`);
      p.style.setProperty('--keep-y', `${p.offsetHeight / 2 + EDGE_PX}px`);
    }
  }
  fit();
  addEventListener('resize', fit);

  /** A point's focal area: the standard radius, or wider for a large eye. */
  const radius = (point: HTMLElement) =>
    eyeOf(point) ? Math.max(FOCAL_RADIUS_PX, Math.max(point.offsetWidth, point.offsetHeight) / 2 + FOCAL_PAD_PX) : FOCAL_RADIUS_PX;

  function centre(point: HTMLElement) {
    const r = point.getBoundingClientRect();
    return { x: r.left + r.width / 2, y: r.top + r.height / 2 };
  }

  function distance(point: HTMLElement, x: number, y: number) {
    const c = centre(point);
    return Math.hypot(c.x - x, c.y - y);
  }

  /** The nearest point whose focal area contains (x, y), if any. */
  function pointAt(x: number, y: number) {
    let best: HTMLElement | null = null;
    let bestD = Infinity;
    for (const p of points) {
      const d = distance(p, x, y);
      if (d <= radius(p) && d < bestD) {
        best = p;
        bestD = d;
      }
    }
    return best;
  }

  function wake(point: HTMLElement) {
    const root = eyeOf(point);
    const eye = root && getEye(root.dataset.eyeRoot!);
    if (!root || !eye) return;

    // If it was still fading out, pick up from where its opacity is now
    const from = getComputedStyle(point).opacity;
    point.getAnimations().forEach((a) => a.cancel());
    eye.reset(root);

    const grow = reduced.matches ? 1 : WAKE_SCALE;
    point.animate(
      [{ opacity: from, transform: `scale(${grow})` }, { opacity: 1, transform: 'scale(1)' }],
      { duration: WAKE_MS, easing: EASE_OUT, fill: 'forwards' },
    );
    eye.wake(root, reduced.matches);
    awake = { point };
  }

  function sleep() {
    if (!awake) return;
    const { point, timer } = awake;
    awake = null;
    clearTimeout(timer);

    const from = Number(getComputedStyle(point).opacity);
    point.getAnimations().forEach((a) => a.cancel());
    const fade = point.animate(
      [{ opacity: from, transform: 'scale(1)' }, { opacity: 0, transform: `scale(${FADE_SCALE})` }],
      { duration: FADE_MS, easing: EASE_IN, fill: 'forwards' },
    );
    fade.finished.then(() => {
      const root = eyeOf(point);
      if (root) getEye(root.dataset.eyeRoot!)?.reset(root);
      fade.cancel();
    }, () => {});
  }

  stage.addEventListener('pointerdown', (e) => {
    if (e.button !== 0) return;
    const point = pointAt(e.clientX, e.clientY);
    if (!point) return;
    if (awake?.point === point) {
      if (e.pointerType === 'touch') holdFor(awake);
      return;
    }
    sleep(); // only one eye awake at a time
    wake(point);
    if (awake && e.pointerType === 'touch') holdFor(awake);
  });

  function holdFor(a: Awake) {
    clearTimeout(a.timer);
    a.timer = window.setTimeout(() => awake === a && sleep(), TOUCH_HOLD_MS);
  }

  // Mouse and pen: the eye stays awake while the cursor is in its focal area
  stage.addEventListener('pointermove', (e) => {
    if (e.pointerType === 'touch' || !awake || awake.timer) return;
    if (distance(awake.point, e.clientX, e.clientY) > radius(awake.point)) sleep();
  });
  document.documentElement.addEventListener('pointerleave', (e) => {
    if (e.pointerType !== 'touch' && awake && !awake.timer) sleep();
  });
</script>
