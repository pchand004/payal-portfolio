  /* on a filter, the matching marks pulse once, top to bottom (delay set by script) */
  .dot.is-pulse {
    animation: dot-pulse 260ms cubic-bezier(0.3, 1.3, 0.5, 1) both;
  }
  @keyframes dot-pulse {
    0% { transform: scale(1); }
