  @media (prefers-reduced-motion: reduce) {
    .answer.is-checking::before {
      animation: none;
      background: rgba(255, 255, 255, 0.5);
    }
    .checking li,
    .tabs-ind,
    .note,
    .claim {
      transition: none;
    }
    .dot.is-pulse,
    .tabs-ind.is-sweeping {
      animation: none;
