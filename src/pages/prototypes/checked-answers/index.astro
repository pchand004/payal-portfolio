</style>

<script>
  import { claims, question, searchUrl } from '../../../data/checked-answers';
  import type { Status } from '../../../data/checked-answers';

  /* ───── A pencil tick on selection (Web Audio, 40–70ms of band-passed noise).
     Same on/off key in localStorage ("sound") as the site-wide toggle. ───── */
  let actx: AudioContext | null = null;
  let noise: AudioBuffer | null = null;
  const soundOn = () => {
    try { return localStorage.getItem('sound') !== 'off'; } catch { return true; }
  };
  function primeSound() {
    if (actx) { if (actx.state === 'suspended') actx.resume().catch(() => {}); return; }
    try {
      actx = new AudioContext();
      const len = Math.round(actx.sampleRate * 0.1);
      noise = actx.createBuffer(1, len, actx.sampleRate);
      const d = noise.getChannelData(0);
      for (let i = 0; i < len; i++) d[i] = Math.random() * 2 - 1;
    } catch { actx = null; }
  }
  /* "your answer is here": two soft sine notes, a fifth apart */
  function playChime() {
    if (!soundOn()) return;
    if (!actx) primeSound();
    const c = actx;
    if (!c) return;
    const go = () => {
      try {
        const t0 = c.currentTime + 0.01;
        [[880, 0], [1318.5, 0.09]].forEach(([f, dt]) => {
          const o = c.createOscillator();
          const g = c.createGain();
          o.type = 'sine';
          o.frequency.value = f;
          g.gain.setValueAtTime(0.0001, t0 + dt);
          g.gain.exponentialRampToValueAtTime(0.05, t0 + dt + 0.012);
          g.gain.exponentialRampToValueAtTime(0.0001, t0 + dt + 0.42);
          o.connect(g).connect(c.destination);
          o.start(t0 + dt);
          o.stop(t0 + dt + 0.45);
        });
      } catch { /* a sound must never break an interaction */ }
    };
    if (c.state === 'suspended') c.resume().then(go).catch(() => {});
    else go();
  }

  function playTick() {
    if (!soundOn()) return;
    if (!actx) primeSound();
    const c = actx;
    if (!c || !noise) return;
    const go = () => {
      try {
        const vary = () => 1 + (Math.random() * 2 - 1) * 0.15;
        const dur = 0.04 + Math.random() * 0.03;
        const t0 = c.currentTime;
        const src = c.createBufferSource();
        src.buffer = noise!;
        src.playbackRate.value = vary();
        const bp = c.createBiquadFilter();
        bp.type = 'bandpass';
        bp.frequency.value = 2600 * vary();
        bp.Q.value = 1.4;
        const gain = c.createGain();
        gain.gain.setValueAtTime(0.0001, t0);
        gain.gain.exponentialRampToValueAtTime(0.063, t0 + 0.004);
        gain.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);
        src.connect(bp).connect(gain).connect(c.destination);
        src.start(t0);
        src.stop(t0 + dur + 0.01);
      } catch { /* a sound must never break an interaction */ }
    };
    if (c.state === 'suspended') c.resume().then(go).catch(() => {});
    else go();
  }

  type Live = Status | 'unconfirmed';

  const $ = <T extends Element>(sel: string, root: ParentNode = document) => root.querySelector<T>(sel);
  const $$ = <T extends Element>(sel: string, root: ParentNode = document) => Array.from(root.querySelectorAll<T>(sel));

  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const askScreen = $<HTMLElement>('[data-screen="ask"]')!;
  const answerScreen = $<HTMLElement>('[data-screen="answer"]')!;
  const form = $<HTMLFormElement>('[data-ask-form]')!;
  const input = $<HTMLInputElement>('[data-ask-input]')!;
  const userQ = $<HTMLElement>('[data-user-q]')!;
  const answer = $<HTMLElement>('[data-answer]')!;
  const checking = $<HTMLElement>('[data-checking]')!;
  const steps = $$<HTMLElement>('[data-step]', checking);
  const body = $<HTMLElement>('[data-body]')!;
  const tabs = $$<HTMLButtonElement>('[data-tab]');
  const ind = $<HTMLElement>('[data-tabs-ind]')!;
  const left = $<HTMLElement>('[data-left]')!;
  const leftText = $<HTMLElement>('[data-left-text]')!;
  const walk = $<HTMLButtonElement>('[data-walk]')!;
  const reset = $<HTMLButtonElement>('[data-reset]')!;
  const card = $<HTMLElement>('[data-card]')!;
  const cardDot = $<HTMLElement>('[data-card-dot]', card)!;
  const cardStatus = $<HTMLElement>('[data-card-status]', card)!;
  const cardQuote = $<HTMLElement>('[data-card-quote]', card)!;
  const cardLink = $<HTMLAnchorElement>('[data-card-link]', card)!;
  const cardActions = $<HTMLElement>('[data-card-actions]', card)!;
  const cardNav = $<HTMLElement>('[data-card-nav]', card)!;
  const cardLeft = $<HTMLElement>('[data-card-left]', card)!;
  const cardNext = $<HTMLButtonElement>('[data-card-next]', card)!;
  const wide = matchMedia('(min-width: 1256px)');

  /* ───── State ───── */
  const order = claims.map((c) => c.id);
  const byId = Object.fromEntries(claims.map((c) => [c.id, c]));
  const state: Record<string, Live> = Object.fromEntries(claims.map((c) => [c.id, c.status]));
  const searched = new Set<string>(); // reported claims whose "Find the study" was opened
  let openId: string | null = null;
  let lastFocus: HTMLElement | null = null;

  /* colours for the status word on the paper note (the marks in the answer keep the bright ones) */
  const META: Record<Live, { label: string; color: string }> = {
    sourced: { label: 'Sourced', color: '#1d8f55' },
    reported: { label: 'Reported', color: '#a86a0c' },
    doubtful: { label: 'Doubtful', color: '#c9405a' },
    unconfirmed: { label: 'Unconfirmed', color: 'rgba(74, 11, 122, 0.6)' },
  };

  const countOf = (s: Live) => order.filter((id) => state[id] === s).length;
  const unresolved = () => order.filter((id) => state[id] === 'reported' || state[id] === 'doubtful');
  const claimEl = (id: string) => $<HTMLElement>(`[data-claim="${id}"]`)!;
  /* the claims that came back needing a check (reported or doubtful), in reading order */
  const toCheck = order.filter((id) => byId[id].status !== 'sourced');

  /* the beat for everything after send: the gap between things arriving,
     and how long each one takes to appear (also --beat in the CSS) */
  /* ?beat=600 in the URL tries a different beat (150–1500ms), for tuning by feel */
  const beatParam = Number(new URLSearchParams(location.search).get('beat'));
  const GAP = beatParam >= 150 && beatParam <= 1500 ? Math.round(beatParam) : 350;
  document.documentElement.style.setProperty('--beat', `${GAP}ms`);

  /* ───── Screen 1 → 2 ───── */
  function ask(q: string, instant = false) {
    const box = $<HTMLElement>('.ask-input-row')!;
    const swap = () => {
      userQ.textContent = q;
      if (!(instant || reducedMotion)) answer.classList.add('is-waiting');
      askScreen.hidden = true;
      answerScreen.hidden = false;
      reset.hidden = false;
      window.scrollTo({ top: 0 });
      box.classList.remove('vt-question');
      userQ.classList.add('vt-question');
    };
    const go = () => runChecking(instant || reducedMotion);
    // the card follows the bubble: it starts one beat after the bubble has landed
    const follow = () => window.setTimeout(() => {
      answer.classList.remove('is-waiting');
      answer.classList.add('is-entering');
      answer.addEventListener('animationend', () => answer.classList.remove('is-entering'), { once: true });
      go();
    }, GAP);
    const doc = document as Document & { startViewTransition?: (cb: () => void) => { finished: Promise<void> } };
    if (instant || reducedMotion) {
      swap();
      userQ.classList.remove('vt-question');
      go();
    } else if (doc.startViewTransition) {
      // the question box and the user bubble share a name, so one morphs into the other
      box.classList.add('vt-question');
      const vt = doc.startViewTransition(swap);
      vt.finished.finally(() => {
        userQ.classList.remove('vt-question');
        follow();
      });
    } else {
      swap();
      userQ.classList.remove('vt-question');
      userQ.classList.add('is-arriving');
      userQ.addEventListener('animationend', () => {
        userQ.classList.remove('is-arriving');
        follow();
      }, { once: true });
    }
  }

  function runChecking(instant: boolean) {
    if (instant) {
      steps.forEach((s) => s.classList.add('is-on', 'is-done'));
      reveal();
      return;
    }
    answer.classList.add('is-checking');
    // one line every GAP, starting once the card has settled
    const start = GAP;
    steps.forEach((step, i) => {
      setTimeout(() => {
        step.classList.add('is-on');
        if (i > 0) steps[i - 1].classList.add('is-done');
      }, start + i * GAP);
    });
    const end = start + steps.length * GAP;
    setTimeout(() => steps[steps.length - 1].classList.add('is-done'), end);
    setTimeout(() => reveal(true), end + GAP);
  }

  function reveal(animate = false) {
    answer.classList.remove('is-checking');
    answer.removeAttribute('aria-busy');
    checking.hidden = true;
    if (animate) prepareStream();
    body.hidden = false;
    setFilter('all', false);
    render();
    if (animate) {
      playChime();
      runStream();
    }
  }

  /* ───── Streaming the answer in ─────
     Blocks (tabs, summary, each heading and paragraph, the "left for you" line,
     the legend) arrive one after another, one beat apart. Inside a paragraph
     each sentence or claim fades in one beat after the last, like a reply
     being written. A click on the answer finishes it. */
  let blocks: { el: HTMLElement; typing: number }[] = [];
  let streamTimer = 0;
  let streaming = false;
  /* split a paragraph into units (sentences of plain text, whole claims); a short
     connector like "and" or "On the other side," arrives with the claim after it */
  function wrapUnits(root: HTMLElement) {
    const units: HTMLElement[][] = [];
    let carry: HTMLElement[] = [];
    const push = (el: HTMLElement, short: boolean) => {
      carry.push(el);
      if (!short) {
        units.push(carry);
        carry = [];
      }
    };
    Array.from(root.childNodes).forEach((n) => {
      // bare text (the summary) gets a span first, so it splits like the rest
      let node: Node = n;
      if (n.nodeType === Node.TEXT_NODE) {
        if (!n.textContent?.trim()) return;
        const span = document.createElement('span');
        span.textContent = n.textContent;
        n.parentNode!.replaceChild(span, n);
        node = span;
      }
      if (!(node instanceof HTMLElement)) return;
      if (node.classList.contains('claim')) {
        push(node, false);
        return;
      }
      const text = node.textContent ?? '';
      if (!text.trim()) {
        if (carry.length) carry.push(node);
        return;
      }
      const sentences = text.match(/[^.!?]+[.!?]*\s*/g) ?? [text];
      const frag = document.createDocumentFragment();
      sentences.forEach((sentence) => {
        const u = document.createElement('span');
        u.textContent = sentence;
        frag.append(u);
        push(u, sentence.trim().length < 28);
      });
      node.replaceChildren(frag);
    });
    if (carry.length) units.push(carry);
    units.forEach((group, k) => group.forEach((el) => {
      el.classList.add('u');
      el.style.setProperty('--d', `${k * GAP}ms`);
    }));
    return units.length * GAP;
  }
  function prepareStream() {
    const prose = $<HTMLElement>('[data-prose]')!;
    const els = [$<HTMLElement>('.tabs')!, ...Array.from(prose.children) as HTMLElement[], left, $<HTMLElement>('.legend')!];
    blocks = els.map((el) => {
      el.classList.add('stream');
      const typing = el.tagName === 'P' && el !== left ? wrapUnits(el) : 0;
      return { el, typing };
    });
  }
  function runStream() {
    streaming = true;
    let i = 0;
    const next = () => {
      if (i >= blocks.length) return endStream();
      const b = blocks[i++];
      b.el.classList.add('is-in');
      // the next block starts one beat after this one has fully arrived
      streamTimer = window.setTimeout(next, b.typing + GAP);
    };
    next();
  }
  function endStream() {
    clearTimeout(streamTimer);
    streaming = false;
    // once it's all in, take the streaming classes off, so filters and
    // highlights behave exactly as before (a finished animation would hold opacity)
    blocks.forEach(({ el }) => {
      el.classList.remove('stream', 'is-in');
      el.querySelectorAll<HTMLElement>('.u').forEach((u) => {
        u.classList.remove('u');
        u.style.removeProperty('--d');
      });
    });
  }
  answer.addEventListener('click', (e) => {
    if (!streaming) return;
    e.stopPropagation();
    endStream();
  }, true);

  /* ───── Tabs ───── */
  function moveIndicator(tab: HTMLElement) {
    const nav = tab.parentElement!;
    const r = tab.getBoundingClientRect();
    const n = nav.getBoundingClientRect();
    ind.style.left = `${r.left - n.left}px`;
    ind.style.width = `${r.width}px`;
  }
  let sweepTimer = 0;
  function setFilter(f: string, tick = true) {
    const changed = answer.dataset.filter !== f;
    answer.dataset.filter = f;
    tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tab === f)));
    const active = tabs.find((t) => t.dataset.tab === f)!;
    moveIndicator(active);
    if (!tick) return;
    playTick();
    if (!changed || reducedMotion) return;
    // the underline sweeps as a galaxy stroke, then settles back to white
    ind.classList.remove('is-sweeping');
    void ind.offsetWidth;
    ind.classList.add('is-sweeping');
    clearTimeout(sweepTimer);
    sweepTimer = window.setTimeout(() => ind.classList.remove('is-sweeping'), 480);
    // the marks that match arrive one after another, in reading order
    if (f !== 'all') {
      $$<HTMLElement>(`.claim[data-status="${f}"] .dot`).forEach((d, i) => {
        d.classList.remove('is-pulse');
        void d.offsetWidth;
        d.style.animationDelay = `${i * 40}ms`;
        d.classList.add('is-pulse');
        d.addEventListener('animationend', () => d.classList.remove('is-pulse'), { once: true });
      });
    }
  }
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => setFilter(t.dataset.tab!));
    t.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      e.preventDefault();
      const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
      next.focus();
      setFilter(next.dataset.tab!);
    });
  });
  window.addEventListener('resize', () => {
    const active = tabs.find((t) => t.getAttribute('aria-selected') === 'true');
    if (active && !body.hidden) moveIndicator(active);
  });

  /* ───── Counts + "left for you" ───── */
  function render() {
    (['all', 'sourced', 'reported', 'doubtful'] as const).forEach((k) => {
      const el = $<HTMLElement>(`[data-count="${k}"]`)!;
      el.textContent = String(k === 'all' ? order.length : countOf(k));
    });
    const r = countOf('reported');
    const d = countOf('doubtful');
    const u = countOf('unconfirmed');
    const s = countOf('sourced');
    const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
    if (r + d > 0) {
      const bits: string[] = [];
      if (r) bits.push(`<b>${plural(r, 'needs', 'need')} one more search</b>`);
      if (d) bits.push(`<b>${plural(d, 'needs', 'need')} a call</b> from you`);
      let html = `Left for you: ${bits.join(', ')}.`;
      if (u) html += ` ${plural(u, 'claim', 'claims')} set aside.`;
      leftText.innerHTML = html;
      left.classList.remove('is-done');
      walk.textContent = openId ? 'Continue' : 'Walk me through';
    } else {
      leftText.innerHTML = `Nothing left for you. <b>${s}</b> ${s === 1 ? 'claim holds' : 'claims hold'} up; ${u} set aside.`;
      left.classList.add('is-done');
    }
  }

  /* ───── Claim card ───── */
  function button(label: string, opts: { href?: string; act?: string; primary?: boolean }) {
    const el = document.createElement(opts.href ? 'a' : 'button');
    el.className = opts.primary ? 'act' : 'act act-secondary';
    el.textContent = label;
    if (opts.href) {
      el.setAttribute('href', opts.href);
      el.setAttribute('target', '_blank');
      el.setAttribute('rel', 'noopener noreferrer');
      el.insertAdjacentHTML('beforeend', ' <span aria-hidden="true">↗</span>');
    } else {
      el.setAttribute('type', 'button');
    }
    if (opts.act) el.dataset.act = opts.act;
    return el;
  }

  function renderCard(id: string) {
    const c = byId[id];
    const st = state[id];
    const original = c.status;
    card.style.setProperty('--k', META[st].color);
    cardDot.className = `dot dot-${st}`;
    cardStatus.textContent = META[st].label;
    cardQuote.textContent = c.quote ?? c.text;
    cardLink.textContent = c.link;
    // for a reported claim the link given is the news piece itself: open it from here
    if (st === 'reported' && c.linkHref) {
      cardLink.href = c.linkHref;
      cardLink.target = '_blank';
      cardLink.rel = 'noopener noreferrer';
    } else {
      cardLink.removeAttribute('href');
    }
    cardActions.replaceChildren();

    if (st === 'sourced') {
      cardActions.append(button('Open the study', { href: c.linkHref ?? searchUrl(c.search), primary: true }));
      if (original !== 'sourced') cardActions.append(button('Undo', { act: 'undo' }));
    } else if (st === 'reported') {
      cardActions.append(button('Find the study', { href: searchUrl(c.search), act: 'find', primary: true }));
      if (searched.has(id)) cardActions.append(button('It says this', { act: 'confirm' }));
    } else if (st === 'doubtful' && c.actions) {
      c.actions.forEach((a, i) => cardActions.append(button(a.label, { href: a.href, primary: i === 0 })));
    } else if (st === 'doubtful') {
      cardActions.append(button('Treat as unconfirmed', { act: 'unconfirm', primary: true }));
      cardActions.append(button('Nearest study', { href: searchUrl(c.search) }));
    } else {
      cardActions.append(button('Undo', { act: 'undo' }));
    }

    const todo = unresolved();
    const pos = toCheck.indexOf(id);
    cardNav.hidden = todo.length === 0;
    cardLeft.textContent = !todo.length ? '' : pos >= 0 ? `${pos + 1} of ${toCheck.length} to check` : `${toCheck.length} to check`;
    cardNext.disabled = todo.length === 0 || (todo.includes(id) && todo[todo.length - 1] === id);
  }

  /* Beside the claim on wide screens (absolute, inside .chat, so it scrolls with
     the answer); the CSS turns it into a bottom sheet below 1140px. */
  function placeCard() {
    if (!openId) return;
    if (!wide.matches) {
      card.style.top = '';
      card.style.left = '';
      answer.style.paddingBottom = '';
      return;
    }
    const r = claimEl(openId).getClientRects()[0];
    const a = answer.getBoundingClientRect();
    const c = answerScreen.getBoundingClientRect();
    card.style.top = `${Math.round(r.top - c.top - 8)}px`;
    card.style.left = `${Math.round(a.right - c.left + 28)}px`;
    // room under the answer as tall as the card, so the text and legend
    // beside and below it can still be scrolled into view
    answer.style.paddingBottom = `${24 + card.offsetHeight}px`;
  }
  window.addEventListener('resize', placeCard);

  function openCard(id: string, scroll = false) {
    if (openId) claimEl(openId).classList.remove('is-open');
    openId = id;
    const el = claimEl(id);
    el.classList.add('is-open');
    renderCard(id);
    card.hidden = false;
    placeCard();
    requestAnimationFrame(() => card.classList.add('is-open'));
    if (scroll) el.scrollIntoView({ block: 'center', behavior: reducedMotion ? 'auto' : 'smooth' });
    render();
    playTick();
  }
  function closeCard() {
    if (!openId) return;
    claimEl(openId).classList.remove('is-open');
    openId = null;
    answer.style.paddingBottom = '';
    card.classList.remove('is-open');
    setTimeout(() => { if (!openId) card.hidden = true; }, reducedMotion ? 0 : 260);
    render();
    lastFocus?.focus();
    lastFocus = null;
  }
  function step(dir: 1 | -1) {
    const todo = unresolved();
    if (!todo.length) return closeCard();
    let next: string | undefined;
    if (openId && todo.includes(openId)) {
      next = todo[todo.indexOf(openId) + dir];
    } else if (openId) {
      // the open claim was just resolved: carry on from its position in the answer
      const pos = order.indexOf(openId);
      next = dir === 1 ? todo.find((id) => order.indexOf(id) > pos) : [...todo].reverse().find((id) => order.indexOf(id) < pos);
    } else {
      next = dir === 1 ? todo[0] : todo[todo.length - 1];
    }
    if (next) openCard(next, true);
  }

  $$<HTMLElement>('.claim').forEach((el) => {
    const go = () => {
      lastFocus = el;
      openId === el.dataset.claim ? closeCard() : openCard(el.dataset.claim!);
    };
    el.addEventListener('click', go);
    el.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        go();
      }
    });
  });

  cardActions.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-act]');
    if (!btn || !openId) return;
    const id = openId;
    const act = btn.dataset.act;
    if (act === 'find') {
      // the link opens in a new tab; here we only remember that the search happened
      searched.add(id);
      setTimeout(() => renderCard(id), 200);
      return;
    }
    if (act === 'unconfirm') state[id] = 'unconfirmed';
    if (act === 'confirm') state[id] = 'sourced';
    if (act === 'undo') state[id] = byId[id].status;
    claimEl(id).dataset.status = state[id];
    requestAnimationFrame(placeCard);
    playTick();
    renderCard(id);
    render();
  });
  $<HTMLElement>('[data-card-close]')!.addEventListener('click', closeCard);
  cardNext.addEventListener('click', () => step(1));
  walk.addEventListener('click', () => {
    lastFocus = walk;
    step(1);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && openId) closeCard();
  });

  /* ───── Ask ───── */
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    primeSound();
    ask(input.value.trim() || question);
  });
  $$<HTMLButtonElement>('[data-suggest]').forEach((b) => {
    b.addEventListener('click', () => {
      input.value = b.querySelector('span')!.textContent!.trim();
      primeSound();
      playTick();
      ask(input.value);
    });
  });
  reset.addEventListener('click', () => {
    location.href = location.pathname;
  });

  /* ───── Background: a dot field that lifts near the cursor, with a lagging glow
     for depth. ───── */
  const fx = $<HTMLCanvasElement>('[data-fx]')!;
  const fxc = fx.getContext('2d');
  if (fxc && !reducedMotion) {
    const SP = 34; // dot spacing
    let W = 0;
    let H = 0;
    let fxRaf = 0;
    const mouse = { x: -1e4, y: -1e4 };
    const glow = { x: -1e4, y: -1e4 };
    const frame = () => {
      if (!fxRaf) fxRaf = requestAnimationFrame(drawFx);
    };
    function resizeFx() {
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      W = window.innerWidth;
      H = window.innerHeight;
      fx.width = Math.round(W * dpr);
      fx.height = Math.round(H * dpr);
      fxc!.setTransform(dpr, 0, 0, dpr, 0, 0);
      frame();
    }
    function drawFx() {
      fxRaf = 0;
      const c = fxc!;
      c.clearRect(0, 0, W, H);
      glow.x += (mouse.x - glow.x) * 0.14;
      glow.y += (mouse.y - glow.y) * 0.14;
      const near = mouse.x > -1000;
      if (near) {
        const g = c.createRadialGradient(glow.x, glow.y, 0, glow.x, glow.y, 340);
        g.addColorStop(0, 'rgba(214, 160, 255, 0.30)');
        g.addColorStop(0.5, 'rgba(214, 160, 255, 0.10)');
        g.addColorStop(1, 'rgba(214, 160, 255, 0)');
        c.fillStyle = g;
        c.fillRect(glow.x - 340, glow.y - 340, 680, 680);
      }
      const ox = ((W % SP) / 2) | 0;
      const oy = ((H % SP) / 2) | 0;
      for (let x = ox; x <= W; x += SP) {
        for (let y = oy; y <= H; y += SP) {
          const k = near ? Math.max(0, 1 - Math.hypot(x - glow.x, y - glow.y) / 210) : 0;
          c.beginPath();
          c.arc(x, y, 1.1 + k * k * 2, 0, Math.PI * 2);
          c.fillStyle = `rgba(255,255,255,${(0.14 + k * 0.75).toFixed(3)})`;
          c.fill();
        }
      }
      const settled = Math.abs(mouse.x - glow.x) < 0.2 && Math.abs(mouse.y - glow.y) < 0.2;
      if (!settled) frame();
    }
    window.addEventListener('resize', resizeFx, { passive: true });
    window.addEventListener('pointermove', (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
      frame();
    }, { passive: true });
    document.addEventListener('pointerleave', () => {
      mouse.x = -1e4;
      mouse.y = -1e4;
      frame();
    });
    resizeFx();
  }

  const hash = location.hash.replace('#', '');
  if (hash === 'answer' || hash === 'now') ask(question, hash === 'now');
</script>
