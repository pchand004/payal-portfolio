  /* ───── Margin note ─────
     Paper, like the question bubble. One status line, the link given, the
     actions as plain text, a footnote. No quote on wide screens: the claim it
     belongs to is highlighted right beside it. */
  .note {
    position: absolute;
    z-index: 30;
    width: 416px;
