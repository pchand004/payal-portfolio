---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const impactStats = [
  { value: '10s → 4s', caption: 'Reduced interaction hesitation for novice users.' },
  { value: '50+', caption: 'Students iterated with to eliminate comprehension gaps.' },
  { value: '10+', caption: 'EVAM modules powered by the shipped interaction system.' },
];

const fieldBullets = [
  'Interview analysis — think-aloud sessions during task-based VR interaction, followed by post-task interviews',
  'Field visits to rural schools in Assam — observing students engage with VR in their actual learning environment',
  'Data synthesis — clustering patterns across novice and intermediate user behaviours',
];

const beforeBullets = [
  'Passive observation',
  'Redundancy across settings',
  'Visual feedback only',
];

const afterBullets = [
  'Active investigation per planet',
  'Progression building on prior knowledge',
  'Multi-modal feedback (visual, haptic, audio)',
];

const flowSteps = [
  { n: '01', name: 'Earth Departure', desc: 'Start in spaceship.' },
  { n: '02', name: 'Planet Selection', desc: 'Mars, Venus, or Jupiter.' },
  { n: '03', name: 'Gravity Interaction', desc: 'Observe gravitational effects.' },
  { n: '04', name: 'Earth Return', desc: 'Findings summary displayed.' },
];

const constraints = [
  {
    n: '01',
    title: 'Why not include all planets?',
    body:
      "More options didn't improve learning. The team focused on Mars, Venus, and Jupiter for stronger gravitational contrast against Earth.",
  },
  {
    n: '02',
    title: 'Why limit objects?',
    body:
      'Too many options diluted attention. A small curated set of familiar objects (marble, ball, bottle) encouraged deeper experimentation.',
  },
  {
    n: '03',
    title: 'Make gravity actionable',
    body:
      'Experience > observation. Every gravity moment had to be felt through interaction, not passively watched.',
  },
];

const showupCols = [
  {
    title: 'Successful action',
    body: 'Synchronised sound and motion confirms the state change.',
    color: '#C9D5B0',
    caption: '[Successful action image]',
  },
  {
    title: 'Incorrect attempt',
    body: 'Visual and audio feedback signal a retry without breaking flow.',
    color: '#F0DCA0',
    caption: '[Incorrect attempt image]',
  },
  {
    title: 'User hesitation',
    body: 'Ghost-hand animation reappears as gentle guidance.',
    color: '#F0C5C5',
    caption: '[Hesitation image]',
  },
];

const phases = [
  {
    n: '01',
    name: 'Identification',
    body:
      'Informing users of the required action — through ghost-hand animations, voice prompts, and contextual cues.',
  },
  {
    n: '02',
    name: 'Comprehension',
    body:
      'Understanding the necessary interactions to complete the step — confirmed through repeated exposure and guidance loops.',
  },
  {
    n: '03',
    name: 'Performance',
    body:
      'Executing learned interactions accurately — supported by feedback that confirmed success and corrected errors.',
  },
];

const interactions = [
  {
    color: '#C9D5B0',
    title: 'Object selection on Mars',
    body: 'Users choose between 3 familiar objects mapped to small, medium, and large sizes.',
  },
  {
    color: '#F0DCA0',
    title: 'Guided grab and release',
    body: 'Ghost-hand animation and a short voice prompt guide first-time VR users through the action.',
  },
  {
    color: '#F0C5C5',
    title: 'Visualised gravity comparison',
    body: 'Color-coded trails (green for Earth, purple for the selected planet) make differences in gravity immediately visible.',
  },
];

const findings = [
  {
    n: '01',
    body:
      'Action-led interaction reduced hesitation more than visual cues alone — students engaged faster when given something to grab and release.',
  },
  {
    n: '02',
    body:
      'Color-coded gravity trails (green for Earth, purple for selected planet) made physics differences immediately legible.',
  },
  {
    n: '03',
    body:
      'Limiting object count and planet selection sharpened comparison — restraint enabled deeper learning.',
  },
];
---

<Layout
  title="Gravity's Grip — Payal Chand · VR physics for grades 8–12"
  description="A VR learning module exploring how immersive interaction can complement classroom teaching by making abstract physics — like gravity — experiential, action-led, and learnable."
>
  <Nav />

  <article class="gg">
    {/* ───── Hero ───── */}
    <section class="pt-12 pb-2 md:pt-16">
      <div class="gg-prose gg-hero-grid">
        <div class="gg-hero-left">
          <p class="gg-eyebrow">N°04 · Case Study</p>
          <h1 class="gg-h1">Gravity's Grip</h1>
          <p class="gg-subtitle">VR physics for grades 8–12 · 2024</p>
        </div>
        <div class="gg-hero-right">
          <p class="gg-body">
            A VR learning module exploring how immersive interaction can complement
            classroom teaching by making abstract physics — like gravity — experiential,
            action-led, and learnable. Students were familiar with gravity through
            textbooks; this project focused on how that understanding changes when the same
            concept is encountered through embodied interaction in VR.
          </p>
        </div>
      </div>
    </section>

    {/* ───── Metadata strip ───── */}
    <section class="gg-meta">
      <div class="grid grid-cols-1 gap-x-8 gap-y-5 md:grid-cols-3">
        <div>
          <p class="gg-meta-label">Role</p>
          <p class="gg-meta-value">Spatial UX Designer · Interaction Designer</p>
        </div>
        <div>
          <p class="gg-meta-label">Year</p>
          <p class="gg-meta-value">2024</p>
        </div>
        <div>
          <p class="gg-meta-label">Read more</p>
          <p class="gg-meta-value">
            <a
              href="https://docs.google.com/document/d/1hZfoCJG71Ps13HAgGCSjbk14iZQiXjZI3oLx3add2xM/edit?usp=sharing"
              target="_blank"
              rel="noopener noreferrer"
              class="gg-link"
            >
              Full documentation ↗
            </a>
          </p>
        </div>
      </div>
    </section>

    {/* ───── Cover video ───── */}
    <section class="mt-6 md:mt-8">
      <div class="gg-video">
        <iframe
          src="https://www.youtube.com/embed/pg1b5vzepG8?rel=0&modestbranding=1&iv_load_policy=3&controls=1&showinfo=0&playsinline=1"
          title="Gravity's Grip — VR physics module"
          class="h-full w-full"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
      <p class="gg-caption gg-prose">
        Gravity's Grip — a VR module letting students feel how gravity changes across
        planets.
      </p>
    </section>

    {/* ───── Impact stats ───── */}
    <section class="gg-block">
      <div class="gg-prose gg-impact">
        <p class="gg-impact-label">Impact</p>
        <div class="gg-impact-grid">
          {impactStats.map((s) => (
            <div>
              <p class="gg-impact-num">{s.value}</p>
              <p class="gg-impact-caption">{s.caption}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ───── Pull quote ───── */}
    <section class="gg-quote-section">
      <blockquote class="gg-quote gg-prose">
        Making gravity learnable by reducing cognitive friction through embodied VR
        interaction.
      </blockquote>
    </section>

    {/* ───── Context ───── */}
    <section class="gg-block">
      <div class="gg-prose">
        <h2 class="gg-h2">Context</h2>
        <p class="gg-body gg-body--mt-md">
          Students can memorise physics formulas but often struggle to feel forces like
          gravity and momentum. Learning remains abstract, fragile, and difficult to
          retain.
        </p>
        <p class="gg-body gg-body--mt-sm">
          VR offers the potential to make these forces experiential — but for novice users,
          interaction itself can become a learning barrier. The challenge wasn't visualising
          physics; it was making interaction the explanation.
        </p>
      </div>
    </section>

    {/* ───── Hypothesis ───── */}
    <section class="gg-block">
      <div class="gg-prose">
        <h2 class="gg-h2">Hypothesis</h2>
        <p class="gg-subhead">The question we started with.</p>
        <p class="gg-body gg-body--mt-md">
          How does a student's understanding of gravity change when the same concept is
          encountered through embodied, action-led interaction rather than passive
          observation?
        </p>
        <p class="gg-body gg-body--mt-sm">
          This question shaped every interaction decision that followed.
        </p>
      </div>
    </section>

    {/* ───── Field research ───── */}
    <section class="gg-block">
      <div class="gg-prose">
        <h2 class="gg-h2">Field research</h2>
        <p class="gg-subhead">
          Before refining interactions, the work focused on understanding how students
          experience VR learning in real classroom conditions.
        </p>
        <p class="gg-body gg-body--mt-md">What we explored:</p>
        <ul class="gg-bullets">
          {fieldBullets.map((b) => <li>{b}</li>)}
        </ul>
        <p class="gg-body gg-body--mt-md gg-body--italic-muted">
          Insights from this phase fed directly into the design recommendations that
          followed.
        </p>
      </div>
      <div class="gg-image gg-image--mt" style="background-color: #F5C9B4;">
        [Field research photo — rural school, Assam]
      </div>
    </section>

    {/* ───── Early exploration ───── */}
    <section class="gg-block">
      <div class="gg-prose">
        <h2 class="gg-h2">Early exploration</h2>
        <p class="gg-subhead">What we started with vs where we ended up.</p>

        <div class="gg-compare-grid">
          <div class="gg-compare-card gg-compare-card--before">
            <p class="gg-compare-header">❌ Started with</p>
            <ul class="gg-compare-list">
              {beforeBullets.map((b) => <li>{b}</li>)}
            </ul>
          </div>
          <div class="gg-compare-card gg-compare-card--after">
            <p class="gg-compare-header">✅ Ended up with</p>
            <ul class="gg-compare-list">
              {afterBullets.map((b) => <li>{b}</li>)}
            </ul>
          </div>
        </div>

        <p class="gg-compare-closing">
          Engagement had to come from interaction depth, not environmental spectacle.
        </p>
      </div>
    </section>

    {/* ───── Experience flow ───── */}
    <section class="gg-block">
      <div class="gg-prose">
        <h2 class="gg-h2">Experience flow</h2>
        <p class="gg-subhead">A clear, sequential journey to reduce cognitive load.</p>

        <div class="gg-flow-grid">
          {flowSteps.map((s) => (
            <div class="gg-flow-step">
              <p class="gg-flow-num">{s.n}</p>
              <p class="gg-flow-name">{s.name}</p>
              <p class="gg-flow-desc">{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ───── Key constraints & decisions ───── */}
    <section class="gg-block">
      <div class="gg-prose gg-hero-grid">
        <div>
          <h2 class="gg-h2">Key constraints &amp; decisions</h2>
          <p class="gg-subhead">Three decisions that shaped Gravity Grip.</p>
        </div>
        <div>
          <ul class="gg-list">
            {constraints.map((c) => (
              <li class="gg-row">
                <span class="gg-num gg-num--principle">{c.n}</span>
                <div class="flex-1">
                  <p class="gg-row-name">{c.title}</p>
                  <p class="gg-row-desc">{c.body}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    {/* ───── Interaction logic & system feedback ───── */}
    <section class="gg-block">
      <div class="gg-prose">
        <h2 class="gg-h2">Interaction logic &amp; system feedback</h2>
        <p class="gg-body gg-body--mt-md">
          Three responses to user behaviour shaped the interaction model:
        </p>
      </div>
      <div class="gg-showup-grid">
        {showupCols.map((c) => (
          <div class="gg-showup-cell">
            <h3 class="gg-showup-title">{c.title}</h3>
            <p class="gg-showup-body">{c.body}</p>
            <div class="gg-showup-image" style={`background-color: ${c.color};`}>
              {c.caption}
            </div>
          </div>
        ))}
      </div>
    </section>

    {/* ───── Designing for sequential learning ───── */}
    <section class="gg-block">
      <div class="gg-prose">
        <h2 class="gg-h2">Designing for sequential learning</h2>
        <p class="gg-subhead">
          Each interaction was broken into three phases to support novice users.
        </p>

        <ul class="gg-list gg-list--mt">
          {phases.map((p) => (
            <li class="gg-row">
              <span class="gg-num gg-num--principle">{p.n}</span>
              <div class="flex-1">
                <p class="gg-row-name">{p.name}</p>
                <p class="gg-row-desc">{p.body}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ───── Key interactions ───── */}
    <section class="gg-block">
      <div class="gg-prose">
        <h2 class="gg-h2">Key interactions</h2>
        <p class="gg-body gg-body--mt-md">
          Three moments from the experience that demonstrate the interaction system in
          action.
        </p>
      </div>
      <div class="gg-cards-grid">
        {interactions.map((i) => (
          <div class="gg-card">
            <div class="gg-card-fill" style={`background-color: ${i.color};`}></div>
            <p class="gg-card-title">{i.title}</p>
            <p class="gg-card-body">{i.body}</p>
          </div>
        ))}
      </div>
    </section>

    {/* ───── What testing showed ───── */}
    <section class="gg-block">
      <div class="gg-prose">
        <h2 class="gg-h2">What testing showed</h2>
        <p class="gg-body gg-body--mt-md">
          Field testing across Indian schools surfaced three patterns:
        </p>

        <ul class="gg-list gg-list--mt">
          {findings.map((f) => (
            <li class="gg-row">
              <span class="gg-num gg-num--finding">{f.n}</span>
              <p class="gg-row-finding">{f.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ───── Closing footer links (above site footer) ───── */}
    <section class="gg-closing">
      <p class="gg-caption gg-prose">
        Full research and development documentation:{' '}
        <a
          href="https://docs.google.com/document/d/1hZfoCJG71Ps13HAgGCSjbk14iZQiXjZI3oLx3add2xM/edit?usp=sharing"
          target="_blank"
          rel="noopener noreferrer"
          class="gg-link not-italic"
        >
          Gravity Grip ↗
        </a>
      </p>
      <p class="gg-prose gg-back">
        <a href="/work" class="gg-link">← Back to all work</a>
      </p>
    </section>
  </article>

  <Footer />
</Layout>

<style>
  /* ───── Width helpers — text column 960 max, left-aligned. Media fills. ───── */
  .gg-prose {
    max-width: 960px;
    margin: 0;
  }

  /* ───── Inter for all headings (override the global Fraunces default) ───── */
  .gg h1,
  .gg h2,
  .gg h3 {
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    letter-spacing: -0.01em;
  }

  /* ───── Type scale ───── */
  .gg-eyebrow {
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #6B6354;
  }

  .gg-h1 {
    font-size: 36px;
    font-weight: 700;
    color: #2C2620;
    line-height: 1.1;
    margin-top: 24px;
  }
  @media (min-width: 768px) {
    .gg-h1 {
      font-size: 56px;
    }
  }

  .gg-subtitle {
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    font-size: 13px;
    font-style: normal;
    font-weight: 400;
    color: #6B6354;
    margin-top: 12px;
  }
  @media (min-width: 768px) {
    .gg-subtitle {
      font-size: 14px;
    }
  }

  .gg-h2 {
    font-size: 22px;
    font-weight: 700;
    color: #2C2620;
    line-height: 1.25;
  }
  @media (min-width: 768px) {
    .gg-h2 {
      font-size: 28px;
    }
  }

  .gg-subhead {
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    font-size: 13px;
    font-style: italic;
    color: #6B6354;
    margin-top: 8px;
  }

  .gg-body {
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    font-size: 16px;
    font-weight: 400;
    color: #2C2620;
    line-height: 1.65;
  }
  @media (min-width: 768px) {
    .gg-body {
      font-size: 17px;
    }
  }
  .gg-body--mt-md { margin-top: 24px; }
  .gg-body--mt-sm { margin-top: 16px; }
  .gg-body--italic-muted {
    font-style: italic;
    color: #6B6354;
  }

  .gg-bullets {
    margin-top: 12px;
    margin-bottom: 0;
    padding-left: 22px;
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    font-size: 15px;
    color: #2C2620;
    line-height: 1.6;
    list-style: disc;
  }
  @media (min-width: 768px) {
    .gg-bullets {
      font-size: 16px;
    }
  }
  .gg-bullets > li + li {
    margin-top: 8px;
  }

  .gg-quote {
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    font-size: 18px;
    font-style: normal;
    font-weight: 400;
    color: #4105DB;
    line-height: 1.45;
    border-left: 4px solid #4105DB;
    padding-left: 20px;
    margin: 0;
  }
  @media (min-width: 768px) {
    .gg-quote {
      font-size: 22px;
    }
  }

  /* Pull-quote bridge — sits between Impact and Context. */
  .gg-quote-section {
    margin-top: 48px;
  }
  .gg-quote-section + .gg-block {
    margin-top: 48px;
  }
  @media (min-width: 768px) {
    .gg-quote-section { margin-top: 64px; }
    .gg-quote-section + .gg-block { margin-top: 64px; }
  }

  .gg-caption {
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    font-size: 13px;
    font-style: italic;
    color: #6B6354;
    line-height: 1.55;
    margin-top: 12px;
    max-width: 720px;
  }

  /* ───── Metadata strip ───── */
  .gg-meta {
    margin-top: 32px;
    padding: 20px 0;
    border-top: 0.5px solid #E8E4E0;
    border-bottom: 0.5px solid #E8E4E0;
  }
  .gg-meta-label {
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #4105DB;
  }
  .gg-meta-value {
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    font-size: 14px;
    color: #2C2620;
    margin-top: 6px;
  }

  /* ───── Links ───── */
  .gg-link {
    color: #4105DB;
    transition: color 200ms ease;
  }
  .gg-link:hover {
    color: #5B2EE8;
  }

  /* ───── Section block spacing ───── */
  .gg-block {
    margin-top: 64px;
  }
  @media (min-width: 768px) {
    .gg-block {
      margin-top: 96px;
    }
  }

  /* ───── Cover video ───── */
  .gg-video {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 8px;
    background: #000;
  }

  /* ───── Inline image (full-width placeholder, 21:9) ───── */
  .gg-image {
    width: 100%;
    aspect-ratio: 21 / 9;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    font-size: 13px;
    font-style: italic;
    color: rgba(44, 38, 32, 0.6);
  }
  .gg-image--mt {
    margin-top: 24px;
  }

  /* ───── Hero 2-column grid (40/60) ───── */
  .gg-hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }
  @media (min-width: 768px) {
    .gg-hero-grid {
      grid-template-columns: 2fr 3fr;
      gap: 48px;
      align-items: start;
    }
    .gg-hero-right {
      padding-top: 43px;
    }
  }

  /* ───── Impact stats ───── */
  .gg-impact {
    padding: 24px 0;
    border-top: 0.5px solid #E8E4E0;
    border-bottom: 0.5px solid #E8E4E0;
  }
  .gg-impact-label {
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #4105DB;
    margin: 0 0 16px;
  }
  .gg-impact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: start;
  }
  @media (min-width: 768px) {
    .gg-impact-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .gg-impact-num {
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    font-size: 24px;
    font-weight: 700;
    color: #4105DB;
    line-height: 1.1;
    margin: 0;
  }
  @media (min-width: 768px) {
    .gg-impact-num {
      font-size: 32px;
    }
  }
  .gg-impact-caption {
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    font-size: 12px;
    color: #2C2620;
    line-height: 1.45;
    margin-top: 8px;
  }

  /* ───── Numbered list (constraints, phases, findings) ───── */
  .gg-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .gg-list--mt { margin-top: 24px; }

  .gg-row {
    display: flex;
    gap: 12px;
    padding: 16px 0;
  }
  .gg-row + .gg-row {
    border-top: 0.5px solid #E8E4E0;
  }

  .gg-num {
    min-width: 32px;
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    font-style: italic;
    font-weight: 600;
    color: #4105DB;
    flex-shrink: 0;
  }
  .gg-num--principle { font-size: 14px; }
