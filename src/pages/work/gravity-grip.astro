---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const impactStats = [
  { value: '10s → 4s', caption: 'Reduced interaction hesitation for novice users.' },
  { value: '50+', caption: 'Students iterated with to eliminate comprehension gaps.' },
  { value: '10+', caption: 'Modules powered by the shipped system.' },
];

const flowSteps = [
  { n: '01', name: 'Earth Departure', desc: 'Start in spaceship.' },
  { n: '02', name: 'Planet Selection', desc: 'Mars, Venus, or Jupiter.' },
  { n: '03', name: 'Gravity Interaction', desc: 'Observe gravitational effects.' },
  { n: '04', name: 'Earth Return', desc: 'Findings summary displayed.' },
];

const constraints = [
  {
    n: '01',
    title: 'Why not include all planets?',
    body:
      "More options didn't improve learning. The team focused on Mars, Venus, and Jupiter for stronger gravitational contrast against Earth.",
  },
  {
    n: '02',
    title: 'Why limit objects?',
    body:
      'Too many options diluted attention. A small curated set of familiar objects (marble, ball, bottle) encouraged deeper experimentation.',
  },
  {
    n: '03',
    title: 'Make gravity actionable',
    body:
      'Experience > observation. Every gravity moment had to be felt through interaction, not passively watched.',
  },
];

const showupCols = [
  {
    title: 'Successful action',
    body: 'Synchronised sound and motion confirms the state change.',
    color: '#C9D5B0',
    caption: '[Successful action image]',
  },
  {
    title: 'Incorrect attempt',
    body: 'Visual and audio feedback signal a retry without breaking flow.',
    color: '#F0DCA0',
    caption: '[Incorrect attempt image]',
  },
  {
    title: 'User hesitation',
    body: 'Ghost-hand animation reappears as gentle guidance.',
    color: '#F0C5C5',
    caption: '[Hesitation image]',
  },
];

const phases = [
  {
    n: '01',
    name: 'Identification',
    body:
      'Informing users of the required action — through ghost-hand animations, voice prompts, and contextual cues.',
  },
  {
    n: '02',
    name: 'Comprehension',
    body:
      'Understanding the necessary interactions to complete the step — confirmed through repeated exposure and guidance loops.',
  },
  {
    n: '03',
    name: 'Performance',
    body:
      'Executing learned interactions accurately — supported by feedback that confirmed success and corrected errors.',
  },
];

const interactions = [
  {
    color: '#C9D5B0',
    caption: 'Object selection on Mars',
    desc: 'Users choose between 3 familiar objects mapped to small, medium, and large sizes.',
  },
  {
    color: '#F0DCA0',
    caption: 'Guided grab and release',
    desc: 'Ghost-hand animation and a short voice prompt guide first-time VR users through the action.',
  },
  {
    color: '#F0C5C5',
    caption: 'Visualised gravity comparison',
    desc: 'Color-coded trails (green for Earth, purple for the selected planet) make differences in gravity immediately visible.',
  },
];

const findings = [
  {
    n: '01',
    body:
      'Action-led interaction reduced hesitation more than visual cues alone — students engaged faster when given something to grab and release.',
  },
  {
    n: '02',
    body:
      'Color-coded gravity trails (green for Earth, purple for selected planet) made physics differences immediately legible.',
  },
  {
    n: '03',
    body:
      'Limiting object count and planet selection sharpened comparison — restraint enabled deeper learning.',
  },
];
---

<Layout
  title="Gravity's Grip — Payal Chand · VR physics for grades 8-12"
  description="A VR learning module exploring how immersive interaction can complement classroom teaching by making abstract physics — like gravity — experiential, action-led, and learnable."
>
  <Nav />

  <article class="gg">
    {/* ───── Hero ───── */}
    <section class="pt-8 pb-2 md:pt-12">
      <div class="gg-prose gg-hero-grid">
        <div class="gg-hero-left">
          <p class="gg-eyebrow">N°04 · Case Study</p>
          <h1 class="gg-h1">Gravity's Grip</h1>
          <p class="gg-subtitle">VR physics for grades 8-12 · 2024</p>
        </div>
        <div class="gg-hero-right">
          <p class="gg-body">
            Students were familiar with gravity through textbooks; this project focused on
            how that understanding changes when the same concept is encountered through
            embodied interaction in VR.
          </p>
        </div>
      </div>
    </section>

    {/* ───── Metadata strip ───── */}
    <section class="gg-meta">
      <div class="grid grid-cols-1 gap-x-8 gap-y-5 md:grid-cols-3">
        <div>
          <p class="gg-meta-label">Role</p>
          <p class="gg-meta-value">Spatial UX Designer · Interaction Designer</p>
        </div>
        <div>
          <p class="gg-meta-label">Year</p>
          <p class="gg-meta-value">2024</p>
        </div>
        <div>
          <p class="gg-meta-label">Read more</p>
          <p class="gg-meta-value">
            <a
              href="https://docs.google.com/document/d/1hZfoCJG71Ps13HAgGCSjbk14iZQiXjZI3oLx3add2xM/edit?usp=sharing"
              target="_blank"
              rel="noopener noreferrer"
              class="gg-link"
            >
              Full documentation ↗
            </a>
          </p>
        </div>
      </div>
    </section>

    {/* ───── Cover video ───── */}
    <section class="mt-6 md:mt-8">
      <div class="gg-video">
        <iframe
          src="https://www.youtube.com/embed/pg1b5vzepG8?rel=0&modestbranding=1&iv_load_policy=3&controls=1&showinfo=0&playsinline=1"
          title="Gravity's Grip — VR physics module"
          class="h-full w-full"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
      <p class="gg-caption gg-prose">
        Gravity's Grip — a VR module letting students feel how gravity changes across
        planets.
      </p>
    </section>

    {/* ───── Impact stats — boxed cards (full media-container width) ───── */}
    <section class="gg-block">
      <p class="gg-impact-label">Impact</p>
      <div class="gg-impact-grid">
        {impactStats.map((s) => (
          <div class="gg-impact-card">
            <p class="gg-impact-num">{s.value}</p>
            <p class="gg-impact-caption">{s.caption}</p>
          </div>
        ))}
      </div>
    </section>

    {/* ───── Context (2-column: prose left, question + image right) ───── */}
    <section class="gg-block">
      <div class="gg-context-grid">
        <div class="gg-context-left">
          <h2 class="gg-h2">Context</h2>
          <p class="gg-body gg-body--mt-md">
            Students can memorise physics formulas but often struggle to feel forces like
            gravity and momentum. Learning remains abstract, fragile, and difficult to
            retain.
          </p>
          <p class="gg-body gg-body--mt-sm">
            VR offers the potential to make these forces experiential — but for novice
            users, interaction itself can become a learning barrier. The challenge wasn't
            visualising physics; it was making interaction the explanation.
          </p>
        </div>
        <div class="gg-context-right">
          <p class="gg-question">
            How does a student's understanding of gravity change when the same concept is
            encountered through embodied, action-led interaction rather than passive
            observation?
          </p>
          <div class="gg-context-image" style="background-color: #F5C9B4;">
            [Field research photo — rural school, Assam]
          </div>
          <p class="gg-context-foot">
            Field research with novice VR users in rural Assam shaped the design decisions
            that followed.
          </p>
        </div>
      </div>
    </section>

    {/* ───── Experience flow ───── */}
    <section class="gg-block">
      <div class="gg-prose">
        <h2 class="gg-h2">Experience flow</h2>
        <p class="gg-subhead">A clear, sequential journey to reduce cognitive load.</p>
      </div>
      <div class="gg-flow-grid">
        {flowSteps.map((s, i) => (
          <>
            <div class="gg-flow-step">
              <p class="gg-flow-num">{s.n}</p>
              <p class="gg-flow-name">{s.name}</p>
              <p class="gg-flow-desc">{s.desc}</p>
            </div>
            {i < flowSteps.length - 1 && (
              <div class="gg-flow-arrow" aria-hidden="true">→</div>
            )}
          </>
        ))}
      </div>
    </section>

    {/* ───── Key constraints & decisions ───── */}
    <section class="gg-block">
      <div class="gg-prose gg-hero-grid">
        <div>
          <h2 class="gg-h2">Key constraints &amp; decisions</h2>
          <p class="gg-subhead">Three decisions that shaped Gravity Grip.</p>
        </div>
        <div>
          <p class="gg-constraints-intro">
            The first version leaned on passive observation and visual feedback alone.
            Iteration revealed that engagement had to come from interaction depth — three
            specific decisions reshaped the work.
          </p>
          <ul class="gg-list">
            {constraints.map((c) => (
              <li class="gg-row">
                <span class="gg-num">{c.n}</span>
                <div class="flex-1">
                  <p class="gg-row-name">{c.title}</p>
                  <p class="gg-row-desc">{c.body}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    {/* ───── Interaction logic & system feedback ───── */}
    <section class="gg-block">
      <div class="gg-prose">
        <h2 class="gg-h2">Interaction logic &amp; system feedback</h2>
        <p class="gg-body-md gg-body--mt-md">
          Three responses to user behaviour shaped the interaction model:
        </p>
      </div>
      <div class="gg-showup-grid">
        {showupCols.map((c) => (
          <div class="gg-showup-cell">
            <h3 class="gg-showup-title">{c.title}</h3>
            <p class="gg-showup-body">{c.body}</p>
            <div class="gg-showup-image" style={`background-color: ${c.color};`}>
              {c.caption}
            </div>
          </div>
        ))}
      </div>
    </section>

    {/* ───── Sequential learning model ───── */}
    <section class="gg-block">
      <div class="gg-prose">
        <h2 class="gg-h2">Designing for sequential learning</h2>
        <p class="gg-subhead">
          Each interaction was broken into three phases to support novice users.
        </p>

        <ul class="gg-list gg-list--mt">
          {phases.map((p) => (
            <li class="gg-row">
              <span class="gg-num">{p.n}</span>
              <div class="flex-1">
                <p class="gg-row-name">{p.name}</p>
                <p class="gg-row-desc">{p.body}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ───── Key interactions gallery ───── */}
    <section class="gg-block">
      <div class="gg-prose">
        <h2 class="gg-h2">Key interactions</h2>
        <p class="gg-body-md gg-body--mt-md">
          Three moments from the experience that demonstrate the interaction system in
          action.
        </p>
      </div>
      <div class="gg-gallery-grid">
        {interactions.map((i) => (
          <div class="gg-gallery-cell">
            <div class="gg-gallery-image" style={`background-color: ${i.color};`}></div>
            <p class="gg-gallery-caption">{i.caption}</p>
            <p class="gg-gallery-desc">{i.desc}</p>
          </div>
        ))}
      </div>
    </section>

    {/* ───── What testing showed ───── */}
    <section class="gg-block">
      <div class="gg-prose">
        <h2 class="gg-h2">What testing showed</h2>
        <p class="gg-body-md gg-body--mt-md">
          Field testing across Indian schools surfaced three patterns:
        </p>

        <ul class="gg-findings-list gg-list--mt">
          {findings.map((f) => (
            <li>
              <span class="gg-num">{f.n}</span>
              <p class="gg-row-finding">{f.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ───── Closing ───── */}
    <section class="gg-closing">
      <p class="gg-caption gg-prose">
        Full research and development documentation:{' '}
        <a
          href="https://docs.google.com/document/d/1hZfoCJG71Ps13HAgGCSjbk14iZQiXjZI3oLx3add2xM/edit?usp=sharing"
          target="_blank"
          rel="noopener noreferrer"
          class="gg-link"
        >
          Gravity Grip ↗
        </a>
      </p>
      <p class="gg-prose gg-back">
        <a href="/" class="gg-link">← Back to all work</a>
      </p>
    </section>
  </article>

  <Footer />
</Layout>

<style>
  /*
   * ─────────────────────────────────────────────────────────────────
   * UNIFIED TYPE SCALE — every text element on this page maps to a tier.
   *
   *  Hero h1            48 / 36   weight 700    line 1.1
   *  Section h2         28 / 22   weight 700    line 1.2
   *  Card heading       17 / 15   weight 600    line 1.3
   *
   *  Body large         18 / 16   weight 400    line 1.65    text
   *  Body regular       16 / 15   weight 400    line 1.6     text
   *  Body small         14 / 13   weight 400    line 1.5     muted
   *
   *  Section subtitle   16 / 15   weight 400    line 1.5     muted
   *  Hero subtitle      16 / 14   weight 400                  muted
   *  Hero eyebrow       12        weight 500    uppercase     muted
   *  Pull label (cap)   12        weight 700    uppercase     accent
   *  Impact label       22 / 18   weight 700    uppercase     accent
   *  Impact number      48 / 36   weight 700    line 0.95     accent
   *  Numbered label     18 / 16   weight 700    line 1        accent
   * ─────────────────────────────────────────────────────────────────
   */

  /* ───── Width helpers ───── */
  .gg-prose {
    max-width: 960px;
    margin: 0;
  }

  /* ───── Inter for all headings (override the global Fraunces default) ───── */
  .gg h1,
  .gg h2,
  .gg h3 {
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    letter-spacing: -0.01em;
  }

  /* ───── Hero ───── */
  .gg-eyebrow {
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #6B6354;
  }

  .gg-h1 {
    font-size: 36px;
    font-weight: 700;
    color: #2C2620;
    line-height: 1.1;
    margin-top: 24px;
  }
  @media (min-width: 768px) {
    .gg-h1 {
      font-size: 48px;
      white-space: nowrap;
    }
  }

  .gg-subtitle {
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #6B6354;
    margin-top: 12px;
  }
  @media (min-width: 768px) {
    .gg-subtitle {
      font-size: 16px;
    }
  }

  /* ───── Section heading h2 ───── */
  .gg-h2 {
    font-size: 22px;
    font-weight: 700;
    color: #2C2620;
    line-height: 1.2;
  }
  @media (min-width: 768px) {
    .gg-h2 {
      font-size: 28px;
    }
  }

  /* ───── Section subtitle (small line under section heading) ───── */
  .gg-subhead {
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    font-size: 15px;
    font-weight: 400;
    color: #6B6354;
    line-height: 1.5;
    margin-top: 8px;
  }
  @media (min-width: 768px) {
    .gg-subhead {
      font-size: 16px;
    }
  }

  /* ───── Body large — hero description, Context paragraphs, section intros ───── */
  .gg-body {
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    font-size: 16px;
    font-weight: 400;
    color: #2C2620;
    line-height: 1.65;
  }
  @media (min-width: 768px) {
    .gg-body {
      font-size: 18px;
    }
  }

  /* ───── Body regular — column intros, decision/finding bodies ───── */
  .gg-body-md {
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    font-size: 15px;
    font-weight: 400;
    color: #2C2620;
    line-height: 1.6;
  }
  @media (min-width: 768px) {
    .gg-body-md {
      font-size: 16px;
    }
  }

  /* Margin utilities — apply on top of any body class. */
  .gg-body--mt-md { margin-top: 24px; }
  .gg-body--mt-sm { margin-top: 16px; }

  /* Inline question — top of Context's right column, sized as body-large in accent. */
  .gg-question {
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    font-size: 16px;
    font-weight: 400;
    color: #4105DB;
    line-height: 1.65;
    margin: 0;
  }
  @media (min-width: 768px) {
    .gg-question {
      font-size: 18px;
    }
  }

  /* ───── Body small — captions, secondary descriptions ───── */
  .gg-caption {
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: #6B6354;
    line-height: 1.5;
    margin-top: 12px;
    max-width: 720px;
  }
  @media (min-width: 768px) {
    .gg-caption {
      font-size: 14px;
    }
  }

  /* ───── Metadata strip ───── */
  .gg-meta {
    margin-top: 32px;
    padding: 20px 0;
    border-top: 0.5px solid #E8E4E0;
    border-bottom: 0.5px solid #E8E4E0;
  }
  .gg-meta-label {
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #4105DB;
  }
  .gg-meta-value {
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    font-size: 15px;
    color: #2C2620;
    line-height: 1.6;
    margin-top: 6px;
  }
  @media (min-width: 768px) {
    .gg-meta-value {
      font-size: 16px;
    }
  }

  /* ───── Links ───── */
  .gg-link {
    color: #4105DB;
    transition: color 200ms ease;
  }
  .gg-link:hover {
    color: #5B2EE8;
  }

  /* ───── Section block spacing — 48px mobile / 64px desktop ───── */
  .gg-block {
    margin-top: 48px;
  }
  @media (min-width: 768px) {
    .gg-block {
      margin-top: 64px;
    }
  }

  /* ───── Cover video ───── */
  .gg-video {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 8px;
    background: #000;
  }

  /* ───── Context — 2-column 50/50 (prose left, question + image right) ───── */
  .gg-context-grid {
    max-width: 1280px;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    align-items: start;
  }
  @media (min-width: 768px) {
    .gg-context-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 48px;
    }
    /* Push the right column down so the question's top edge lines up with the
       first body paragraph on the left, not the heading.
       Calc: h2 rendered (~28×1.2 ≈ 34px) + body paragraph margin-top (24px) ≈ 58px. */
    .gg-context-right {
      padding-top: 58px;
    }
  }
  .gg-context-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    font-size: 13px;
    color: rgba(44, 38, 32, 0.6);
    margin-top: 24px;
  }
  @media (min-width: 768px) {
    .gg-context-image {
      font-size: 14px;
    }
  }
  .gg-context-foot {
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    font-size: 13px;
    color: #6B6354;
    line-height: 1.5;
    margin-top: 12px;
  }
  @media (min-width: 768px) {
    .gg-context-foot {
      font-size: 14px;
    }
  }

  /* ───── Hero 2-column grid (40/60 split) ───── */
  .gg-hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }
  @media (min-width: 768px) {
    .gg-hero-grid {
      grid-template-columns: 2fr 3fr;
      gap: 48px;
      align-items: start;
    }
    /* Push hero description down so its top edge sits at the heading's top edge.
       Calc: eyebrow (~19.2px) + .gg-h1 margin-top (24px) ≈ 43px. */
    .gg-hero-right {
      padding-top: 43px;
    }
  }

  /* ───── Impact stats — thin accent rule above each metric ───── */
  .gg-impact-label {
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    font-size: 18px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #4105DB;
    margin: 0 0 28px;
  }
  @media (min-width: 768px) {
    .gg-impact-label {
      font-size: 22px;
    }
  }
  .gg-impact-grid {
    margin-top: 32px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    align-items: stretch;
  }
  @media (min-width: 768px) {
    .gg-impact-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
    }
  }
  .gg-impact-card {
    border-top: 2px solid #4105DB;
    padding-top: 20px;
  }
  .gg-impact-num {
    font-size: 48px;
    font-weight: 700;
    color: #4105DB;
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
    font-style: normal;
  }

  @media (max-width: 767px) {
    .gg-impact-num {
      font-size: 36px;
    }
  }
  .gg-impact-caption {
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    font-size: 12px;
    font-weight: 400;
    color: #2C2620;
    line-height: 1.5;
    margin: 0;
  }
  @media (min-width: 768px) {
    .gg-impact-caption {
      font-size: 13px;
    }
  }

  /* Intro paragraph above the constraints list — body-large in the right column. */
  .gg-constraints-intro {
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    font-size: 16px;
    font-weight: 400;
    color: #2C2620;
    line-height: 1.65;
    max-width: 600px;
    margin: 0 0 16px;
  }
  @media (min-width: 768px) {
    .gg-constraints-intro {
      font-size: 18px;
    }
  }

  /* ───── Numbered list (constraints + phases + findings) ───── */
  .gg-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
