---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/case-study.css';

/* Images live in public/images/sdds-images/. width/height are the files' real
   pixel sizes, so the browser reserves the right space before they lazy-load. */
const img = (file: string) => `/images/sdds-images/${file}`;

const hero = {
  src: img('sdds-hero.jpg'),
  w: 1781,
  h: 1927,
  alt: 'Three mobile screens from the final design: an optional update step, a "Shared with SDDS" receipt showing the donation\'s journey, and the trading reflection with charts of asset allocation, trading rhythm and outcomes.',
};

const glance = [
  { n: '11', label: 'interviews with young UK crypto investors' },
  { n: '8', label: 'think-aloud test sessions, in 4 rounds' },
  { n: '5', label: 'prototype versions' },
  { n: '22', label: 'measures computed on the phone; nothing raw leaves it' },
  { n: '4', label: 'recommendations to SDDS' },
];

const questions = [
  'Could giving investors insight about themselves motivate them to donate?',
  'What do they want to understand about their own investing, and what drives or blocks donating?',
  'Which of that information is also valuable for researchers?',
];

const processCards = [
  { n: '01', title: 'Scope', body: 'literature review to map the gap.' },
  {
    n: '02',
    title: 'Listen',
    body: '11 semi-structured interviews with UK investors aged 18–35 who trade at least monthly, recruited through Reddit, Telegram and snowballing (8–17 July 2026).',
  },
  {
    n: '03',
    title: 'Make sense',
    body: "affinity mapping to keep participants' own words, then COM-B to diagnose why donation doesn't happen.",
  },
  {
    n: '04',
    title: 'Design & test',
    body: 'a mobile prototype tested with think-aloud under RITE (fix after every round), 8 sessions in 4 rounds (7–17 August 2026), plus a stakeholder session with SDDS.',
  },
];

const deficits = {
  src: img('sdds-three-deficits.jpg'),
  w: 2400,
  h: 993,
  alt: 'Affinity map of interview quotes as sticky notes, grouped under Capability, Opportunity and Motivation.',
};

const gaps = [
  { name: 'Capability', body: "they grasp the idea of donating, but can't picture what they'd actually be giving." },
  {
    name: 'Opportunity',
    body: 'the clearest gap. No medium means no record, and no record means nothing to donate, however willing they are.',
  },
  {
    name: 'Motivation',
    body: 'they were willing in principle, but on conditions. Above all, they wanted something back: an objective view of their own habits.',
  },
];

const overlap = {
  src: img('sdds-overlap.jpg'),
  w: 2400,
  h: 1591,
  alt: 'Venn diagram. What the exchange export releases (customer information, access logs, exact balances, addresses, order records) overlaps only slightly with what investors will donate (how often they trade, how long they hold, when they trade, asset types, whether trades worked as proportions). The overlap is labelled "derived measures".',
};

const principles = [
  {
    n: '01',
    name: 'The donation is derived, and the derivation is local.',
    body: 'Identity is removed on the device; only the derived measures can leave.',
  },
  {
    n: '02',
    name: 'The reflection completes the exchange.',
    body: 'The mirror of their trading is the return they asked for, not a bonus.',
  },
  {
    n: '03',
    name: 'Consent is granular and reversible.',
    body: 'Choose measure by measure, change your mind later, withdraw any time.',
  },
];

const iterations = [
  {
    title: 'Iteration 1: Purpose blindness',
    image: {
      src: img('sdds-iteration-1.jpg'),
      w: 2400,
      h: 648,
      alt: 'Version 1 screens next to version 3 screens, showing the flow reordered so the donation decision comes before the reflection.',
    },
    parts: [
      { label: 'Before', body: 'see your reflection first, then choose what to donate.' },
      {
        label: 'What happened',
        body: 'participants saw a reflection tool with a donation tacked on "like a cookie policy". Once they\'d read their reflection, they clicked through the donation with no attention to it.',
      },
      {
        label: 'After',
        body: 'the purpose is stated up front, data types are explained, the decision comes next, and the reflection arrives after the donation as its return.',
      },
    ],
  },
  {
    title: 'Iteration 3: Making consent legible',
    image: {
      src: img('sdds-iteration-3.jpg'),
      w: 2400,
      h: 884,
      alt: 'Version 2 consent screens next to version 4, which adds a "Where does it go?" block naming SDDS and per-measure toggles with a breakdown of what each category contains.',
    },
    parts: [
      {
        label: 'Before',
        body: "labels didn't say what they held, people assumed their selection went straight to SDDS, and they were never asked about updates.",
      },
      {
        label: 'What testers asked',
        body: '"choose what research receives? What does that mean? Is SDDS the one who\'s researching? Why should I share this?"',
      },
      {
        label: 'After',
        body: "a clear block naming who holds the data, a breakdown inside every category with per-measure toggles, and an opt-in to follow the data's journey.",
      },
    ],
  },
  {
    title: 'Iteration 5: Updates without giving up anonymity',
    image: {
      src: img('sdds-iteration-5.jpg'),
      w: 2400,
      h: 1133,
      alt: 'Version 4 email opt-in screens next to version 5, which replaces the email with a collective "Your donation travels in a package" update and an optional donor community survey.',
    },
    parts: [
      {
        label: 'The conflict',
        body: 'updates were a condition for 6 of 11 participants, but signing up needed an email. "Without entering the email address how do I sign up? If I do put my email, they\'ll recognise me and the data I shared."',
      },
      {
        label: 'The fix',
        body: "in the stakeholder session, SDDS proposed collective updates to the whole donor community, so there's no per-donor link but people are still told what happens.",
      },
      {
        label: 'Why it matters',
        body: 'the six conditions can conflict, and resolving it needed the recipient to change alongside the interface.',
      },
    ],
  },
];

const flow = [
  {
    name: 'Entry',
    body: 'says what you give, what you get and who receives it, and lists "what data we get" before any upload.',
  },
  {
    name: 'Export & local derivation',
    body: 'identity removed on the device; 22 measures computed locally, nothing leaves.',
  },
  {
    name: 'Donation decision',
    body: 'four category cards, per-measure toggles, a live preview of the package, the recipient named, a journey timeline including withdrawal, and a preview of the reflection.',
  },
  {
    name: 'Confirmation & receipt',
    body: 'the action names the donation; the receipt lists exactly what left.',
  },
  {
    name: 'Reflection',
    body: 'an overview card, then one card per category: trading rhythm, trades and timing, outcomes, allocation.',
  },
  {
    name: 'Revisit',
    body: 'change your choices any time; withdrawing deletes the data, but the reflection stays.',
  },
  {
    name: 'Updates',
    body: 'collective, to the whole donor community; no per-donor contact held.',
  },
];

const results = [
  {
    measure: 'Task completion',
    result: '8 of 8',
    drove: 'Every version was completed end to end, but in v1–v2 nobody paid attention to the donation',
  },
  {
    measure: 'Understanding the purpose',
    result: '8 of 8',
    drove: 'Understood late in v1–v2; at entry from v3 onwards',
  },
  {
    measure: 'Control and trust',
    result: '7 of 8',
    drove: 'Recipient clarity was the round 2 issue; control was stated present by rounds 3–4',
  },
  {
    measure: 'Reflection valued as the return',
    result: '3 of 8',
    drove: 'Recognised as the incentive once delivered',
  },
];

const recommendations = [
  {
    name: 'Decision before reflection',
    body: 'ask first, preview the return, keep it revisable. SDDS gets donations people know they made.',
  },
  {
    name: 'Measure-level consent',
    body: 'a toggle per measure, stored with the donation. SDDS gets a consent record per package.',
  },
  {
    name: 'Collective updates, no contact held',
    body: 'report progress to the whole donor community. Anonymity becomes a property of what SDDS stores.',
  },
  {
    name: 'The package as a research offer',
    body: 'SDDS receives the derived package, not the raw export, a new donated data type confirmed by SDDS as fitting its financial data types.',
  },
];

const limits = [
  "Every test session used a synthetic persona, so hesitation over losses was over someone else's losses. The next step is testing with investors' own exports.",
  "I recorded what people chose and said, not whether they could later recall what they'd chosen, so informed consent itself isn't yet tested.",
  "Order History columns were specified from Binance's documentation, not yet read from a traded account.",
];

const pad = (i: number) => String(i + 1).padStart(2, '0');
---

<Layout
  title="Crypto Mirror · Payal Chand"
  description="UK research needs real data on how young people invest in crypto, but these investors don't donate data for the public good. I designed a mobile tool that gives them a mirror of their own trading in return."
>
  <Nav />

  {/* Uses the shared case-study system (class "evam"); "sdds" adds the few
      patterns EVAM doesn't have: stat row, zoomable images, iteration blocks, table. */}
  <article class="evam sdds">
    {/* ───── Hero ───── */}
    <section class="pt-12 pb-2 md:pt-16">
      <div class="evam-prose evam-hero-grid">
        <div class="evam-hero-left">
          <p class="evam-eyebrow">N°01 · Case Study</p>
          <h1 class="evam-h1">Crypto Mirror</h1>
          <p class="evam-subtitle">Data donation for UK research · 2026</p>
        </div>
        <div class="evam-hero-right">
          <p class="evam-body">
            UK research needs real data on how young people invest in crypto, but these
            investors don't donate data for the public good. I designed a mobile tool that
            gives them a mirror of their own trading in return, and found that it only works
            if they decide to donate <em>before</em> they see it.
          </p>
        </div>
      </div>
    </section>

    {/* ───── Metadata strip ───── */}
    <section class="evam-meta">
      <div class="grid grid-cols-1 gap-x-8 gap-y-5 md:grid-cols-2 lg:grid-cols-4">
        <div>
          <p class="evam-meta-label">Role</p>
          <p class="evam-meta-value">
            Lead researcher &amp; designer (solo): research, mobile UI, testing, client
            recommendations
          </p>
        </div>
        <div>
          <p class="evam-meta-label">Partner</p>
          <p class="evam-meta-value">
            Smart Data Donation Service (SDDS), University of York × Imperial College London
          </p>
        </div>
        <div>
          <p class="evam-meta-label">Duration</p>
          <p class="evam-meta-value">Jun – Sep 2026 · MSc Design with Behaviour Science</p>
        </div>
        <div>
          <p class="evam-meta-label">Supervised by</p>
          <p class="evam-meta-value">Prof Sebastian Deterding</p>
        </div>
      </div>
    </section>

    {/* ───── Hero image ───── */}
    <section class="mt-6 md:mt-8">
      <a
        href={hero.src}
        target="_blank"
        rel="noopener"
        class="sdds-zoom sdds-hero-frame"
        aria-label="Open full-size image in a new tab"
      >
        <img
          src={hero.src}
          alt={hero.alt}
          width={hero.w}
          height={hero.h}
          class="sdds-hero-img"
          loading="lazy"
          decoding="async"
        />
      </a>
    </section>

    {/* ───── At a glance ───── */}
    <section class="sdds-glance" aria-label="At a glance">
      <dl class="sdds-glance-grid">
        {glance.map((g) => (
          <div class="sdds-stat">
            <dt class="sdds-stat-label">{g.label}</dt>
            <dd class="sdds-stat-num">{g.n}</dd>
          </div>
        ))}
      </dl>
    </section>

    {/* ───── Pull quote ───── */}
    <section class="evam-quote-section">
      <blockquote class="evam-quote evam-prose">"The order is the mechanism."</blockquote>
    </section>

    {/* ───── Context ───── */}
    <section class="evam-block">
      <div class="evam-prose">
        <h2 class="evam-h2">Context</h2>
        <p class="evam-body evam-body--mt-md">
          SDDS is the UK's first national research infrastructure built on people's right to
          a machine-readable copy of their own data. It helps people obtain, understand and
          donate their digital trace data for research. Its central challenge is keeping
          donations coming without relying on costly paid panels, especially from valuable
          populations researchers can't yet reach.
        </p>
        <p class="evam-body evam-body--mt-sm">
          Young retail crypto investors are one of those populations. UK adult crypto
          ownership went from 4% in 2021 to a peak of 12% in 2024, much of it young,
          first-time investors who follow community signals more than analysis.
        </p>
        <p class="evam-body evam-body--mt-sm">
          The first idea was gambling data. I steered away from it: it meant seeking out
          people at risk of harm. Crypto investors were just as rich to study, without
          targeting anyone for harm, and relevant to finance researchers. That scoping call
          was the project's first ethical decision, made before any screen existed.
        </p>
      </div>
    </section>

    {/* ───── The gap ───── */}
    <section class="evam-block">
      <div class="evam-prose">
        <h2 class="evam-h2">The gap</h2>
        <p class="evam-body evam-body--mt-md">
          Research on data donation finds people donate out of prosocial motivation, trust
          in the institution and belief in the collective good. Crypto investing is private,
          self-directed and focused on personal gain, so those drivers don't apply, and
          often become barriers. No published study had looked at data donation among crypto
          investors.
        </p>
        <p class="evam-body evam-body--mt-sm">So I asked:</p>
        <ol class="evam-list sdds-list--mt-sm">
          {questions.map((q, i) => (
            <li class="evam-row">
              <span class="evam-num evam-num--finding">{pad(i)}</span>
              <p class="evam-row-finding">{q}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* ───── Process ───── */}
    <section class="evam-block">
      <div class="evam-prose">
        <h2 class="evam-h2">Process</h2>
        <p class="evam-body evam-body--mt-md">
          An asymmetric double diamond: the problem space was unexplored, so the research
          phase was deliberately heavier.
        </p>
      </div>
      <div class="evam-process-grid">
        {processCards.map((c) => (
          <div class="evam-process-card">
            <p class="evam-process-num">{c.n}</p>
            <h3 class="evam-process-card-title">{c.title}</h3>
            <p class="evam-process-card-body sdds-cap">{c.body}</p>
          </div>
        ))}
      </div>
    </section>

    {/* ───── What I found ───── */}
    <section class="evam-block">
      <div class="evam-prose">
        <h2 class="evam-h2">What I found</h2>
        <h3 class="sdds-h3 sdds-h3--mt">Why donation doesn't happen: three gaps</h3>
      </div>
      <a
        href={deficits.src}
        target="_blank"
        rel="noopener"
        class="sdds-zoom sdds-figure"
        aria-label="Open full-size image in a new tab"
      >
        <img
          src={deficits.src}
          alt={deficits.alt}
          width={deficits.w}
          height={deficits.h}
          class="sdds-image"
          loading="lazy"
          decoding="async"
        />
      </a>
      <div class="evam-prose">
        <ul class="evam-list evam-list--mt">
          {gaps.map((g) => (
            <li class="evam-row">
              <p class="evam-row-finding"><strong class="sdds-strong">{g.name}:</strong> {g.body}</p>
            </li>
          ))}
        </ul>
        <blockquote class="evam-quote sdds-quote--inline">
          "If I receive useful insights about my own trading in return, it feels like a fair
          exchange rather than just giving away my data for free."
        </blockquote>
        <p class="evam-body evam-body--mt-md">
          Willingness was never unconditional. Across all 11 interviews the same six
          conditions kept coming back, including anonymity, the right to withdraw, no
          resale, knowing exactly what's collected, and being told what happens next. The
          interface had to visibly meet each one.
        </p>

        <h3 class="sdds-h3 sdds-h3--mt-lg">The data that exists isn't the data they'll give</h3>
      </div>
      <a
        href={overlap.src}
        target="_blank"
        rel="noopener"
        class="sdds-zoom sdds-figure sdds-figure--narrow"
        aria-label="Open full-size image in a new tab"
      >
        <img
          src={overlap.src}
          alt={overlap.alt}
          width={overlap.w}
          height={overlap.h}
          class="sdds-image"
          loading="lazy"
          decoding="async"
        />
      </a>
      <div class="evam-prose">
        <p class="evam-body evam-body--mt-md">
          I opened a real Binance account and requested its full data export to see what's
          actually available. The data that exists, like exact balances and addresses, is
          what investors refuse. The data they'd happily give, like their trading rhythm,
          doesn't exist as a field.
        </p>
        <p class="evam-body evam-body--mt-sm">
          That located the design: a layer between the export and the researcher that turns
          one into the other. It computes 22 identity-free measures on the phone, in a form
          investors accept.
        </p>
      </div>
    </section>

    {/* ───── How I thought about the work ───── */}
    <section class="evam-block">
      <div class="evam-prose evam-hero-grid">
        <div>
          <h2 class="evam-h2">How I thought about the work</h2>
          <p class="evam-subhead">
            Three principles, each traced back to what participants said:
          </p>
        </div>
        <div>
          <ul class="evam-list">
            {principles.map((p) => (
              <li class="evam-row">
                <span class="evam-num evam-num--principle">{p.n}</span>
                <div class="flex-1">
                  <p class="evam-row-name">{p.name}</p>
                  <p class="evam-row-desc">{p.body}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    {/* ───── Testing: what changed and why ───── */}
    <section class="evam-block">
      <div class="evam-prose">
        <h2 class="evam-h2">Testing: what changed and why</h2>
      </div>

      {iterations.map((it) => (
        <div class="sdds-iteration">
          <h3 class="sdds-h3">{it.title}</h3>
          <a
            href={it.image.src}
            target="_blank"
            rel="noopener"
            class="sdds-zoom sdds-figure sdds-figure--tight"
            aria-label="Open full-size image in a new tab"
          >
            <img
              src={it.image.src}
              alt={it.image.alt}
              width={it.image.w}
              height={it.image.h}
              class="sdds-image"
              loading="lazy"
              decoding="async"
            />
          </a>
          <div class="sdds-parts">
            {it.parts.map((part) => (
              <div class="sdds-part">
                <p class="evam-meta-label">{part.label}</p>
                <p class="sdds-part-body sdds-cap">{part.body}</p>
              </div>
            ))}
          </div>
        </div>
      ))}

      <div class="evam-prose sdds-iteration">
        <h3 class="sdds-h3">The hardest call</h3>
        <p class="evam-body evam-body--mt-sm">
          Reversing my own founding principle after round 2. "Consent by seeing" was the
          starting idea, and two rounds showed it produced donations nobody paid attention
          to. Moving the decision first fixed that and made the reflection the price. I kept
          the risk small with a literal preview of the reflection and a decision you can
          revise afterwards.
        </p>
      </div>
    </section>

    {/* ───── The final design ───── */}
    <section class="evam-block">
      <div class="evam-prose">
        <h2 class="evam-h2">The final design</h2>
        <p class="evam-body evam-body--mt-md">The flow, in 7 steps:</p>
        <ol class="evam-list sdds-list--mt-sm">
          {flow.map((f, i) => (
            <li class="evam-row">
              <span class="evam-num evam-num--finding">{pad(i)}</span>
              <p class="evam-row-finding"><strong class="sdds-strong">{f.name}:</strong> {f.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* ───── What testing showed ───── */}
    <section class="evam-block">
      <div class="evam-prose">
        <h2 class="evam-h2">What testing showed (8 sessions)</h2>
        <table class="sdds-table">
          <thead>
            <tr>
              <th scope="col">Measure</th>
              <th scope="col">Result</th>
              <th scope="col">What it drove</th>
            </tr>
          </thead>
          <tbody>
            {results.map((r) => (
              <tr>
                <th scope="row" data-label="Measure">{r.measure}</th>
                <td data-label="Result" class="sdds-table-result">{r.result}</td>
                <td data-label="What it drove">{r.drove}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="evam-body evam-body--mt-md">
          The headline: yes, reflection can motivate donation, but conditionally. Delivered
          after the ask, people recognised it as the incentive ("very visual insight").
          Delivered before, the exchange felt complete and nothing was owed. The order is the
          mechanism.
        </p>
      </div>
    </section>

    {/* ───── Recommendations to SDDS ───── */}
    <section class="evam-block">
      <div class="evam-prose">
        <h2 class="evam-h2">Recommendations to SDDS</h2>
        <ol class="evam-list evam-list--mt">
          {recommendations.map((r, i) => (
            <li class="evam-row">
              <span class="evam-num evam-num--finding">{pad(i)}</span>
              <p class="evam-row-finding"><strong class="sdds-strong">{r.name}:</strong> {r.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* ───── Honest limits ───── */}
    <section class="evam-block">
      <div class="evam-prose">
        <h2 class="evam-h2">Honest limits</h2>
        <ul class="evam-list evam-list--mt">
          {limits.map((l) => (
            <li class="evam-row">
              <p class="evam-row-finding">{l}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ───── What I'm taking forward ───── */}
    <section class="evam-block">
      <div class="evam-prose">
        <h2 class="evam-h2">What I'm taking forward</h2>
        <p class="evam-body evam-body--mt-md">
          My first project leading research end to end. It changed how I work: I now specify
          the behaviour, what influences it and how a design should change it, and only then
          the screens.
        </p>
        <p class="evam-body evam-body--mt-sm">
          It also points to where I'm going next. The core of this design, a layer that holds
          broad access on someone's behalf while they narrow what leaves, is the core problem
          of agentic design: a system acts for a person, and the person must still see, bound
          and reverse what it does.
        </p>
      </div>
    </section>

    {/* ───── Closing ───── */}
    <section class="evam-closing">
      <p class="evam-prose evam-back sdds-back">
        <a href="/" class="evam-link">← Back to the desk</a>
      </p>
    </section>
  </article>

  <Footer />
</Layout>

<style>
  /* Only what the shared case-study system doesn't already provide. */

  /* ───── Sub-headings inside a section — same look as EVAM's column titles ───── */
  .sdds-h3 {
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: #4105DB;
    line-height: 1.3;
    letter-spacing: 0;
    margin: 0;
  }
  .sdds-h3--mt {
    margin-top: 24px;
  }
  .sdds-h3--mt-lg {
    margin-top: 56px;
  }

  .sdds-strong {
    font-weight: 600;
  }
  .sdds-list--mt-sm {
    margin-top: 8px;
  }
  /* Content keeps its original lower-case run-on wording; when a phrase is
     shown on its own line under a label, capitalise its first letter. */
  .sdds-cap::first-letter {
    text-transform: uppercase;
  }

