<script>
  // Hero stage: a screen opens that step in the walkthrough in "The final design"
  function initStage() {
    document.querySelectorAll<HTMLButtonElement>('[data-stage-step]:not([data-ready])').forEach((b) => {
      b.dataset.ready = '1';
      b.addEventListener('click', () => {
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        document.getElementById('final-design')?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
        document.dispatchEvent(new CustomEvent('fw:jump', { detail: { id: 'final-walkthrough', index: Number(b.dataset.stageStep) } }));
      });
    });
  }
  initStage();
  document.addEventListener('astro:page-load', initStage);
</script>
