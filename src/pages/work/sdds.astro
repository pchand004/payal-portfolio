---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/case-study.css';
import FlowWalkthrough from '../../components/FlowWalkthrough.astro';
import FlowSteps from '../../components/FlowSteps.astro';

/* Images live in public/images/sdds-images/. width/height are the files' real
   pixel sizes, so the browser reserves the right space before they lazy-load. */
const img = (file: string) => `/images/sdds-images/${file}`;

const glanceLine = '11 interviews · 8 think-aloud sessions in 4 rounds · 5 prototype versions · 22 measures computed on the phone · 4 recommendations to SDDS';

const deficits = {
  src: img('sdds-three-deficits.jpg'),
  w: 2400,
  h: 993,
  alt: 'Affinity map of interview quotes as sticky notes, grouped under Capability, Opportunity and Motivation.',
};

const gaps = [
  { name: 'Capability', body: "they grasp the idea of donating, but can't picture what they'd be giving." },
  {
    name: 'Opportunity',
    body: 'the clearest gap. No medium means no record, and no record means nothing to donate, however willing they are.',
  },
  {
    name: 'Motivation',
    body: 'willing in principle, but on terms. Willingness ran on exchange, not contribution: no participant named research as a reason to donate.',
  },
];

const conditions = [
  { name: 'Control, including withdrawal', raised: '8 of 11', met: 'A toggle per measure; withdraw any time, which deletes the data' },
  { name: 'Limits on use', raised: '8 of 11', met: '"Research only, never marketing, never resold", repeated on the receipt' },
  { name: 'Security and anonymity', raised: '8 of 11', met: 'Identity removed on the device; no per-donor contact held' },
  { name: 'Transparency', raised: '7 of 11', met: 'Recipient named before any choice; receipt lists exactly what left' },
  { name: 'Updates', raised: '6 of 11', met: 'Journey timeline, plus collective updates to the whole donor community' },
  { name: 'Something returned', raised: '4 of 11', met: 'The reflection, delivered as the return for donating' },
];

const overlap = {
  src: img('sdds-overlap.jpg'),
  w: 2400,
  h: 1591,
  alt: 'Venn diagram. What the exchange export releases (customer information, access logs, exact balances, addresses, order records) overlaps only slightly with what investors will donate (how often they trade, how long they hold, when they trade, asset types, whether trades worked as proportions). The overlap is labelled "derived measures".',
};

const principles = [
  {
    n: '01',
    name: 'The donation is derived, and the derivation is local.',
    body: 'Identity is removed on the device; only derived measures can leave.',
  },
  {
    n: '02',
    name: 'The reflection completes the exchange.',
    body: "It's the return they asked for, not a bonus.",
  },
  {
    n: '03',
    name: 'Consent is granular and reversible.',
    body: 'Measure by measure, changeable later.',
  },
  {
    n: '04',
    name: 'Descriptive, never advice.',
    body: 'One participant predicted that seeing his patterns would make him trade more. So the reflection describes and never prompts: no targets, no "you should".',
  },
];

// The final design, as an auto-playing phone walkthrough of the five full-length v5 screens
// (2x exports, 786px wide; WebP with a PNG fallback in /images/sdds-images/flow/).
const flow = (name: string) => `/images/sdds-images/flow/${name}`;
const walkthrough = [
  {
    title: 'Identity removed, on the phone',
    src: flow('01-identity'), w: 786, h: 2066,
    label: 'Personal identity deleted, balances hidden and wallet addresses never read, then the four categories to choose from.',
    bullets: [
      { lead: 'Identity deleted first', rest: ', before anything else happens' },
      { lead: 'Balances hidden, wallet addresses never read' },
      { lead: 'Nothing has left yet:', rest: ' everything happens on this device' },
    ],
  },
  {
    title: 'Decide, measure by measure',
    src: flow('02-decide'), w: 786, h: 3028,
    label: 'Consent screen naming SDDS as the recipient, with each category opening into its measures, each with a toggle.',
    bullets: [
      { lead: 'Recipient named first:', rest: ' "Where does it go?" names SDDS' },
      { lead: 'Consent per measure:', rest: ' each category opens into its own toggles' },
      { lead: 'Real values shown', rest: ", so you see exactly what you'd give" },
    ],
  },
  {
    title: 'Updates, without an email',
    src: flow('03-updates'), w: 786, h: 2352,
    label: 'Updates screen: three promises, then collective updates and an optional donor survey, with no email field.',
    bullets: [
      { lead: 'The terms, restated:', rest: ' held by SDDS, research only, withdraw any time' },
      { lead: 'Collective updates:', rest: ' your donation travels in a package' },
      { lead: 'Optional:', rest: " skipping both doesn't affect the donation" },
    ],
  },
  {
    title: 'A receipt of exactly what left',
    src: flow('04-receipt'), w: 786, h: 2724,
    label: 'Shared with SDDS: a receipt of the donation, its journey so far, and a button to see the reflection.',
    bullets: [
      { lead: "What was sent, who holds it, what it's for" },
      { lead: 'Its journey:', rest: ' sent → received → in analysis' },
      { lead: 'Then the return:', rest: ' "Now, your side of the reflection"' },
    ],
  },
  {
    title: 'The reflection, as the return',
    src: flow('05-reflection'), w: 786, h: 2634,
    label: 'Reflection: six months of trading as an overview card, then one descriptive card per category.',
    bullets: [
      { lead: 'Arrives after the decision' },
      { lead: 'Descriptive only:', rest: ' no advice, no targets' },
      { lead: 'Amounts hidden', rest: '; review or withdraw any time' },
    ],
  },
];

const rounds = [
  {
    title: 'Rounds 1–2: Purpose blindness',
    image: {
      src: img('sdds-r12-purpose.png') + '?v=2',
      w: 1920,
      h: 1520,
      alt: 'Before: the v1 reflection screen shown before any donation. After: the v5 receipt, where the reflection comes after donating.',
    },
    body: 'In v1 the reflection came first and the donation after it. Testers read their reflection, then clicked through the donation without reading it; to them it was tacked on, like a cookie policy. From v3 the purpose is stated at entry, the decision comes first, and the reflection arrives after it as the return.',
  },
  {
    title: 'Round 3: Making consent legible',
    image: {
      src: img('sdds-r3-consent.png') + '?v=2',
      w: 1920,
      h: 1968,
      alt: "Before: v2 category toggles with no explanation. After: v5 'Where does it go?' block naming SDDS.",
    },
    quote: '"Choose what research receives? What does that mean? Is SDDS the one who\'s researching?"',
    body: "In v2, labels didn't say what they held, and people assumed their selection went straight to researchers. v4 fixed both: (1) a 'Where does it go?' block names SDDS before any choice, and (2) every category opens into its measures, each with its own toggle, so consent is given measure by measure.",
  },
  {
    title: 'Round 4: Updates without giving up anonymity',
    image: {
      src: img('sdds-r4-updates.png') + '?v=2',
      w: 1920,
      h: 1520,
      alt: 'Before: v4 email opt-in checkboxes. After: v5 collective updates with no email.',
    },
    quote: '"If I do put my email, they\'ll recognise me and the data I shared."',
    body: 'Updates were a condition for 6 of 11 interviewees, but the opt-in needed an email, which broke anonymity. In the stakeholder session SDDS proposed collective updates to the whole donor community: no per-donor link, and people are still told what happens. Resolving it needed the recipient to change, not just the screen.',
  },
];

const results = [
  {
    measure: 'Task completion',
    result: '8 of 8',
    drove: 'Completed end to end in every version, but in v1–v2 without attention to the donation',
  },
  {
    measure: 'Understanding the purpose',
    result: '8 of 8',
    drove: 'Understood late in v1–v2; at entry from v3',
  },
  {
    measure: 'Control and trust',
    result: '7 of 8',
    drove: 'Recipient clarity was the round 2 issue; control stated present by rounds 3–4',
  },
  {
    measure: 'Reflection valued as the return',
    result: '0/4 → 3/4',
    drove: 'Reflection first (rounds 1–2): the exchange felt complete and nothing was owed. Reflection after the decision (rounds 3–4): recognised as the incentive ("very visual insight")',
  },
];

const recommendations = [
  { name: 'Decision before reflection', body: 'ask first, preview the return, keep it revisable.' },
  { name: 'Measure-level consent', body: 'a toggle per measure, stored with the donation: a consent record per package.' },
  { name: 'Collective updates, no contact held', body: 'anonymity becomes a property of what SDDS stores.' },
  { name: 'The package as a research offer', body: 'SDDS receives the derived package, not the raw export: a new donated data type.' },
];

const limits = [
  "Every test session used a synthetic persona, so hesitation over losses was over someone else's losses. The next step is testing with investors' own exports.",
  "I recorded what people chose and said, not whether they could later recall what they'd chosen, so informed consent itself isn't yet tested.",
  "Order History columns were specified from Binance's documentation, not yet read from a traded account.",
];

const pad = (i: number) => String(i + 1).padStart(2, '0');
---

<Layout
  title="Crypto Mirror × SDDS · Payal Chand"
  description="UK research needs real data on how young people invest in crypto, but these investors don't donate data for the public good. I designed a mobile tool that gives them a mirror of their own trading in return."
>
  <Nav />

  {/* Uses the shared case-study system (class "evam"); "sdds" adds the few
      patterns EVAM doesn't have: stat row, zoomable images, iteration blocks, table. */}
  <article class="evam sdds">
    {/* ───── Hero: the site's case-study hero, then a stage of the five final screens ───── */}
    <section class="pt-12 pb-2 md:pt-16" id="top">
      <div class="evam-prose evam-hero-grid">
        <div class="evam-hero-left">
          <p class="evam-eyebrow">N°01 · Case Study</p>
          <h1 class="evam-h1">Crypto Mirror</h1>
          <p class="evam-subtitle">Data donation for UK research · 2026</p>
        </div>
        <div class="evam-hero-right">
          <p class="evam-body">
            UK research needs real data on how young people invest in crypto, but these investors
            don't donate data for the public good. I designed a mobile tool that gives them a mirror
            of their own trading in return, and found that it only works if they decide to donate
            <em>before</em> they see it.
          </p>
        </div>
      </div>
    </section>

    {/* ───── Metadata strip ───── */}
    <section class="evam-meta">
      <div class="grid grid-cols-1 gap-x-8 gap-y-5 md:grid-cols-2 lg:grid-cols-4">
        <div>
          <p class="evam-meta-label">Role</p>
          <p class="evam-meta-value">
            Product Designer &amp; Researcher (solo): research, mobile UI, testing, client
            recommendations
          </p>
        </div>
        <div>
          <p class="evam-meta-label">Partner</p>
          <p class="evam-meta-value">
            <a
              href="https://www.sdruk.ukri.org/data/financial-data-service/"
              target="_blank"
              rel="noopener noreferrer"
              class="evam-link"
            >Smart Data Donation Service (SDDS) ↗</a>, University of York × Imperial College London
          </p>
        </div>
        <div>
          <p class="evam-meta-label">Duration</p>
          <p class="evam-meta-value">May – Sep 2026 · MSc Design with Behaviour Science</p>
        </div>
        <div>
          <p class="evam-meta-label">Supervised by</p>
          <p class="evam-meta-value">Prof Sebastian Deterding</p>
        </div>
      </div>
    </section>

    {/* ───── Stage: the five final screens, in order. Each opens that step in the walkthrough. ───── */}
    <section class="sdds-stage" aria-label="The final design, five screens in order">
      <ol class="sdds-stage-row">
        {walkthrough.map((w, i) => (
          <li class="sdds-stage-item" style={`--i:${i}`}>
            <button type="button" class="sdds-stage-btn" data-stage-step={i} aria-label={`Step ${i + 1}: ${w.title}. Play this step in the walkthrough below.`}>
              <span class="sdds-stage-phone">
                <picture>
                  <source srcset={w.src.replace(/flow\/(.*)$/, 'flow/thumb-$1') + '.webp'} type="image/webp" />
                  <img
                    src={w.src.replace(/flow\/(.*)$/, 'flow/thumb-$1') + '.png'}
                    alt=""
                    width="380"
                    height="696"
                    loading={i < 3 ? 'eager' : 'lazy'}
                    fetchpriority={i === 0 ? 'high' : undefined}
                    decoding="async"
                  />
                </picture>
              </span>
              <span class="sdds-stage-label"><span class="sdds-stage-n">{String(i + 1).padStart(2, '0')}</span> {w.title}</span>
            </button>
          </li>
        ))}
      </ol>
    </section>

    {/* ───── At a glance ───── */}
    <section class="evam-block sdds-glance-block" aria-labelledby="glance-heading">
      <div class="evam-prose">
        <h2 class="evam-h2" id="glance-heading">At a glance</h2>
        <p class="sdds-glance-line">{glanceLine}</p>
        <p class="evam-body evam-body--mt-md">
          <strong class="sdds-strong">What I found:</strong> reflection motivated donation only when it
          came after the decision. When it came first (rounds 1–2), no tester treated it as a return for
          donating. Once it came after (rounds 3–4), 3 of 4 did. I call this <em>the order is the
          mechanism</em>.
        </p>
        <p class="evam-body evam-body--mt-sm">
          <strong class="sdds-strong">What it led to:</strong> SDDS confirmed the derived package fits its
          financial data types, and proposed the collective-updates model now in the final design.
        </p>
      </div>
    </section>

    {/* ───── Context ───── */}
    <section class="evam-block">
      <div class="evam-prose">
        <h2 class="evam-h2">Context</h2>
        <p class="evam-body evam-body--mt-md">
          SDDS is the UK's first national research infrastructure built on people's right to a
          machine-readable copy of their own data. It helps people obtain, understand and donate their
          digital trace data for research, and needs donations to keep coming without relying on costly
          paid panels.
        </p>
        <p class="evam-body evam-body--mt-sm">
          Young retail crypto investors are a population researchers can't yet reach. UK adult crypto
          ownership rose from 4% in 2021 to a peak of 12% in 2024, much of it young, first-time investors
          who follow community signals more than analysis.
        </p>
        <p class="evam-body evam-body--mt-sm">
          The first idea was gambling data. I steered away from it: it meant seeking out people at risk
          of harm. Crypto investors were as rich to study, relevant to finance researchers, and didn't
          require targeting anyone for harm. That scoping call was the project's first ethical decision,
          made before any screen existed.
        </p>
        <p class="evam-body evam-body--mt-sm">
          Research on data donation explains it through prosocial motivation, trust and the collective
          good. Crypto investing is private, self-directed and about personal gain, so those drivers don't
          apply, and no published study had looked at this group. So I asked: could giving investors
          insight about themselves motivate them to donate, and what would that insight need to be?
        </p>
      </div>
    </section>

    {/* ───── Design process: heading beside the double diamond ───── */}
    <section class="evam-block sdds-process" aria-labelledby="process-heading">
      <h2 class="evam-h2" id="process-heading">Design process</h2>
      <a
        href="/images/sdds-images/sdds-double-diamond.png"
        target="_blank"
        rel="noopener"
        class="sdds-zoom sdds-process-fig"
        aria-label="Open full-size image in a new tab"
      >
        <img
          src="/images/sdds-images/sdds-double-diamond.png"
          alt="An asymmetric double diamond running from May to August. Phase 1, Discover and Define, is the larger diamond: 1 literature review, 2 semi-structured interviews, 3 affinity mapping and COM-B analysis, 4 design requirements and data types. Phase 2, Develop and Deliver, is smaller: 5 field specification, 6 RITE and think-aloud, 7 SDDS consultation, 8 design recommendation."
          width="1800"
          height="1221"
          class="sdds-image"
          loading="lazy"
          decoding="async"
        />
      </a>
    </section>

    {/* ───── What I found ───── */}
    <section class="evam-block">
      <div class="evam-prose">
        <h2 class="evam-h2">What I found</h2>
        <h3 class="sdds-h3 sdds-h3--mt">Why donation doesn't happen: three gaps</h3>
      </div>
      <a
        href={deficits.src}
        target="_blank"
        rel="noopener"
        class="sdds-zoom sdds-figure"
        aria-label="Open full-size image in a new tab"
      >
        <img
          src={deficits.src}
          alt={deficits.alt}
          width={deficits.w}
          height={deficits.h}
          class="sdds-image"
          loading="lazy"
          decoding="async"
        />
      </a>
      <div class="evam-prose">
        <ul class="evam-list evam-list--mt">
          {gaps.map((g) => (
            <li class="evam-row">
              <p class="evam-row-finding"><strong class="sdds-strong">{g.name}:</strong> {g.body}</p>
            </li>
          ))}
        </ul>
        <blockquote class="evam-quote sdds-quote--inline">
          "If I receive useful insights about my own trading in return, it feels like a fair exchange
          rather than just giving away my data for free." <span class="sdds-attrib">— interview participant</span>
        </blockquote>

        <h3 class="sdds-h3 sdds-h3--mt-lg">Six conditions, and where the design meets each one</h3>
        <div class="sdds-table-wrap" tabindex="0" role="region" aria-label="Six conditions table">
          <table class="sdds-table">
            <thead>
              <tr>
                <th scope="col">Condition</th>
                <th scope="col">Raised by</th>
                <th scope="col">Where the final design meets it</th>
              </tr>
            </thead>
            <tbody>
              {conditions.map((c) => (
                <tr>
                  <th scope="row">{c.name}</th>
                  <td class="sdds-table-result">{c.raised}</td>
                  <td>{c.met}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h3 class="sdds-h3 sdds-h3--mt-lg">The data that exists isn't the data they'll give</h3>
      </div>
      <a
        href={overlap.src}
        target="_blank"
        rel="noopener"
        class="sdds-zoom sdds-figure sdds-figure--narrow"
        aria-label="Open full-size image in a new tab"
      >
        <img
          src={overlap.src}
          alt={overlap.alt}
          width={overlap.w}
          height={overlap.h}
          class="sdds-image"
          loading="lazy"
          decoding="async"
        />
      </a>
      <div class="evam-prose">
        <p class="evam-body evam-body--mt-md">
          I opened a real Binance account and requested its export. The data that exists, like exact
          balances and addresses, is what investors refuse. The data they'd happily give, like their
          trading rhythm, doesn't exist as a field. That located the design: a layer between the export
          and the researcher that computes 22 identity-free measures on the phone.
        </p>
      </div>
    </section>

    {/* ───── How I thought about the work ───── */}
    <section class="evam-block">
      <div class="evam-prose evam-hero-grid">
        <div>
          <h2 class="evam-h2">How I thought about the work</h2>
          <p class="evam-subhead">Four principles, each traced back to what participants said:</p>
        </div>
        <div>
          <ul class="evam-list">
            {principles.map((p) => (
              <li class="evam-row">
                <span class="evam-num evam-num--principle">{p.n}</span>
                <div class="flex-1">
                  <p class="evam-row-name">{p.name}</p>
                  <p class="evam-row-desc">{p.body}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    {/* ───── The final design: the walkthrough phone beside its step list ───── */}
    <section class="evam-block" id="final-design" aria-labelledby="final-design-heading">
      <div class="evam-prose">
        <h2 class="evam-h2" id="final-design-heading">The final design</h2>
        <p class="evam-body evam-body--mt-md">
          Five steps, in the order that made it work: decide first, then the reflection.
        </p>
      </div>
      <div class="sdds-final">
        <div class="sdds-final-phone">
          <FlowWalkthrough steps={walkthrough} id="final-walkthrough" />
        </div>
        <FlowSteps steps={walkthrough} target="final-walkthrough" note={false} scroll={false} columns={1} />
      </div>
    </section>

    {/* ───── Testing: what changed and why ───── */}
    <section class="evam-block">
      <div class="evam-prose">
        <h2 class="evam-h2">Testing: what changed and why</h2>
      </div>

      {rounds.map((it) => (
        <div class="sdds-iteration">
          <h3 class="sdds-h3">{it.title}</h3>
          <a
            href={it.image.src}
            target="_blank"
            rel="noopener"
            class="sdds-zoom sdds-figure-plain"
            aria-label="Open full-size image in a new tab"
          >
            <img
              src={it.image.src}
              alt={it.image.alt}
              width={it.image.w}
              height={it.image.h}
              class="sdds-image"
              loading="lazy"
              decoding="async"
            />
          </a>
          <div class="evam-prose">
            {it.quote && <blockquote class="evam-quote sdds-quote--inline sdds-quote--round">{it.quote}</blockquote>}
            <p class="evam-body evam-body--mt-sm">{it.body}</p>
          </div>
        </div>
      ))}

      <div class="evam-prose sdds-iteration">
        <h3 class="sdds-h3">The hardest call</h3>
        <p class="evam-body evam-body--mt-sm">
          Reversing my own founding principle after round 2. "Consent by seeing" produced donations
          nobody paid attention to. Moving the decision first fixed that but made the reflection the
          price, so I kept the risk small with a literal preview of the reflection and a decision you can
          revise afterwards.
        </p>
      </div>
    </section>

    {/* ───── What testing showed ───── */}
    <section class="evam-block">
      <div class="evam-prose">
        <h2 class="evam-h2">What testing showed</h2>
        <div class="sdds-table-wrap" tabindex="0" role="region" aria-label="What testing showed table">
          <table class="sdds-table">
            <thead>
              <tr>
                <th scope="col">Measure</th>
                <th scope="col">Result</th>
                <th scope="col">What it drove</th>
              </tr>
            </thead>
            <tbody>
              {results.map((r) => (
                <tr>
                  <th scope="row">{r.measure}</th>
                  <td class="sdds-table-result">{r.result}</td>
                  <td>{r.drove}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="evam-body evam-body--mt-md">
          <strong class="sdds-strong">The headline:</strong> reflection can motivate donation, but only
          after the ask. The order is the mechanism.
        </p>
      </div>
    </section>

    {/* ───── Recommendations to SDDS ───── */}
    <section class="evam-block">
      <div class="evam-prose">
        <h2 class="evam-h2">Recommendations to SDDS</h2>
        <ol class="evam-list evam-list--mt">
          {recommendations.map((r, i) => (
            <li class="evam-row">
              <span class="evam-num evam-num--finding">{pad(i)}</span>
              <p class="evam-row-finding"><strong class="sdds-strong">{r.name}</strong> — {r.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* ───── Honest limits ───── */}
    <section class="evam-block">
      <div class="evam-prose">
        <h2 class="evam-h2">Honest limits</h2>
        <ul class="evam-list evam-list--mt">
          {limits.map((l) => (
            <li class="evam-row">
              <p class="evam-row-finding">{l}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ───── What I'm taking forward ───── */}
    <section class="evam-block">
      <div class="evam-prose">
        <h2 class="evam-h2">What I'm taking forward</h2>
        <p class="evam-body evam-body--mt-md">
          My first project leading research end to end. It changed how I work: I now specify
          the behaviour, what influences it and how a design should change it, and only then
          the screens.
        </p>
        <p class="evam-body evam-body--mt-sm">
          It also points to where I'm going next. The core of this design, a layer that holds
          broad access on someone's behalf while they narrow what leaves, is the core problem
          of agentic design: a system acts for a person, and the person must still see, bound
          and reverse what it does.
        </p>
      </div>
    </section>

    {/* ───── Closing ───── */}
    <section class="evam-closing">
      <p class="evam-prose evam-back sdds-back">
        <a href="/" class="evam-link">← Back to the desk</a>
      </p>
    </section>
  </article>

  <Footer flowers />
</Layout>

