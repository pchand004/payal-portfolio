---
/**
 * <ImpactStats> — the "Impact" block used on case studies: a label, then up to three
 * metrics, each a big accent number with a short caption, under a thin accent rule.
 * Moved here unchanged from the Gravity Grip page so other case studies can reuse it.
 */
interface Props {
  stats: { value: string; caption: string }[];
  label?: string;
}
const { stats, label = 'Impact' } = Astro.props;
---

<p class="gg-impact-label">{label}</p>
<div class="gg-impact-grid">
  {stats.map((s) => (
    <div class="gg-impact-card">
      <p class="gg-impact-num">{s.value}</p>
      <p class="gg-impact-caption">{s.caption}</p>
    </div>
  ))}
</div>

<style>
  /* ───── Impact stats — thin accent rule above each metric ───── */
  .gg-impact-label {
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    font-size: 18px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #4105DB;
    margin: 0 0 28px;
  }
  @media (min-width: 768px) {
    .gg-impact-label {
      font-size: 22px;
    }
  }
  .gg-impact-grid {
    margin-top: 32px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    align-items: stretch;
  }
  @media (min-width: 768px) {
    .gg-impact-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
    }
  }
  .gg-impact-card {
    border-top: 2px solid #4105DB;
    padding-top: 20px;
  }
  .gg-impact-num {
    font-size: 48px;
    font-weight: 700;
    color: #4105DB;
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
    font-style: normal;
  }

  @media (max-width: 767px) {
    .gg-impact-num {
      font-size: 36px;
    }
  }
  .gg-impact-caption {
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    font-size: 12px;
    font-weight: 400;
    color: #2C2620;
    line-height: 1.5;
    margin: 0;
  }
  @media (min-width: 768px) {
    .gg-impact-caption {
      font-size: 13px;
    }
  }
</style>
