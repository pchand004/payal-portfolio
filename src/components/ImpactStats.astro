---
/**
 * <ImpactStats> — the "Impact" block used on case studies: a label, then up to three
 * metrics, each a big accent number with a short caption, under a thin accent rule.
 * Moved here unchanged from the Gravity Grip page so other case studies can reuse it.
 */
interface Props {
  stats: { value: string; caption: string }[];
  label?: string;
}
const { stats, label = 'Impact' } = Astro.props;
---

<p class="gg-impact-label">{label}</p>
<div class="gg-impact-grid">
  {stats.map((s) => (
    <div class="gg-impact-card">
      <p class="gg-impact-num">{s.value}</p>
      <p class="gg-impact-caption">{s.caption}</p>
    </div>
  ))}
</div>

<style>
  /* Sized to sit with the case-study type: the label matches the small-caps meta labels,
     numbers sit between the section heading (28px) and body (17px) sizes. */
  .gg-impact-label {
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #4105DB;
    margin: 0;
  }
  @media (min-width: 768px) {
    .gg-impact-label {
      font-size: 13px;
    }
  }
  .gg-impact-grid {
    margin-top: 16px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    align-items: stretch;
  }
  @media (min-width: 768px) {
    .gg-impact-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
    }
  }
  .gg-impact-card {
    border-top: 1.5px solid #4105DB;
    padding-top: 16px;
  }
  .gg-impact-num {
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    font-size: 26px;
    font-weight: 600;
    color: #4105DB;
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0 0 8px;
    font-style: normal;
  }
  @media (min-width: 768px) {
    .gg-impact-num {
      font-size: 30px;
    }
  }
  .gg-impact-caption {
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #2C2620;
    line-height: 1.5;
    margin: 0;
  }
</style>
