---
/**
 * <EmailCopy> — makes every mailto link on the page copy the address instead.
 *
 * Click, tap, or Enter on any <a href="mailto:…"> copies the address to the
 * clipboard and shows a short "Copied" toast, announced to screen readers via a
 * polite live region. mailto stays as the fallback: if the clipboard is
 * unavailable or refuses, the link opens the mail app as before. Cmd/Ctrl/
 * Shift/Alt-click and middle-click are left alone, so people can still open
 * their mail client on purpose.
 */
---

<div class="email-toast" role="status" aria-live="polite" aria-atomic="true" data-email-toast></div>

<style is:global>
  .email-toast {
    position: fixed;
    left: 50%;
    bottom: 28px;
    z-index: 10000;
    translate: -50% 12px;
    padding: 10px 16px;
    border-radius: 999px;
    background: var(--text);
    color: var(--bg);
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    font-size: 13px;
    line-height: 1.3;
    white-space: nowrap;
    box-shadow: 0 8px 24px rgba(44, 38, 32, 0.18);
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms ease, translate 260ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .email-toast:empty {
    padding: 0;
  }
  .email-toast.is-shown {
    opacity: 1;
    translate: -50% 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .email-toast {
      transition: opacity 150ms linear;
      translate: -50% 0;
    }
  }
  /* Address shown on hover / keyboard focus for links that don't spell it out */
  [data-email-tip] {
    position: relative;
  }
  [data-email-tip]::after {
    content: attr(data-email-tip);
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    padding: 5px 9px;
    border-radius: 6px;
    background: var(--text);
    color: var(--bg);
    font-size: 12px;
    font-style: normal;
    line-height: 1.3;
    white-space: nowrap;
    opacity: 0;
    translate: 0 -4px;
    pointer-events: none;
    transition: opacity 160ms ease, translate 160ms ease;
    z-index: 60;
  }
  [data-email-tip]:hover::after,
  [data-email-tip]:focus-visible::after {
    opacity: 1;
    translate: 0 0;
  }
</style>

<script>
  let timer = 0;
  function toast(text: string) {
    const el = document.querySelector<HTMLElement>('[data-email-toast]');
    if (!el) return;
    window.clearTimeout(timer);
    // clear first so the live region re-announces repeat copies
    el.textContent = '';
    el.classList.remove('is-shown');
    requestAnimationFrame(() => {
      el.textContent = text;
      el.classList.add('is-shown');
    });
    timer = window.setTimeout(() => {
      el.classList.remove('is-shown');
      window.setTimeout(() => (el.textContent = ''), 300);
    }, 2200);
  }

  async function copy(text: string): Promise<boolean> {
    try {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(text);
        return true;
      }
    } catch {
      /* fall through to the legacy path */
    }
    try {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.cssText = 'position:fixed;top:-1000px;opacity:0';
      document.body.appendChild(ta);
      ta.select();
      const ok = document.execCommand('copy');
      ta.remove();
      return ok;
    } catch {
      return false;
    }
  }

  let bound = false;
  function init() {
    if (bound) return;
    bound = true;
    document.addEventListener('click', async (e) => {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const link = (e.target as Element | null)?.closest?.<HTMLAnchorElement>('a[href^="mailto:"]');
      if (!link) return;
      const href = link.getAttribute('href') || '';
      const address = decodeURIComponent(href.slice(7).split('?')[0]);
      if (!address) return;
      e.preventDefault();
      if (await copy(address)) {
        toast(`Copied ${address}`);
      } else {
        window.location.href = href; // fallback: open the mail app
      }
    });
  }
  init();
  document.addEventListener('astro:page-load', init);
</script>
