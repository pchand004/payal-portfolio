---
/**
 * Site-wide top nav. "पायल" wordmark (Tiro Devanagari Hindi) with a small
 * hand-drawn moon on the left — Chand means moon — and About · Resume ·
 * Contact · sound toggle on the right.
 *
 * The moon waxes with scroll: a crescent at the top of the page, full at the
 * bottom (see the script below). The hand-drawn stroke never changes; only the
 * lit area behind it does, via a clipPath whose terminator is an ellipse arc.
 *
 * variant:
 *   "overlay" — absolutely positioned at the top of a relative parent
 *     (e.g. the homepage hero). Provides its own max-width + horizontal
 *     padding because it sits outside the Layout's content container.
 *   "inline"  — sits in normal document flow inside the Layout's content
 *     container, which already provides max-width + horizontal padding,
 *     so the inner div skips them to avoid double-constraint.
 */
interface Props {
  variant?: 'overlay' | 'inline';
}

const { variant = 'inline' } = Astro.props;
---

<nav
  class:list={[
    variant === 'overlay' && 'absolute inset-x-0 top-0 z-30',
    /* Pull inline nav up to cancel Layout's py-8/md:py-12 wrapper padding,
       so it sits at the same y-position as the homepage's overlay nav. */
    variant === 'inline' && '-mt-8 md:-mt-12',
  ]}
>
  <div
    class:list={[
      'flex items-center justify-between py-5 md:py-6',
      variant === 'overlay' && 'mx-auto max-w-[1200px] px-6 md:px-10',
    ]}
  >
    <a
      href="/"
      aria-label="Payal Chand, home"
      class="inline-flex items-center gap-[0.24em] text-2xl leading-none text-accent transition-colors duration-200 hover:text-accent-hover"
    >
      <span lang="hi" class="font-logo">पायल</span>
      {/* Moon — one slightly wobbly open stroke, inherits the link colour.
          The lit disc behind it is clipped to the current phase. */}
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        class="h-[0.74em] w-[0.74em] shrink-0 -translate-y-[0.08em] -rotate-12"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        data-moon
      >
        <defs>
          <clipPath id="moon-phase-clip">
            <path data-moon-terminator d="M12.2 3.6 A 8.3 8.3 0 0 0 12.2 20.2 A 1.7 8.3 0 0 1 12.2 3.6 Z" />
          </clipPath>
        </defs>
        <circle cx="12.2" cy="11.9" r="8.3" fill="currentColor" fill-opacity="0.28" stroke="none" clip-path="url(#moon-phase-clip)" />
        <path d="M15.4 3.2 C 9.6 2.5, 4.1 7.4, 4.5 12.9 C 4.9 18.6, 10.6 22.1, 16.7 20.3 C 12.4 18.8, 10.1 15.4, 10.5 11.5 C 10.8 8.1, 12.6 5.3, 16.1 3.6" />
      </svg>
    </a>
    <ul class="flex items-center gap-2 text-xs text-muted md:gap-3 md:text-sm">
      <li>
        <a href="/about" class="transition-colors duration-200 hover:text-accent">About</a>
      </li>
      <li aria-hidden="true" class="opacity-50">·</li>
      <li>
        <a
          href="/PayalChandCV.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors duration-200 hover:text-accent"
        >Resume</a>
      </li>
      <li aria-hidden="true" class="opacity-50">·</li>
      <li>
        <a
          href="mailto:chandpayal3011@gmail.com"
          class="transition-colors duration-200 hover:text-accent"
          data-email-tip="chandpayal3011@gmail.com · click to copy"
          aria-label="Contact: copy email address chandpayal3011@gmail.com"
        >Contact</a>
      </li>
      <li aria-hidden="true" class="opacity-50">·</li>
      <li>
        {/* Sound toggle — icon only; label and pressed state are set by the script */}
        <button
          type="button"
          class="sound-toggle -my-1 inline-flex h-7 w-7 items-center justify-center rounded-full text-muted transition-colors duration-200 hover:text-accent"
          aria-label="Sound on"
          aria-pressed="true"
          data-sound-toggle
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-[15px] w-[15px]" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            {/* a small hand-drawn speaker: body + two waves; the slash shows when off */}
            <path d="M4.3 9.6 C 4.2 9.3, 4.6 9.1, 7.2 9.1 L 12.4 5.1 C 12.9 4.8, 13.2 5.1, 13.2 5.6 L 13.1 18.3 C 13.1 18.9, 12.7 19.1, 12.3 18.8 L 7.3 14.9 C 4.6 14.9, 4.3 14.7, 4.3 14.3 Z" />
            <path class="sound-wave" d="M16.2 9.3 C 17.4 10.6, 17.5 13.2, 16.3 14.6" />
            <path class="sound-wave" d="M18.9 7.1 C 21.1 9.5, 21.2 14.4, 19 16.9" />
            <path class="sound-slash" d="M3.6 20.3 L 20.6 3.7" />
          </svg>
        </button>
      </li>
    </ul>
  </div>
</nav>

<style>
  .sound-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .sound-toggle .sound-slash {
    display: none;
  }
  .sound-toggle[aria-pressed='false'] .sound-wave {
    display: none;
  }
  .sound-toggle[aria-pressed='false'] .sound-slash {
    display: block;
  }
</style>

<script>
  import { playTick, primeSound, setSoundEnabled, soundEnabled } from '../scripts/sound';

  /* ───── Moon phase, driven by scroll progress ─────
     progress = scrollY / (scrollHeight − innerHeight): 0 at the top, 1 at the
     bottom. The terminator is an ellipse arc whose x-radius runs from the
     crescent's inner curve (left of centre) to the full disc (right limb).
     Updated with a passive scroll listener + one requestAnimationFrame per
     scroll event, so nothing runs while the page is still. */
  const CX = 12.2;
  const CY = 11.9;
  const R = 8.3;
  const W0 = -1.7; // terminator offset at the crescent
  const terminator = (t: number) => {
    const w = W0 + t * (R - W0);
    const rx = Math.max(0.02, Math.abs(w)).toFixed(3);
    const sweep = w < 0 ? 1 : 0;
    return `M${CX} ${CY - R} A ${R} ${R} 0 0 0 ${CX} ${CY + R} A ${rx} ${R} 0 0 ${sweep} ${CX} ${CY - R} Z`;
  };
  let raf = 0;
  let lastT = -1;
  function paintMoon() {
    raf = 0;
    const path = document.querySelector<SVGPathElement>('[data-moon-terminator]');
    if (!path) return;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const t = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
    if (Math.abs(t - lastT) < 0.002) return;
    lastT = t;
    path.setAttribute('d', terminator(t));
  }
  const requestPaint = () => {
    if (!raf) raf = requestAnimationFrame(paintMoon);
  };
  let moonBound = false;
  function initMoon() {
    lastT = -1;
    requestPaint();
    if (moonBound) return;
    moonBound = true;
    window.addEventListener('scroll', requestPaint, { passive: true });
    window.addEventListener('resize', requestPaint, { passive: true });
  }

  /* ───── Sound toggle + the selections that tick ───── */
  function syncToggles() {
    const on = soundEnabled();
    document.querySelectorAll<HTMLButtonElement>('[data-sound-toggle]').forEach((b) => {
      b.setAttribute('aria-pressed', String(on));
      b.setAttribute('aria-label', on ? 'Sound on' : 'Sound off');
    });
  }
  let soundBound = false;
  function initSound() {
    syncToggles();
    if (soundBound) return;
    soundBound = true;
    // first gesture of any kind creates/resumes the context, so the first tick is on time
    const prime = () => primeSound();
    document.addEventListener('pointerdown', prime, { once: true, passive: true });
    document.addEventListener('keydown', prime, { once: true, passive: true });
    document.addEventListener('click', (e) => {
      const el = e.target as Element | null;
      if (!el) return;
      const toggle = el.closest('[data-sound-toggle]');
      if (toggle) {
        const on = !soundEnabled();
        setSoundEnabled(on);
        syncToggles();
        if (on) playTick();
        return;
      }
      // tapping the moon (it sits inside the home link)
      if (el.closest('[data-moon]')) playTick();
    });
    document.addEventListener('sound:change', syncToggles);
  }

  function init() {
    initMoon();
    initSound();
  }
  init();
  document.addEventListener('astro:page-load', init);
</script>
