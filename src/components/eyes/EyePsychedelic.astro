---
/**
 * Eye 5 · "psychedelic". A lid line parts (clip-path) onto concentric iris
 * rings. The rings breathe a few percent in scale while their hue cycles:
 * two stacked ring sets take turns dissolving into the next palette, so the
 * colour change is done with opacity alone.
 */
const RINGS = [46, 39, 32, 25, 18, 11];
---

<div class="eye eye-psy" data-eye-root="psy">
  <span class="lid-line" data-line></span>
  <div class="opening" data-opening>
    <svg viewBox="0 0 160 100" aria-hidden="true">
      <defs>
        <clipPath id="psy-almond">
          <path d="M6 50 C44 8 116 8 154 50 C116 92 44 92 6 50 Z" />
        </clipPath>
      </defs>
      <g clip-path="url(#psy-almond)">
        <rect x="0" y="0" width="160" height="100" fill="#000" />
        <g class="breathe" data-breathe>
          {['a', 'b'].map((set) => (
            <g class={`set set-${set}`} data-set={set}>
              {RINGS.map((r) => <circle cx="80" cy="50" r={r} />)}
            </g>
          ))}
          <circle cx="80" cy="50" r="5" fill="#000" />
        </g>
      </g>
      <path d="M6 50 C44 8 116 8 154 50 C116 92 44 92 6 50 Z" class="rim" />
    </svg>
  </div>
</div>

<style>
  .eye-psy {
    position: relative;
  }
  .eye-psy svg {
    display: block;
    width: calc(var(--eye) * 1.15);
    height: auto;
  }
  .lid-line {
    position: absolute;
    left: 3.75%;
    right: 3.75%;
    top: 50%;
    height: 1.5px;
    margin-top: -0.75px;
    background: var(--eye-white);
  }
  .opening {
    clip-path: ellipse(50% 0.75% at 50% 50%);
  }
  [data-state='open'] .opening {
    clip-path: ellipse(75% 75% at 50% 50%);
  }
  [data-state='open'] .lid-line {
    opacity: 0;
  }
  .breathe {
    transform-box: view-box;
    transform-origin: 80px 50px;
  }
  .set-b {
    opacity: 0;
  }
  .rim {
    fill: none;
    stroke: var(--eye-white);
    stroke-width: 1.5;
  }
</style>

<script>
  import { registerEye, cancelAll, wait, done } from '../../scripts/eyes/registry';
  import {
    WAKE_MS, EASE_OUT, EASE_IN_OUT,
    PSY_HUE_STEP, PSY_HUE_FADE_MS, PSY_BREATHE_SCALE, PSY_BREATHE_MS,
  } from '../../scripts/eyes/motion';

  const CLOSED = 'ellipse(50% 0.75% at 50% 50%)';
  const OPEN = 'ellipse(75% 75% at 50% 50%)';
  const runs = new WeakMap<HTMLElement, AbortController>();

  /** Palette k: each ring a step round the wheel from the last. */
  function paint(set: SVGGElement, k: number) {
    const base = 200 + k * PSY_HUE_STEP;
    set.querySelectorAll('circle').forEach((c, i) => {
      c.setAttribute('fill', `hsl(${(base + i * 52) % 360} 75% ${i % 2 ? 46 : 60}%)`);
    });
  }

  function rest(el: HTMLElement) {
    paint(el.querySelector('[data-set="a"]')!, 0);
    paint(el.querySelector('[data-set="b"]')!, 1);
  }

  async function loop(el: HTMLElement, signal: AbortSignal) {
    const opening = el.querySelector<HTMLElement>('[data-opening]')!;
    const line = el.querySelector<HTMLElement>('[data-line]')!;
    const a = el.querySelector<SVGGElement>('[data-set="a"]')!;
    const b = el.querySelector<SVGGElement>('[data-set="b"]')!;
    const breathe = el.querySelector<SVGGElement>('[data-breathe]')!;

    line.animate([{ opacity: 1 }, { opacity: 0 }], { duration: WAKE_MS, easing: EASE_OUT, fill: 'forwards' });
    await done(opening.animate([{ clipPath: CLOSED }, { clipPath: OPEN }],
      { duration: WAKE_MS, easing: EASE_OUT, fill: 'forwards' }), signal);

    breathe.animate([{ transform: 'scale(1)' }, { transform: `scale(${PSY_BREATHE_SCALE})` }],
      { duration: PSY_BREATHE_MS, easing: EASE_IN_OUT, direction: 'alternate', iterations: Infinity });

    // b (palette k+1) dissolves in over a; a repaints underneath to k+2;
    // b dissolves out to reveal it; b repaints while invisible; repeat.
    for (let k = 1; ; k += 2) {
      paint(b, k);
      await done(b.animate([{ opacity: 0 }, { opacity: 1 }],
        { duration: PSY_HUE_FADE_MS, easing: EASE_IN_OUT, fill: 'forwards' }), signal);
      paint(a, k + 1);
      await done(b.animate([{ opacity: 1 }, { opacity: 0 }],
        { duration: PSY_HUE_FADE_MS, easing: EASE_IN_OUT, fill: 'forwards' }), signal);
    }
  }

  document.querySelectorAll<HTMLElement>('[data-eye-root="psy"]').forEach(rest);

  registerEye('psy', {
    wake(el, still) {
      if (still) {
        el.dataset.state = 'open';
        return;
      }
      const run = new AbortController();
      runs.set(el, run);
      loop(el, run.signal).catch(() => {});
    },
    reset(el) {
      runs.get(el)?.abort();
      runs.delete(el);
      cancelAll(el);
      delete el.dataset.state;
      rest(el);
    },
  });
</script>
