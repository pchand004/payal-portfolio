---
/**
 * Eye 2 · "looks around". A big eyeball with a lime iris and a coral lid on
 * a grainy plum tile with a small yellow moon. Opens round; the pupil drifts
 * left, then right, then circles the rim once; then the whole eye rolls 180°
 * and settles upside down, lid at the bottom.
 */
---

<div class="eye eye-look" data-eye-root="look">
  <svg viewBox="0 0 200 200" aria-hidden="true">
    <defs>
      <clipPath id="look-tile"><rect width="200" height="200" rx="46" /></clipPath>
      <clipPath id="look-ball"><circle cx="100" cy="104" r="60" /></clipPath>
      <filter id="look-grain" x="0" y="0" width="100%" height="100%">
        <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" stitchTiles="stitch" />
        <feColorMatrix type="saturate" values="0" />
      </filter>
    </defs>

    <g clip-path="url(#look-tile)">
      <rect width="200" height="200" class="tile" />
      <circle cx="160" cy="38" r="13" class="moon" />
      <rect width="200" height="200" filter="url(#look-grain)" class="grain" />
    </g>

    <g class="turn" data-turn>
      <g class="lid" data-lid>
        <g clip-path="url(#look-ball)">
          <rect x="40" y="44" width="120" height="120" class="white" />
          <circle cx="80" cy="84" r="64" class="shade" />
          <g class="iris" data-iris>
            <circle cx="100" cy="104" r="27" class="iris-fill" />
            <circle cx="100" cy="104" r="14" class="pupil" />
            <path d="M92 92 l2 -7 l2 7 l7 2 l-7 2 l-2 7 l-2 -7 l-7 -2 Z" class="white" />
          </g>
          <path d="M36 40 H164 V78 Q100 98 36 78 Z" class="cap" />
        </g>
        <circle cx="100" cy="104" r="60" class="rim" />
      </g>
    </g>
  </svg>
</div>

<style>
  .eye-look svg {
    display: block;
    width: var(--eye);
    height: auto;
  }
  .tile { fill: #45206a; }
  .moon { fill: #f6dc3a; }
  .grain {
    opacity: 0.35;
    mix-blend-mode: soft-light;
  }
  .turn,
  .lid,
  .iris {
    transform-box: view-box;
  }
  .turn {
    transform-origin: 100px 104px;
  }
  .lid {
    transform-origin: 100px 104px;
    transform: scaleY(0.04);
  }
  [data-state='open'] .lid {
    transform: none;
  }
  .white { fill: #fbf6ec; }
  .shade {
    fill: none;
    stroke: #e3d6c4;
    stroke-width: 26;
    opacity: 0.7;
  }
  .iris-fill { fill: #c4ec3a; }
  .pupil { fill: #14121c; }
  .cap { fill: #ff7a5c; }
  .rim {
    fill: none;
    stroke: #fbf6ec;
    stroke-width: 3;
    vector-effect: non-scaling-stroke;
  }
</style>

<script>
  import { registerEye, cancelAll, wait, done } from '../../scripts/eyes/registry';
  import {
    WAKE_MS, EASE_OUT, EASE_IN_OUT, LOOK_REACH,
    LOOK_DRIFT_MS, LOOK_HOLD_MS, LOOK_CIRCLE_MS, LOOK_TURN_MS,
  } from '../../scripts/eyes/motion';

  // ball r 60, iris r 27: the iris has 33 units of room to travel
  const REACH = 33 * LOOK_REACH;
  const at = (x: number, y = 0) => ({ transform: `translate(${x.toFixed(2)}px, ${y.toFixed(2)}px)` });
  const runs = new WeakMap<HTMLElement, AbortController>();

  async function loop(el: HTMLElement, signal: AbortSignal) {
    const lid = el.querySelector<SVGGElement>('[data-lid]')!;
    const iris = el.querySelector<SVGGElement>('[data-iris]')!;
    const turn = el.querySelector<SVGGElement>('[data-turn]')!;
    const move = (frames: Keyframe[], duration: number, easing = EASE_IN_OUT) =>
      done(iris.animate(frames, { duration, easing, fill: 'forwards' }), signal);

    await done(lid.animate([{ transform: 'scaleY(0.04)' }, { transform: 'scaleY(1)' }],
      { duration: WAKE_MS, easing: EASE_OUT, fill: 'forwards' }), signal);
    await wait(LOOK_HOLD_MS, signal);

    await move([at(0), at(-REACH)], LOOK_DRIFT_MS);
    await wait(LOOK_HOLD_MS, signal);
    await move([at(-REACH), at(REACH)], LOOK_DRIFT_MS * 1.4);
    await wait(LOOK_HOLD_MS, signal);

    // one lap of the rim, starting from the right and going up and over
    const lap: Keyframe[] = [];
    for (let deg = 0; deg <= 360; deg += 10) {
      const r = (deg * Math.PI) / 180;
      lap.push(at(Math.cos(r) * REACH, -Math.sin(r) * REACH));
    }
    await move(lap, LOOK_CIRCLE_MS);

    // the pupil comes home while the eye rolls over, overshoots a touch, settles
    iris.animate([at(REACH), at(0)], { duration: LOOK_TURN_MS * 0.6, easing: EASE_IN_OUT, fill: 'forwards' });
    await done(turn.animate([
      { transform: 'rotate(0deg)' },
      { transform: 'rotate(188deg)', offset: 0.72 },
      { transform: 'rotate(180deg)' },
    ], { duration: LOOK_TURN_MS, easing: EASE_IN_OUT, fill: 'forwards' }), signal);
  }

  registerEye('look', {
    wake(el, still) {
      if (still) {
        el.dataset.state = 'open';
        return;
      }
      const run = new AbortController();
      runs.set(el, run);
      loop(el, run.signal).catch(() => {});
    },
    reset(el) {
      runs.get(el)?.abort();
      runs.delete(el);
      cancelAll(el);
      delete el.dataset.state;
    },
  });
</script>
