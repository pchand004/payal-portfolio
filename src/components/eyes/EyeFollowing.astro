---
/**
 * Eye pair · "Following". Two solid white upright pills with a near-black
 * pupil each. The pupils follow the cursor on a soft lag, all the way out to
 * the pill's edge, and sit low and to the left when the cursor is still or
 * far away. The pair drifts a few pixels so it is never frozen, and blinks
 * every few seconds. It wakes as a flat white line that opens into the pills,
 * and leaves by closing back to a line that disappears.
 *
 * Every tunable value is here. Sizes are in px at the 1440 × 1024 design
 * frame and scale with the cell (--u is one design px). The script reads
 * timings and ratios from data-config.
 */

// ── Shape (design px) ──────────────────────────────────────────────────
const PILL_W = 67;
const PILL_H = 118;
const GAP = 33; // between the pills; the pair is 167 wide, ~46% of a 360 cell
const PAIR_MAX_SHARE = 0.6; // the pair never spans more of its cell than this
const PUPIL = 35;

// ── Colours ────────────────────────────────────────────────────────────
const WHITE = '#FFFFFF';
const PUPIL_COLOUR = '#0A1118';

// ── Following ──────────────────────────────────────────────────────────
const PUPIL_LAG_MS = 160; // time constant of the follow: higher is lazier
const PUPIL_GAIN = 0.14; // pupil offset per px of cursor offset, before the edge stops it
const PUPIL_SETTLE_PX = 0.05; // closer than this to the target counts as settled
const REST_X = -15; // where the pupils sit at rest, from the pill's centre (design px)
const REST_Y = 12;
const REST_AFTER_MS = 1800; // cursor still this long: pupils ease back to rest
const FAR_PX = 700; // cursor further than this from the pair counts as far away

// ── Life ───────────────────────────────────────────────────────────────
const BLINK_EVERY_MS = [4000, 7000]; // random interval between blinks
const BLINK_DOWN_MS = 150;
const BLINK_UP_MS = 250;
const LINE = 0.03; // a closed pill's height, as a share of its open height
const DRIFT_PX = 4; // how far the pair wanders (design px)
const DRIFT_MS = 12000; // one wander loop

// ── Wake and leave ─────────────────────────────────────────────────────
const WAKE_MS = 700; // the line opening into the pills
const LEAVE_CLOSE_MS = 300; // the pills closing to a line…
const LEAVE_FADE_MS = 500; // …and the line disappearing (800 in all)
const EASE_OPEN = 'cubic-bezier(0.16, 1, 0.3, 1)';
const EASE_CLOSE = 'cubic-bezier(0.55, 0, 0.75, 0.2)';

const config = {
  PUPIL_LAG_MS, PUPIL_GAIN, PUPIL_SETTLE_PX, REST_X, REST_Y, REST_AFTER_MS, FAR_PX,
  BLINK_EVERY_MS, BLINK_DOWN_MS, BLINK_UP_MS, LINE, DRIFT_PX, DRIFT_MS,
  WAKE_MS, LEAVE_CLOSE_MS, LEAVE_FADE_MS, EASE_OPEN, EASE_CLOSE,
};
const vars = [
  `--pill-w: ${PILL_W}`,
  `--pill-h: ${PILL_H}`,
  `--gap: ${GAP}`,
  `--pair-max: ${PAIR_MAX_SHARE}`,
  `--pupil: ${PUPIL}`,
  `--white: ${WHITE}`,
  `--pupil-colour: ${PUPIL_COLOUR}`,
].join('; ');
---

<div class="pair-root" style={vars} data-eye-root="following" data-config={JSON.stringify(config)}>
  <div class="drift" data-drift>
    <div class="pair">
      {[0, 1].map(() => (
        <div class="pill" data-pill>
          <div class="pupil" data-pupil></div>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .pair-root {
    /* one design px, capped so the pair never passes --pair-max of the cell */
    --s: min(var(--u), calc(var(--cell-w) * var(--pair-max) / (var(--pill-w) * 2 + var(--gap))));
    opacity: 0;
  }
  [data-state='open'],
  [data-state='awake'] {
    opacity: 1;
  }
  .pair {
    display: flex;
    gap: calc(var(--gap) * var(--s));
  }
  .pill {
    position: relative;
    width: calc(var(--pill-w) * var(--s));
    height: calc(var(--pill-h) * var(--s));
    border-radius: calc(var(--pill-w) * var(--s));
    background: var(--white);
    overflow: hidden;
    transform: scaleY(0.03);
  }
  [data-state='open'] .pill {
    transform: none;
  }
  .pupil {
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(var(--pupil) * var(--s));
    height: calc(var(--pupil) * var(--s));
    margin: calc(var(--pupil) * var(--s) / -2) 0 0 calc(var(--pupil) * var(--s) / -2);
    border-radius: 50%;
    background: var(--pupil-colour);
  }
</style>

<script>
  import { registerEye, cancelAll } from '../../scripts/eyes/registry';

  interface Config {
    PUPIL_LAG_MS: number; PUPIL_GAIN: number; PUPIL_SETTLE_PX: number;
    REST_X: number; REST_Y: number; REST_AFTER_MS: number; FAR_PX: number;
    BLINK_EVERY_MS: [number, number]; BLINK_DOWN_MS: number; BLINK_UP_MS: number; LINE: number;
    DRIFT_PX: number; DRIFT_MS: number;
    WAKE_MS: number; LEAVE_CLOSE_MS: number; LEAVE_FADE_MS: number; EASE_OPEN: string; EASE_CLOSE: string;
  }

  interface Run {
    stop(): void;
  }
  const runs = new WeakMap<HTMLElement, Run>();
  const cfg = (el: HTMLElement): Config => JSON.parse(el.dataset.config!);
  const between = ([lo, hi]: [number, number]) => lo + Math.random() * (hi - lo);
  const pillsOf = (el: HTMLElement) => [...el.querySelectorAll<HTMLElement>('[data-pill]')];

  /** One design px in real px, read from the first pill. */
  const unit = (el: HTMLElement) => parseFloat(getComputedStyle(el).getPropertyValue('--s')) || 1;

  function restOf(el: HTMLElement, c: Config) {
    const s = unit(el);
    return { x: c.REST_X * s, y: c.REST_Y * s };
  }

  function putPupils(el: HTMLElement, p: { x: number; y: number }) {
    el.querySelectorAll<HTMLElement>('[data-pupil]').forEach((pupil) => {
      pupil.style.transform = `translate(${p.x.toFixed(2)}px, ${p.y.toFixed(2)}px)`;
    });
  }

  function start(el: HTMLElement, c: Config): Run {
    const pills = pillsOf(el);
    const pupils = pills.map((p) => p.querySelector<HTMLElement>('[data-pupil]')!);
    const rest = restOf(el, c);
    const pos = pills.map(() => ({ ...rest }));
    let cursor: { x: number; y: number } | null = null;
    let lastMove = 0;
    let frame = 0;
    let last = 0;
    let blinkTimer = 0;

    // ── Life: the drift loops on its own layer; blinks squash the pills
    const d = c.DRIFT_PX * unit(el);
    el.querySelector('[data-drift]')!.animate([
      { transform: 'translate(0, 0)' },
      { transform: `translate(${d}px, ${-d * 0.6}px)` },
      { transform: `translate(${-d * 0.5}px, ${d * 0.8}px)` },
      { transform: `translate(${-d}px, ${-d * 0.3}px)` },
      { transform: 'translate(0, 0)' },
    ], { duration: c.DRIFT_MS, easing: 'ease-in-out', iterations: Infinity });

    function blink() {
      const total = c.BLINK_DOWN_MS + c.BLINK_UP_MS;
      for (const pill of pills) {
        pill.animate([
          { transform: 'scaleY(1)', easing: 'cubic-bezier(0.55, 0, 1, 0.45)' },
          { transform: `scaleY(${c.LINE})`, offset: c.BLINK_DOWN_MS / total, easing: 'cubic-bezier(0, 0.55, 0.45, 1)' },
          { transform: 'scaleY(1)' },
        ], { duration: total });
      }
      blinkTimer = window.setTimeout(blink, between(c.BLINK_EVERY_MS));
    }
    blinkTimer = window.setTimeout(blink, between(c.BLINK_EVERY_MS));

    // ── Following: each pupil eases toward a point inside its pill
    // Pill centres come from layout, not from the drifting or blinking
    // boxes, so a still cursor gives a still target.
    function centreOf(pill: HTMLElement) {
      const root = el.getBoundingClientRect();
      return {
        x: root.left + root.width / 2 + pill.offsetLeft + pill.offsetWidth / 2 - el.offsetWidth / 2,
        y: root.top + root.height / 2 + pill.offsetTop + pill.offsetHeight / 2 - el.offsetHeight / 2,
      };
    }

    function target(pill: HTMLElement, now: number) {
      if (!cursor || now - lastMove > c.REST_AFTER_MS) return rest;
      const centre = centreOf(pill);
      const dx = cursor.x - centre.x;
      const dy = cursor.y - centre.y;
      if (Math.hypot(dx, dy) > c.FAR_PX) return rest;

      // The pupil's centre may go anywhere inside an inner pill: the pill
      // shrunk by the pupil's radius all round. At the edge of that, the
      // pupil touches the pill's edge.
      const w = pill.offsetWidth;
      const h = pill.offsetHeight;
      const r = pupils[0].offsetWidth / 2;
      const R = w / 2 - r; // radius of the inner pill's rounded ends
      const straight = Math.max(0, (h - w) / 2); // half the inner pill's straight part
      let x = dx * c.PUPIL_GAIN;
      let y = dy * c.PUPIL_GAIN;
      const cy = Math.max(-straight, Math.min(straight, y)); // nearest end-circle centre
      const dist = Math.hypot(x, y - cy);
      if (dist > R) {
        x *= R / dist;
        y = cy + (y - cy) * (R / dist);
      }
      return { x, y };
    }

    function tick(now: number) {
      const dt = last ? Math.min(now - last, 64) : 16;
      last = now;
      const k = 1 - Math.exp(-dt / c.PUPIL_LAG_MS);
      let moving = false;
      pills.forEach((pill, i) => {
        const t = target(pill, now);
        const p = pos[i];
        p.x += (t.x - p.x) * k;
        p.y += (t.y - p.y) * k;
        if (Math.abs(t.x - p.x) < c.PUPIL_SETTLE_PX && Math.abs(t.y - p.y) < c.PUPIL_SETTLE_PX) {
          p.x = t.x; // land exactly on the target, then stop: no jitter
          p.y = t.y;
        } else {
          moving = true;
        }
        pupils[i].style.transform = `translate(${p.x.toFixed(2)}px, ${p.y.toFixed(2)}px)`;
      });
      // keep ticking while something moves, or until the rest timer can fire
      const resting = !cursor || now - lastMove > c.REST_AFTER_MS;
      frame = moving || !resting ? requestAnimationFrame(tick) : 0;
      if (!frame) last = 0;
    }

    function follow(e: PointerEvent) {
      cursor = { x: e.clientX, y: e.clientY };
      lastMove = performance.now();
      if (!frame) frame = requestAnimationFrame(tick);
    }
    window.addEventListener('pointermove', follow);
    window.addEventListener('pointerdown', follow);
    putPupils(el, rest);

    return {
      stop() {
        window.removeEventListener('pointermove', follow);
        window.removeEventListener('pointerdown', follow);
        cancelAnimationFrame(frame);
        clearTimeout(blinkTimer);
      },
    };
  }

  registerEye('following', {
    wake(el, still) {
      const c = cfg(el);
      putPupils(el, restOf(el, c));
      if (still) {
        el.dataset.state = 'open';
        return;
      }
      el.dataset.state = 'awake';
      for (const pill of pillsOf(el)) {
        pill.animate([{ transform: `scaleY(${c.LINE})` }, { transform: 'scaleY(1)' }],
          { duration: c.WAKE_MS, easing: c.EASE_OPEN, fill: 'forwards' });
      }
      runs.set(el, start(el, c));
    },

    async leave(el, still) {
      const c = cfg(el);
      runs.get(el)?.stop();
      runs.delete(el);
      if (still) {
        await el.animate([{ opacity: 1 }, { opacity: 0 }], { duration: c.LEAVE_FADE_MS, fill: 'forwards' }).finished;
        return;
      }
      // close from wherever the pills are (mid-open, mid-blink), then fade the line
      const closes = pillsOf(el).map((pill) => {
        const from = getComputedStyle(pill).transform;
        pill.getAnimations().forEach((a) => a.cancel());
        return pill.animate([{ transform: from }, { transform: `scaleY(${c.LINE})` }],
          { duration: c.LEAVE_CLOSE_MS, easing: c.EASE_CLOSE, fill: 'forwards' }).finished;
      });
      await Promise.all(closes);
      await el.animate([{ opacity: 1 }, { opacity: 0 }],
        { duration: c.LEAVE_FADE_MS, easing: c.EASE_CLOSE, fill: 'forwards' }).finished;
    },

    reset(el) {
      runs.get(el)?.stop();
      runs.delete(el);
      cancelAll(el);
      delete el.dataset.state;
    },
  });
</script>
