---
/**
 * Eye pair · "Following". Two off-white silhouettes (one of the shapes in
 * src/scripts/eyes/shapes.ts) with a plain dark pupil each, clipped to the
 * white. The pupils follow the cursor anywhere on screen on a short lag, as
 * far as the shape's travel ellipse lets them, and settle at the shape's
 * rest position when the cursor has been still for a moment; at rest they
 * glance about a little now and then, so the pair is never frozen. A lid
 * (black, clipped to the same silhouette) drops and lifts for blinks: quick,
 * sometimes twice. The pair wakes by fading in as the lid lifts, and leaves
 * by the lid dropping and the pair fading out.
 *
 * Each cell gives its pair a shape and a pupil colour (props). Every other
 * tunable value is here. Sizes are in px at the 1440 × 1024 design frame and
 * scale with the cell (--u is one design px). The script reads timings and
 * the shape's geometry from data-config.
 */
import { SHAPES, type ShapeName } from '../../scripts/eyes/shapes';

interface Props {
  shape: ShapeName;
  pupil: string; // the pupil colour
}

// ── Size ───────────────────────────────────────────────────────────────
const EYE_SCALE = 0.72; // the shapes, drawn at the frame, are shown this much smaller
const PAIR_MAX_SHARE = 0.6; // the pair never spans more of its cell than this

// ── Colours ────────────────────────────────────────────────────────────
const EYE_WHITE = '#EDEAE2'; // off-white, never pure white
const LID = '#000000'; // the lid is the dark of the room
const PUPIL_CORE = '#050505'; // the pupil proper, inside the coloured iris
const PUPIL_CORE_SHARE = 0.5; // its diameter as a share of the iris
const GLINT = '#EDEAE2'; // a small catchlight on the iris
const GLINT_OPACITY = 0.5;
const GLINT_SHARE = 0.16; // its diameter as a share of the iris

// ── Texture and light ──────────────────────────────────────────────────
const EDGE_ROUGH_PX = 0.8; // the silhouette's edge wanders up to this far
const EDGE_ROUGH_FREQ = 0.6; // noise frequency along the edge: higher is finer
const GLOW_BLUR_PX = 28; // the soft glow round an awake pair
const GLOW_OPACITY = 0.08;

// ── Following ──────────────────────────────────────────────────────────
const PUPIL_LAG_MS = 110; // time constant of the follow: higher is lazier
const PUPIL_GAIN = 0.14; // pupil offset per px of cursor offset, before the edge stops it
const PUPIL_SETTLE_PX = 0.05; // closer than this to the target counts as settled
const REST_AFTER_MS = 1200; // cursor still this long: pupils ease back to rest

// ── Life ───────────────────────────────────────────────────────────────
const BLINK_EVERY_MS = [4000, 8000]; // random interval between blinks
const BLINK_DOWN_MS = 80; // the lid dropping…
const BLINK_HOLD_MS = 30; // …resting closed…
const BLINK_UP_MS = 130; // …and lifting
const DOUBLE_BLINK_CHANCE = 0.25; // some blinks come twice
const DOUBLE_BLINK_GAP_MS = 160;
const GLANCE_EVERY_MS = [1500, 4000]; // at rest, the pupils glance a little
const GLANCE_PX = 3; // how far a glance goes (design px)

// ── Wake and leave ─────────────────────────────────────────────────────
const WAKE_FADE_MS = 400; // the pair fading in, lid down…
const WAKE_LID_DELAY_MS = 120; // …then, after a beat…
const WAKE_LID_MS = 320; // …the lid lifting
const LEAVE_LID_MS = 140; // the lid dropping…
const LEAVE_FADE_MS = 260; // …and the pair fading out
const EASE_OUT = 'cubic-bezier(0.22, 1, 0.36, 1)';
const EASE_IN = 'cubic-bezier(0.64, 0, 0.78, 0)';

const { shape: shapeName, pupil: pupilColour } = Astro.props;
const shape = SHAPES[shapeName];
const uid = `eye-${shapeName}-${Math.random().toString(36).slice(2, 8)}`;

// the two eyes: the right one may be mirrored, and may be a different size
const eyes = [
  { scale: 1, mirror: false },
  { scale: shape.rightScale ?? 1, mirror: shape.mirror ?? false },
];
const pairW = shape.w * (1 + (shape.rightScale ?? 1)) + shape.gap;
const flip = `translate(${shape.w} 0) scale(-1 1)`;
const PAD = 6; // the lid overhangs the box so the roughened edge never shows a gap
const lidDrop = shape.h + PAD; // how far the lid travels from lifted to closed

const config = {
  w: shape.w, h: shape.h, lidDrop, travel: shape.travel, rest: shape.rest,
  PUPIL_LAG_MS, PUPIL_GAIN, PUPIL_SETTLE_PX, REST_AFTER_MS,
  BLINK_EVERY_MS, BLINK_DOWN_MS, BLINK_HOLD_MS, BLINK_UP_MS, DOUBLE_BLINK_CHANCE, DOUBLE_BLINK_GAP_MS,
  GLANCE_EVERY_MS, GLANCE_PX,
  WAKE_FADE_MS, WAKE_LID_DELAY_MS, WAKE_LID_MS, LEAVE_LID_MS, LEAVE_FADE_MS, EASE_OUT, EASE_IN,
};
const vars = [
  `--pair-w: ${pairW}`,
  `--gap: ${shape.gap}`,
  `--pair-max: ${PAIR_MAX_SHARE}`,
  `--eye-scale: ${EYE_SCALE}`,
  `--white: ${EYE_WHITE}`,
  `--pupil-core: ${PUPIL_CORE}`,
  `--glint: ${GLINT}`,
  `--glint-opacity: ${GLINT_OPACITY}`,
  `--lid: ${LID}`,
  `--pupil-colour: ${pupilColour}`,
  `--glow-blur: ${GLOW_BLUR_PX}px`,
  `--glow-opacity: ${GLOW_OPACITY}`,
].join('; ');
---

<div class="pair-root" style={vars} data-eye-root="following" data-config={JSON.stringify(config)}>
  <div class="pair">
    {eyes.map(({ scale, mirror }, i) => {
      const t = shape.travel;
      const cx = mirror ? shape.w - t.cx : t.cx;
      return (
        <div class="eye" style={`--ew: ${shape.w * scale}; --eh: ${shape.h * scale}`} data-eye data-scale={scale}>
          <svg viewBox={`0 0 ${shape.w} ${shape.h}`} aria-hidden="true">
            <defs>
              <clipPath id={`${uid}-${i}`}>
                <path d={shape.path} transform={mirror ? flip : undefined} />
              </clipPath>
              {/* the edge wanders by a px or so: noise pushes the whole eye about */}
              <filter id={`${uid}-rough-${i}`} x="-10%" y="-10%" width="120%" height="120%">
                <feTurbulence type="fractalNoise" baseFrequency={EDGE_ROUGH_FREQ} numOctaves="2" seed={i + 1} result="noise" />
                <feDisplacementMap in="SourceGraphic" in2="noise" scale={EDGE_ROUGH_PX * 2} xChannelSelector="R" yChannelSelector="G" />
              </filter>
            </defs>
            <g filter={`url(#${uid}-rough-${i})`}>
              <path d={shape.path} transform={mirror ? flip : undefined} class="white" />
              <g clip-path={`url(#${uid}-${i})`}>
                {shape.pupil.kind === 'disc' ? (
                  <g data-pupil>
                    <circle cx={cx} cy={t.cy} r={shape.pupil.d / 2} class="pupil" />
                    <circle cx={cx} cy={t.cy} r={(shape.pupil.d * PUPIL_CORE_SHARE) / 2} class="core" />
                    <circle
                      cx={cx - shape.pupil.d * 0.18} cy={t.cy - shape.pupil.d * 0.2}
                      r={(shape.pupil.d * GLINT_SHARE) / 2} class="glint"
                    />
                  </g>
                ) : (
                  <rect
                    x={cx - shape.pupil.w / 2} y={t.cy - shape.pupil.h / 2}
                    width={shape.pupil.w} height={shape.pupil.h} rx={shape.pupil.w / 2}
                    class="pupil" data-pupil
                  />
                )}
                {/* the lid sits above the eye and drops over it; closed to begin with */}
                <rect
                  x={-PAD} y={-lidDrop} width={shape.w + PAD * 2} height={lidDrop}
                  class="lid" style={`transform: translateY(${lidDrop}px)`} data-lid
                />
              </g>
            </g>
          </svg>
        </div>
      );
    })}
  </div>
</div>

<style>
  .pair-root {
    /* one design px, capped so the pair never passes --pair-max of the cell */
    --s: calc(min(var(--u), calc(var(--cell-w) * var(--pair-max) / var(--pair-w))) * var(--eye-scale));
    opacity: 0;
  }
  [data-state='open'],
  [data-state='awake'] {
    opacity: 1;
  }
  /* reduced motion: open and still, lid lifted */
  [data-state='open'] [data-lid] {
    transform: none !important;
  }
  .pair {
    display: flex;
    align-items: center;
    gap: calc(var(--gap) * var(--s));
    /* a faint glow round the pair, in the eye white's own colour */
    filter: drop-shadow(0 0 var(--glow-blur) rgb(from var(--white) r g b / var(--glow-opacity)));
  }
  .eye {
    width: calc(var(--ew) * var(--s));
    height: calc(var(--eh) * var(--s));
  }
  .eye svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .white {
    fill: var(--white);
  }
  .pupil {
    fill: var(--pupil-colour);
  }
  .core {
    fill: var(--pupil-core);
  }
  .glint {
    fill: var(--glint);
    opacity: var(--glint-opacity);
  }
  .lid {
    fill: var(--lid);
  }
</style>

<script>
  import { registerEye, cancelAll } from '../../scripts/eyes/registry';

  interface Config {
    w: number; h: number; lidDrop: number;
    travel: { cx: number; cy: number; rx: number; ry: number };
    rest: [number, number];
    PUPIL_LAG_MS: number; PUPIL_GAIN: number; PUPIL_SETTLE_PX: number; REST_AFTER_MS: number;
    BLINK_EVERY_MS: [number, number]; BLINK_DOWN_MS: number; BLINK_HOLD_MS: number; BLINK_UP_MS: number;
    DOUBLE_BLINK_CHANCE: number; DOUBLE_BLINK_GAP_MS: number;
    GLANCE_EVERY_MS: [number, number]; GLANCE_PX: number;
    WAKE_FADE_MS: number; WAKE_LID_DELAY_MS: number; WAKE_LID_MS: number;
    LEAVE_LID_MS: number; LEAVE_FADE_MS: number; EASE_OUT: string; EASE_IN: string;
  }

  interface Run {
    stop(): void;
  }
  const runs = new WeakMap<HTMLElement, Run>();
  const cfg = (el: HTMLElement): Config => JSON.parse(el.dataset.config!);
  const between = ([lo, hi]: [number, number]) => lo + Math.random() * (hi - lo);
  const eyesOf = (el: HTMLElement) => [...el.querySelectorAll<HTMLElement>('[data-eye]')];
  const lidsOf = (el: HTMLElement) => [...el.querySelectorAll<SVGElement>('[data-lid]')];
  const lifted = 'translateY(0)';
  const closed = (c: Config) => `translateY(${c.lidDrop}px)`;

  /** One design px of this eye in real px: how big it came out. */
  const unit = (eye: HTMLElement, c: Config) => eye.offsetWidth / (c.w * Number(eye.dataset.scale));

  /** Pupil offsets are in the shape's own units, so they scale with the eye. */
  function putPupils(el: HTMLElement, p: { x: number; y: number }) {
    el.querySelectorAll<SVGElement>('[data-pupil]').forEach((pupil) => {
      pupil.style.transform = `translate(${p.x.toFixed(2)}px, ${p.y.toFixed(2)}px)`;
    });
  }

  function start(el: HTMLElement, c: Config): Run {
    const eyes = eyesOf(el);
    const pupils = eyes.map((e) => e.querySelector<SVGElement>('[data-pupil]')!);
    const lids = lidsOf(el);
    const rest = { x: c.rest[0], y: c.rest[1] };
    const glance = { x: 0, y: 0 }; // where the pupils are looking at rest, off the rest point
    const pos = eyes.map(() => ({ ...rest }));
    let cursor: { x: number; y: number } | null = null;
    let lastMove = 0;
    let frame = 0;
    let last = 0;
    let blinkTimer = 0;
    let glanceTimer = 0;

    // ── Blink: the lid drops, rests a beat, lifts; now and then twice
    function blinkOnce() {
      const total = c.BLINK_DOWN_MS + c.BLINK_HOLD_MS + c.BLINK_UP_MS;
      for (const lid of lids) {
        lid.animate([
          { transform: lifted, easing: c.EASE_IN },
          { transform: closed(c), offset: c.BLINK_DOWN_MS / total },
          { transform: closed(c), offset: (c.BLINK_DOWN_MS + c.BLINK_HOLD_MS) / total, easing: c.EASE_OUT },
          { transform: lifted },
        ], { duration: total });
      }
      return total;
    }
    function blink() {
      const took = blinkOnce();
      const again = Math.random() < c.DOUBLE_BLINK_CHANCE;
      blinkTimer = window.setTimeout(() => {
        if (again) blinkOnce();
        blinkTimer = window.setTimeout(blink, between(c.BLINK_EVERY_MS));
      }, again ? took + c.DOUBLE_BLINK_GAP_MS : 0);
    }
    blinkTimer = window.setTimeout(blink, between(c.BLINK_EVERY_MS));

    // ── Glance: at rest, the pupils shift a little to a new spot now and then
    function reglance() {
      const a = Math.random() * Math.PI * 2;
      const r = c.GLANCE_PX * (0.4 + Math.random() * 0.6);
      glance.x = Math.cos(a) * r;
      glance.y = Math.sin(a) * r;
      if (!frame) frame = requestAnimationFrame(tick);
      glanceTimer = window.setTimeout(reglance, between(c.GLANCE_EVERY_MS));
    }
    glanceTimer = window.setTimeout(reglance, between(c.GLANCE_EVERY_MS));

    // ── Following: each pupil eases toward a point inside its shape's
    // travel ellipse, from wherever the cursor is on screen. Eye centres
    // come from layout, not from the blinking boxes, so a still cursor gives
    // a still target.
    function centreOf(eye: HTMLElement) {
      const root = el.getBoundingClientRect();
      return {
        x: root.left + root.width / 2 + eye.offsetLeft + eye.offsetWidth / 2 - el.offsetWidth / 2,
        y: root.top + root.height / 2 + eye.offsetTop + eye.offsetHeight / 2 - el.offsetHeight / 2,
      };
    }

    const resting = (now: number) => !cursor || now - lastMove > c.REST_AFTER_MS;

    function target(eye: HTMLElement, now: number) {
      if (resting(now)) return { x: rest.x + glance.x, y: rest.y + glance.y };
      const centre = centreOf(eye);
      const s = unit(eye, c);
      let x = ((cursor!.x - centre.x) * c.PUPIL_GAIN) / s;
      let y = ((cursor!.y - centre.y) * c.PUPIL_GAIN) / s;
      const { rx, ry } = c.travel;
      const t = Math.hypot(x / rx, y / ry);
      if (t > 1) {
        x /= t;
        y /= t;
      }
      return { x, y };
    }

    function tick(now: number) {
      const dt = last ? Math.min(now - last, 64) : 16;
      last = now;
      const k = 1 - Math.exp(-dt / c.PUPIL_LAG_MS);
      let moving = false;
      eyes.forEach((eye, i) => {
        const t = target(eye, now);
        const p = pos[i];
        p.x += (t.x - p.x) * k;
        p.y += (t.y - p.y) * k;
        if (Math.abs(t.x - p.x) < c.PUPIL_SETTLE_PX && Math.abs(t.y - p.y) < c.PUPIL_SETTLE_PX) {
          p.x = t.x; // land exactly on the target, then stop: no jitter
          p.y = t.y;
        } else {
          moving = true;
        }
        pupils[i].style.transform = `translate(${p.x.toFixed(2)}px, ${p.y.toFixed(2)}px)`;
      });
      // keep ticking while something moves, or until the rest timer can fire
      frame = moving || !resting(now) ? requestAnimationFrame(tick) : 0;
      if (!frame) last = 0;
    }

    function follow(e: PointerEvent) {
      cursor = { x: e.clientX, y: e.clientY };
      lastMove = performance.now();
      if (!frame) frame = requestAnimationFrame(tick);
    }
    window.addEventListener('pointermove', follow);
    window.addEventListener('pointerdown', follow);
    putPupils(el, rest);

    return {
      stop() {
        window.removeEventListener('pointermove', follow);
        window.removeEventListener('pointerdown', follow);
        cancelAnimationFrame(frame);
        clearTimeout(blinkTimer);
        clearTimeout(glanceTimer);
      },
    };
  }

  registerEye('following', {
    wake(el, still) {
      const c = cfg(el);
      putPupils(el, { x: c.rest[0], y: c.rest[1] });
      if (still) {
        el.dataset.state = 'open';
        return;
      }
      el.dataset.state = 'awake';
      // the pair fades in with its lids down, then the lids lift
      el.animate([{ opacity: 0 }, { opacity: 1 }], { duration: c.WAKE_FADE_MS, easing: c.EASE_OUT });
      for (const lid of lidsOf(el)) {
        lid.animate([{ transform: closed(c) }, { transform: lifted }],
          { duration: c.WAKE_LID_MS, delay: c.WAKE_LID_DELAY_MS, easing: c.EASE_OUT, fill: 'forwards' });
      }
      runs.set(el, start(el, c));
    },

    async leave(el, still) {
      const c = cfg(el);
      runs.get(el)?.stop();
      runs.delete(el);
      if (still) {
        await el.animate([{ opacity: 1 }, { opacity: 0 }], { duration: c.LEAVE_FADE_MS, fill: 'forwards' }).finished;
        return;
      }
      // the lids drop from wherever they are (mid-lift, mid-blink), then the pair fades
      el.getAnimations().forEach((a) => a.cancel()); // a wake fade still running
      const drops = lidsOf(el).map((lid) => {
        const from = getComputedStyle(lid).transform;
        lid.getAnimations().forEach((a) => a.cancel());
        return lid.animate([{ transform: from }, { transform: closed(c) }],
          { duration: c.LEAVE_LID_MS, easing: c.EASE_IN, fill: 'forwards' }).finished;
      });
      await Promise.all(drops);
      await el.animate([{ opacity: 1 }, { opacity: 0 }],
        { duration: c.LEAVE_FADE_MS, easing: c.EASE_IN, fill: 'forwards' }).finished;
    },

    reset(el) {
      runs.get(el)?.stop();
      runs.delete(el);
      cancelAll(el);
      delete el.dataset.state;
    },
  });
</script>
