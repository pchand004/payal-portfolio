---
/**
 * Eye 1 · "narrow". A pink almond with a big blue iris on a grainy teal
 * tile. Rests as a single closed lid line, opens to a narrow slit, holds,
 * then slow-blinks at a random interval of 3–5s.
 */
---

<div class="eye eye-narrow" data-eye-root="narrow">
  <svg viewBox="0 0 200 200" aria-hidden="true">
    <defs>
      <clipPath id="narrow-tile"><rect width="200" height="200" rx="46" /></clipPath>
      <clipPath id="narrow-slit">
        <path d="M8 100 C52 58 148 58 192 100 C148 142 52 142 8 100 Z" />
      </clipPath>
      <filter id="narrow-grain" x="0" y="0" width="100%" height="100%">
        <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" stitchTiles="stitch" />
        <feColorMatrix type="saturate" values="0" />
      </filter>
    </defs>

    <g clip-path="url(#narrow-tile)">
      <rect width="200" height="200" class="tile" />
      <circle cx="168" cy="36" r="54" class="tile-glow" />
      <rect width="200" height="200" filter="url(#narrow-grain)" class="grain" />
    </g>

    <g class="lid" data-lid>
      <g clip-path="url(#narrow-slit)">
        <rect x="0" y="50" width="200" height="100" class="almond" />
        <circle cx="100" cy="100" r="35" class="iris" />
        <circle cx="100" cy="100" r="35" class="iris-ring" />
        <ellipse cx="100" cy="100" rx="8" ry="20" class="pupil" />
        <circle cx="87" cy="86" r="6" class="glint" />
        <path d="M8 66 C52 90 148 90 192 66" class="lid-shade" />
      </g>
      <path d="M8 100 C52 58 148 58 192 100 C148 142 52 142 8 100 Z" class="rim" />
    </g>
  </svg>
</div>

<style>
  .eye-narrow svg {
    display: block;
    width: var(--eye);
    height: auto;
  }
  .tile { fill: #2fa596; }
  .tile-glow { fill: #4cc3ad; }
  .grain {
    opacity: 0.32;
    mix-blend-mode: soft-light;
  }
  .lid {
    transform-box: view-box;
    transform-origin: 100px 100px;
    transform: scaleY(0.04);
  }
  [data-state='open'] .lid {
    transform: none;
  }
  .almond { fill: #f88cc0; }
  .iris { fill: #2b64e0; }
  .iris-ring {
    fill: none;
    stroke: #1b3fa6;
    stroke-width: 5;
  }
  .pupil { fill: #10133a; }
  .glint { fill: #fff; }
  .lid-shade {
    fill: none;
    stroke: #e46aa6;
    stroke-width: 10;
    opacity: 0.6;
  }
  .rim {
    fill: none;
    stroke: #f88cc0;
    stroke-width: 3;
    vector-effect: non-scaling-stroke;
  }
</style>

<script>
  import { registerEye, cancelAll, wait, done } from '../../scripts/eyes/registry';
  import {
    WAKE_MS, EASE_OUT, EASE_IN, NARROW_CLOSED_SCALE,
    NARROW_BLINK_EVERY_MS, NARROW_BLINK_CLOSE_MS, NARROW_BLINK_HOLD_MS, NARROW_BLINK_OPEN_MS,
  } from '../../scripts/eyes/motion';

  const runs = new WeakMap<HTMLElement, AbortController>();
  const closed = `scaleY(${NARROW_CLOSED_SCALE})`;
  const between = ([lo, hi]: [number, number]) => lo + Math.random() * (hi - lo);

  async function loop(el: HTMLElement, signal: AbortSignal) {
    const lid = el.querySelector<SVGGElement>('[data-lid]')!;
    // the tile and closed line appear first (the stage does that), then the lid opens
    await wait(WAKE_MS, signal);
    await done(lid.animate([{ transform: closed }, { transform: 'scaleY(1)' }],
      { duration: WAKE_MS, easing: EASE_OUT, fill: 'forwards' }), signal);
    for (;;) {
      await wait(between(NARROW_BLINK_EVERY_MS), signal);
      await done(lid.animate([{ transform: 'scaleY(1)' }, { transform: closed }],
        { duration: NARROW_BLINK_CLOSE_MS, easing: EASE_IN, fill: 'forwards' }), signal);
      await wait(NARROW_BLINK_HOLD_MS, signal);
      await done(lid.animate([{ transform: closed }, { transform: 'scaleY(1)' }],
        { duration: NARROW_BLINK_OPEN_MS, easing: EASE_OUT, fill: 'forwards' }), signal);
    }
  }

  registerEye('narrow', {
    wake(el, still) {
      if (still) {
        el.dataset.state = 'open';
        return;
      }
      const run = new AbortController();
      runs.set(el, run);
      loop(el, run.signal).catch(() => {});
    },
    reset(el) {
      runs.get(el)?.abort();
      runs.delete(el);
      cancelAll(el);
      delete el.dataset.state;
    },
  });
</script>
