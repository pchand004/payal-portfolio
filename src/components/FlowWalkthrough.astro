---
/**
 * <FlowWalkthrough> — an auto-playing phone walkthrough of a multi-step flow.
 *
 * Each step: hold at the top (1.2 s) → scroll smoothly to the bottom of that screen
 * (~2.5 s, ease-in-out; skipped if the screen fits) → hold (1 s) → crossfade (300 ms)
 * to the next. Loops after the last step.
 * Under the phone: step dots, pause/play, and one caption line with the current step's
 * number and title. The step list lives elsewhere (<FlowSteps>), and jumps the phone
 * by dispatching a `fw:jump` event with { detail: { id, index } } on document.
 * Loading: step 1 loads eagerly (fetchpriority high); steps 2+ load after window load.
 * Pauses when out of view or when the tab is hidden. With prefers-reduced-motion:
 * no autoplay and no scrolling — step 1 is shown, and the dots and list step manually.
 */
interface Step {
  title: string;
  /** image path without extension; expects .webp and .png next to each other */
  src: string;
  /** natural pixel size of the screen image */
  w: number;
  h: number;
  label: string;
  bullets: { lead: string; rest?: string }[];
}
interface Props {
  steps: Step[];
  id?: string;
  /** true when the walkthrough is above the fold: step 1 loads eagerly with high priority */
  priority?: boolean;
}
const { steps, id = 'flow-walkthrough', priority = false } = Astro.props;
const pad = (i: number) => String(i + 1).padStart(2, '0');
---

<div class="fw" data-fw id={id} data-labels={JSON.stringify(steps.map((s) => s.label))} data-titles={JSON.stringify(steps.map((s) => s.title))}>
  <div class="fw-stage">
    <div
      class="fw-phone"
      role="img"
      aria-label={`Step 1 of ${steps.length}: ${steps[0].label}`}
      data-fw-phone
    >
      <div class="fw-screen">
        {steps.map((s, i) => (
          <div class:list={['fw-layer', i === 0 && 'is-active']} data-fw-layer data-w={s.w} data-h={s.h} aria-hidden="true">
            <picture>
              {i === 0 ? (
                <source srcset={`${s.src}.webp`} type="image/webp" />
              ) : (
                <source data-srcset={`${s.src}.webp`} type="image/webp" />
              )}
              {i === 0 ? (
                <img src={`${s.src}.png`} alt="" width={s.w} height={s.h} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : undefined} decoding="async" data-fw-img />
              ) : (
                <img data-src={`${s.src}.png`} alt="" width={s.w} height={s.h} decoding="async" data-fw-img />
              )}
            </picture>
          </div>
        ))}
      </div>
    </div>

    <div class="fw-controls">
      <div class="fw-dots" role="group" aria-label="Choose a step">
        {steps.map((s, i) => (
          <button type="button" class:list={['fw-dot', i === 0 && 'is-active']} data-fw-dot={i} aria-label={`Step ${i + 1}: ${s.title}`} aria-current={i === 0 ? 'step' : undefined}></button>
        ))}
      </div>
      <button type="button" class="fw-toggle" data-fw-toggle aria-label="Pause walkthrough" aria-pressed="false">
        <svg class="fw-ico-pause" viewBox="0 0 16 16" aria-hidden="true"><rect x="3.5" y="3" width="3" height="10" rx="1" /><rect x="9.5" y="3" width="3" height="10" rx="1" /></svg>
        <svg class="fw-ico-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.2v9.6c0 .5.5.8.9.5l7.2-4.8c.4-.3.4-.8 0-1L5.9 2.7c-.4-.3-.9 0-.9.5Z" /></svg>
      </button>
    </div>
    <p class="fw-caption" data-fw-caption aria-live="polite">{pad(0)} · {steps[0].title}</p>
  </div>

</div>

<style>
  .fw {
    --fw-w: 270px;
    width: var(--fw-w);
    max-width: 100%;
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }
  /* Phone: 6px dark bezel, 40px radius, soft shadow, screen at 393:852 */
  .fw-phone {
    width: 100%;
    padding: 6px;
    box-sizing: border-box;
    border-radius: 40px;
    background: #121217;
    box-shadow: 0 30px 60px -24px rgba(26, 19, 60, 0.45), 0 12px 24px -12px rgba(26, 19, 60, 0.25);
  }
  .fw-screen {
    position: relative;
    aspect-ratio: 393 / 852;
    overflow: hidden;
    border-radius: 34px;
    background: #fff;
  }
  .fw-layer {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 300ms ease;
  }
  .fw-layer.is-active {
    opacity: 1;
  }
  .fw-layer img {
    display: block;
    width: 100%;
    height: auto;
    will-change: transform;
  }
  .fw-controls {
    align-self: center;
    margin-top: 12px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .fw-dots {
    display: flex;
    gap: 2px;
  }
  .fw-dot {
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .fw-dot::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #D8D2EC;
    transition: width 200ms ease, background 200ms ease;
  }
  .fw-dot.is-active::before {
    width: 20px;
    background: #4105DB;
  }
  .fw-toggle {
    width: 30px;
    height: 30px;
    border-radius: 999px;
    border: 1px solid #E8E4E0;
    background: #fff;
    color: #2C2620;
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .fw-toggle svg {
    width: 13px;
    height: 13px;
    fill: currentColor;
  }
  .fw-toggle .fw-ico-play,
  .fw-toggle[aria-pressed='true'] .fw-ico-pause {
    display: none;
  }
  .fw-toggle[aria-pressed='true'] .fw-ico-play {
    display: block;
  }
  .fw-dot:focus-visible,
  .fw-toggle:focus-visible {
    outline: 2px solid #4105DB;
    outline-offset: 2px;
    border-radius: 8px;
  }
  .fw-caption {
    margin: 6px 0 0;
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    font-size: 13px;
    color: #6B6354;
    text-align: center;
  }
</style>

<script>
  const HOLD_TOP = 1200;
  const SCROLL = 2500;
  const HOLD_END = 1000;
  const FADE = 300;
  const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

  function setup(root: HTMLElement) {
    if (root.dataset.ready) return;
    root.dataset.ready = '1';
    const phone = root.querySelector<HTMLElement>('[data-fw-phone]')!;
    const layers = Array.from(root.querySelectorAll<HTMLElement>('[data-fw-layer]'));
    const imgs = layers.map((l) => l.querySelector<HTMLImageElement>('[data-fw-img]')!);
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-fw-dot]'));
    const toggle = root.querySelector<HTMLButtonElement>('[data-fw-toggle]')!;
    const caption = root.querySelector<HTMLElement>('[data-fw-caption]')!;
    const titles = JSON.parse(root.dataset.titles || '[]') as string[];
    const stepLabels = JSON.parse(root.dataset.labels || '[]') as string[];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');

    let index = 0;
    let userPaused = reduce.matches;     // reduced motion: start paused, manual only
    let inView = false;
    let phase: 'top' | 'scroll' | 'end' | 'fade' = 'top';
    let phaseStart = 0;
    let elapsedInPhase = 0;              // carried across pauses
    let raf = 0;

    const overflow = (i: number) => {
      const screen = layers[i].getBoundingClientRect();
      const h = imgs[i].getBoundingClientRect().height || (screen.width * Number(layers[i].dataset.h)) / Number(layers[i].dataset.w);
      return Math.max(0, h - screen.height);
    };
    const setY = (i: number, y: number) => { imgs[i].style.transform = `translate3d(0, ${-y}px, 0)`; };
    const running = () => !userPaused && inView && !document.hidden && !reduce.matches;

    function show(i: number) {
      index = (i + layers.length) % layers.length;
      layers.forEach((l, k) => l.classList.toggle('is-active', k === index));
      dots.forEach((d, k) => { d.classList.toggle('is-active', k === index); if (k === index) d.setAttribute('aria-current', 'step'); else d.removeAttribute('aria-current'); });
      document.dispatchEvent(new CustomEvent('fw:step', { detail: { id: root.id, index } }));
      caption.textContent = `${String(index + 1).padStart(2, '0')} · ${titles[index]}`;
      phone.setAttribute('aria-label', `Step ${index + 1} of ${layers.length}: ${stepLabels[index] || titles[index]}`);
      setY(index, 0);
      phase = 'top'; elapsedInPhase = 0; phaseStart = performance.now();
    }

    function tick(now: number) {
      raf = 0;
      if (!running()) return;
      const t = elapsedInPhase + (now - phaseStart);
      const max = overflow(index);
      if (phase === 'top' && t >= HOLD_TOP) { phase = max > 2 ? 'scroll' : 'end'; elapsedInPhase = 0; phaseStart = now; }
      else if (phase === 'scroll') {
        const k = Math.min(1, t / SCROLL);
        setY(index, max * ease(k));
        if (k >= 1) { phase = 'end'; elapsedInPhase = 0; phaseStart = now; }
      } else if (phase === 'end' && t >= HOLD_END) {
        const from = index;
        show(index + 1);
        // let the outgoing screen keep its scrolled position while it fades out
        window.setTimeout(() => setY(from, 0), FADE + 20);
      }
      raf = requestAnimationFrame(tick);
    }
    function start() {
      if (raf || !running()) return;
      phaseStart = performance.now();
      raf = requestAnimationFrame(tick);
    }
    function stop() {
      if (raf) { cancelAnimationFrame(raf); raf = 0; }
      elapsedInPhase += performance.now() - phaseStart;
    }
    function syncToggle() {
      toggle.setAttribute('aria-pressed', String(userPaused));
      toggle.setAttribute('aria-label', userPaused ? 'Play walkthrough' : 'Pause walkthrough');
    }

    dots.forEach((d, i) => d.addEventListener('click', () => { stop(); show(i); start(); }));
    document.addEventListener('fw:jump', (e) => {
      const d = (e as CustomEvent<{ id?: string; index: number }>).detail;
      if (d.id && d.id !== root.id) return;
      stop(); show(d.index); start();
    });
    // steps 2+ load after the page has loaded, so the hero stays fast
    const loadRest = () => root.querySelectorAll<HTMLElement>('[data-srcset],[data-src]').forEach((el) => {
      if (el.dataset.srcset) { el.setAttribute('srcset', el.dataset.srcset); delete el.dataset.srcset; }
      if (el.dataset.src) { el.setAttribute('src', el.dataset.src); delete el.dataset.src; }
    });
    if (document.readyState === 'complete') loadRest(); else window.addEventListener('load', loadRest, { once: true });
    toggle.addEventListener('click', () => {
      userPaused = !userPaused;
      syncToggle();
      if (userPaused) stop(); else start();
    });
    reduce.addEventListener?.('change', () => { if (reduce.matches) { stop(); userPaused = true; show(index); syncToggle(); } });
    document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); else start(); });
    const io = new IntersectionObserver((entries) => {
      inView = entries.some((e) => e.isIntersecting);
      if (inView) start(); else stop();
    }, { threshold: 0.25 });
    io.observe(root);
    (root as HTMLElement & { _io?: IntersectionObserver })._io = io; // keep a reference so it isn't collected

    syncToggle();
    show(0);
  }

  function init() { document.querySelectorAll<HTMLElement>('[data-fw]').forEach(setup); }
  init();
  document.addEventListener('astro:page-load', init);
</script>
