---
/**
 * <FlowerBed> — the end-of-page flowers.
 *
 * A band of Payal's doodled roses and flowers. When it scrolls into view each one
 * drops in, tumbling as if just plucked, and scribbles itself in while it falls.
 * Layout is generated at build time from a fixed seed, so it is stable between
 * deploys and reserves its height up front (no layout shift). Under
 * prefers-reduced-motion the flowers are simply there, fully drawn.
 */
import Doodle from './Doodle.astro';
import { doodles } from '../data/doodles';

interface Props {
  seed?: number;
  count?: number;
}
const { seed = 7, count = 34 } = Astro.props;

// small deterministic PRNG (mulberry32)
function rng(a: number) {
  return () => {
    a |= 0; a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const r = rng(seed);
const loops = doodles.filter((d) => d.kind === 'loop');
const flowers = doodles.filter((d) => d.kind === 'flower');
const inks = ['#3E5A22', '#3E5A22', '#4D6A2C', '#5B7737', '#34501C'];

const items = Array.from({ length: count }, (_, i) => {
  const isFlower = r() < 0.38;
  const pool = isFlower ? flowers : loops;
  const doodle = pool[Math.floor(r() * pool.length)];
  // width in px: flowers a touch larger; the long-stemmed one larger still
  const width = Math.round(
    doodle.name === 'flower-stem' ? 120 + r() * 40 : isFlower ? 62 + r() * 38 : 40 + r() * 42,
  );
  const height = Math.round((width * doodle.h) / doodle.w);
  // spread across the width with jitter; denser near the ground
  const x = ((i + 0.5) / count) * 100 + (r() - 0.5) * (100 / count) * 1.6;
  const ground = Math.pow(r(), 1.8); // 0 = resting on the ground, 1 = higher in the pile
  return {
    doodle: doodle.name,
    width,
    height,
    x: Math.min(97, Math.max(3, x)),
    bottom: Math.round(ground * 120),
    rot: Math.round((r() - 0.5) * 50),
    rot0: Math.round((r() - 0.5) * 220),
    drift: Math.round((r() - 0.5) * 60),
    fall: Math.round(140 + r() * 120),
    delay: Math.round(i * 55 + r() * 160),
    ink: inks[Math.floor(r() * inks.length)],
    z: Math.round(ground * 10),
    // on phones keep about a third, so the band stays airy
    phone: i % 3 === 0,
  };
});
---

<div class="flowerbed" data-flowerbed aria-hidden="true">
  {items.map((it) => (
    <span
      class:list={['fb-item', !it.phone && 'fb-item--wide']}
      style={`left:${it.x.toFixed(2)}%; bottom:${it.bottom}px; width:${it.width}px; height:${it.height}px; z-index:${it.z}; color:${it.ink}; --r:${it.rot}deg; --r0:${it.rot0}deg; --fx:${it.drift}px; --fall:${it.fall}px; --fb-delay:${it.delay}ms;`}
    >
      <Doodle name={it.doodle} duration={850} delay={it.delay + 120} class="fb-doodle" />
    </span>
  ))}
</div>

<style>
  .flowerbed {
    position: relative;
    height: 200px;
    margin-top: 16px;
    overflow-x: clip;
    pointer-events: none;
  }
  @media (min-width: 768px) {
    .flowerbed {
      height: 260px;
      margin-top: 24px;
    }
  }
  .fb-item {
    position: absolute;
    display: block;
    translate: -50% 0;
    transform: rotate(var(--r));
    transform-origin: 50% 60%;
    opacity: 0;
  }
  .fb-item :global(.fb-doodle) {
    width: 100%;
    height: 100%;
  }
  /* phones: a third of the flowers, a little smaller, so the band isn't crowded */
  @media (max-width: 639px) {
    .fb-item--wide {
      display: none;
    }
    .fb-item {
      scale: 0.82;
    }
  }
  .flowerbed.is-on .fb-item {
    animation: fb-fall 1050ms cubic-bezier(0.22, 0.75, 0.3, 1) var(--fb-delay) both;
  }
  @keyframes fb-fall {
    0% {
      opacity: 0;
      transform: translate(var(--fx), calc(-1 * var(--fall))) rotate(var(--r0));
    }
    18% {
      opacity: 1;
    }
    100% {
      opacity: 1;
      transform: translate(0, 0) rotate(var(--r));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .flowerbed.is-on .fb-item {
      animation: none;
      opacity: 1;
    }
  }
</style>

<script>
  import { drawDoodle } from '../scripts/doodle';

  // Start the fall + scribble the first time each bed is mostly in view.
  // Observers are kept in a set so nothing can garbage-collect them before they fire.
  const live = new Set<IntersectionObserver>();
  function initFlowerBeds() {
    document.querySelectorAll<HTMLElement>('[data-flowerbed]:not([data-armed])').forEach((bed) => {
      bed.dataset.armed = '1';
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          io.disconnect();
          live.delete(io);
          bed.classList.add('is-on');
          bed.querySelectorAll('.doodle').forEach((svg) => {
            const delay = parseFloat((svg as SVGElement).style.getPropertyValue('--doodle-delay')) || 0;
            drawDoodle(svg, delay);
          });
        },
        { threshold: 0.35 },
      );
      io.observe(bed);
      live.add(io);
    });
  }
  // This module can load after the first astro:page-load has already fired, so run
  // now as well; the data-armed guard stops beds being set up twice.
  initFlowerBeds();
  document.addEventListener('astro:page-load', initFlowerBeds);
</script>
