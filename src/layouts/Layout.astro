---
import { Font } from 'astro:assets';
import '../styles/global.css';
import EmailCopy from '../components/EmailCopy.astro';

interface Props {
  title?: string;
  description?: string;
  /** Share-preview overrides; default to title / description. */
  ogTitle?: string;
  ogDescription?: string;
  /** Path or URL of a 1200×630 share image; defaults to the site card. */
  ogImage?: string;
}

const {
  title = 'Payal Chand · Product Designer',
  description = 'Product designer working on AI, voice and XR products, grounded in behaviour science. MSc Imperial College London.',
  ogTitle = title,
  ogDescription = description,
  ogImage = '/og.png',
} = Astro.props;

const site = Astro.site ?? new URL('https://payal-portfolio-five.vercel.app');
const pageUrl = new URL(Astro.url.pathname, site).href;
const imageUrl = new URL(ogImage, site).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    {/* Share previews (LinkedIn, Slack, WhatsApp, X…) */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Payal Chand" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Payal Chand, Product Designer · AI, voice & XR, beside a hand-drawn desk illustration." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={imageUrl} />
    <Font cssVariable="--font-fraunces" preload />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-tiro-devanagari" preload />
    <Font cssVariable="--font-caveat" />
  </head>
  <body>
    <div class="mx-auto w-full max-w-[1200px] px-6 py-8 md:px-10 md:py-12">
      <slot />
    </div>
    <EmailCopy />
  </body>
</html>
